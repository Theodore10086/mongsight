/* ============================================================
   SCAN PAGE — Design System (mirrors recognition page)
   ============================================================ */

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 100rpx;
  background-color: #f5f0e8;
  box-sizing: border-box;
}

/* Off-screen crop canvas — functional, no visual change */
.hidden-crop-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 540px;
  height: 900px;
  opacity: 0;
  pointer-events: none;
}

/* ── HERO CARD ─────────────────────────────────────────────── */

.hero-card {
  padding: 8rpx 0 52rpx;
}

/* ── SHARED TEXT STYLES ────────────────────────────────────── */

.hero-title,
.result-title,
.player-title,
.error-title {
  display: block;
  color: #1c1410;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1.25;
}

.hero-subtitle,
.error-message,
.debug-text,
.result-subtitle,
.result-time,
.player-status {
  display: block;
  margin-top: 16rpx;
  color: rgba(28, 20, 16, 0.5);
  font-size: 26rpx;
  line-height: 1.75;
}

/* ── ACTION GRID ───────────────────────────────────────────── */

.action-grid,
.preview-actions,
.player-actions {
  display: flex;
  gap: 16rpx;
}

.action-grid {
  margin-bottom: 40rpx;
}

/* ── BUTTONS ───────────────────────────────────────────────── */

.action-button,
.minor-button {
  flex: 1;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 108rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
  background: rgba(28, 20, 16, 0.06);
  color: #1c1410;
  border: none;
  padding: 0;
}

.action-button::after,
.minor-button::after {
  border: none;
}

.action-button:active,
.minor-button:active {
  opacity: 0.55;
}

.action-button.primary,
.minor-button.primary {
  background: #c49a3c;
  color: #1c1410;
  font-weight: 700;
  box-shadow: 0 4rpx 20rpx rgba(196, 154, 60, 0.32);
}

.minor-button {
  height: 88rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.minor-button.ghost {
  background: transparent;
  border: 1.5rpx solid rgba(28, 20, 16, 0.18);
  color: rgba(28, 20, 16, 0.58);
}

.minor-button[loading] {
  opacity: 0.5;
}

/* ── CARDS ─────────────────────────────────────────────────── */

.preview-card,
.error-card,
.result-card {
  background: #faf7f2;
  border-radius: 16rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.08);
  margin-bottom: 28rpx;
  overflow: hidden;
}

.preview-card,
.result-card {
  padding: 20rpx;
}

/* ── PREVIEW IMAGE ─────────────────────────────────────────── */

.preview-image,
.result-preview {
  width: 100%;
  border-radius: 10rpx;
  background: #ede8df;
  display: block;
}

.preview-image {
  height: 520rpx;
  margin-bottom: 20rpx;
}

.result-preview {
  height: 260rpx;
  margin-bottom: 0;
}

/* ── RESULT CARD INTERNALS ─────────────────────────────────── */

.result-header,
.player-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.result-mongolian {
  display: block;
  margin: 32rpx 0;
  color: #1c1410;
  font-size: 80rpx;
  writing-mode: vertical-rl;
  min-height: 240rpx;
  letter-spacing: 12rpx;
  text-align: center;
}

/* ── ERROR CARD ────────────────────────────────────────────── */

.error-card {
  padding: 32rpx 28rpx 32rpx 32rpx;
  border-left: 4rpx solid #7d2020;
  border-top: 1rpx solid rgba(28, 20, 16, 0.07);
  border-right: 1rpx solid rgba(28, 20, 16, 0.07);
  border-bottom: 1rpx solid rgba(28, 20, 16, 0.07);
}

.error-title {
  color: #7d2020;
  font-size: 30rpx;
  font-weight: 700;
}

/* ── PLAYER CARD ───────────────────────────────────────────── */

.player-card {
  background: #faf7f2;
  border-radius: 16rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.08);
  padding: 24rpx;
  margin-top: 20rpx;
}

.player-canvas {
  width: 100%;
  height: 420rpx;
  background: #f5f0e8;
  border-radius: 10rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.06);
  margin: 16rpx 0;
  display: block;
}

/* ── DEBUG / OCR ───────────────────────────────────────────── */

.debug-label {
  display: block;
  margin-top: 20rpx;
  color: rgba(28, 20, 16, 0.4);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ── SCORE LIST ────────────────────────────────────────────── */

.score-list {
  margin-top: 12rpx;
}

.score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(28, 20, 16, 0.07);
}

.score-row:last-child {
  border-bottom: none;
}

.score-label,
.score-value {
  color: rgba(28, 20, 16, 0.7);
  font-size: 26rpx;
}

.score-value {
  font-weight: 700;
  color: #1c1410;
}
