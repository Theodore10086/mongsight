.page {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  background: linear-gradient(180deg, #f6efe4 0%, #efe2ce 100%);
  box-sizing: border-box;
}

.hidden-crop-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 540px;
  height: 900px;
  opacity: 0;
  pointer-events: none;
}

.hero-card,
.preview-card,
.error-card,
.result-card {
  background: rgba(255, 251, 245, 0.96);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 20rpx 50rpx rgba(90, 53, 18, 0.08);
  margin-bottom: 24rpx;
}

.hero-title,
.result-title,
.player-title,
.error-title {
  display: block;
  color: #4f2f15;
  font-size: 36rpx;
  font-weight: 700;
}

.hero-subtitle,
.error-message,
.debug-text,
.result-subtitle,
.result-time,
.player-status {
  display: block;
  margin-top: 12rpx;
  color: #7b6047;
  font-size: 24rpx;
  line-height: 1.6;
}

.action-grid,
.preview-actions,
.player-actions {
  display: flex;
  gap: 16rpx;
}

.action-button,
.minor-button {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 2.6;
}

.action-button.primary,
.minor-button.primary {
  background: #7c4b28;
  color: #fff;
}

.action-button,
.minor-button {
  background: #efe0cc;
  color: #5f3d23;
}

.minor-button.ghost {
  background: #f7efe6;
}

.preview-image,
.result-preview {
  width: 100%;
  border-radius: 20rpx;
  background: #eadfce;
}

.preview-image {
  height: 520rpx;
  margin-bottom: 20rpx;
}

.result-header,
.player-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.result-mongolian {
  display: block;
  margin: 20rpx 0;
  color: #3f2411;
  font-size: 54rpx;
  writing-mode: vertical-rl;
  min-height: 220rpx;
}

.result-preview {
  height: 260rpx;
  margin-bottom: 24rpx;
}

.player-card {
  background: #f8f2ea;
  border-radius: 24rpx;
  padding: 20rpx;
}

.player-canvas {
  width: 100%;
  height: 420rpx;
  background: #fffdfa;
  border-radius: 18rpx;
  margin: 20rpx 0;
}

.debug-label {
  display: block;
  margin-top: 20rpx;
  color: #5f3d23;
  font-size: 24rpx;
  font-weight: 600;
}

.score-list {
  margin-top: 12rpx;
}

.score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(95, 61, 35, 0.08);
}

.score-row:last-child {
  border-bottom: none;
}

.score-label,
.score-value {
  color: #5f3d23;
  font-size: 26rpx;
}

.score-value {
  font-weight: 700;
}
