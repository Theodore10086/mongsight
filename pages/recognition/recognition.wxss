/* ============================================================
   RECOGNITION PAGE — Design System
   Color tokens:
     --paper:       #f5f0e8   页面底色（宣纸）
     --paper-white: #faf7f2   卡片表面
     --ink:         #1c1410   主文字（墨色）
     --ink-50:  rgba(28,20,16,0.50)  次级文字
     --ink-35:  rgba(28,20,16,0.35)  辅助文字
     --ink-12:  rgba(28,20,16,0.12)  边框
     --ink-07:  rgba(28,20,16,0.07)  细分割线
     --red:         #7d2020   错误色
   ============================================================ */

/* ── PAGE ──────────────────────────────────────────────────── */

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 100rpx;
  background-color: #f5f0e8;
  box-sizing: border-box;
}

/* ── HERO HEADER ───────────────────────────────────────────── */

.hero {
  padding: 8rpx 0 56rpx;
}

.hero-title {
  display: block;
  color: #1c1410;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1.25;
}

.hero-subtitle {
  display: block;
  margin-top: 18rpx;
  color: rgba(28, 20, 16, 0.48);
  font-size: 26rpx;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
}

/* ── ACTION BUTTONS ────────────────────────────────────────── */

.action-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.action-button {
  flex: 1;
  height: 108rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  letter-spacing: 1rpx;
  background: transparent;
  border: 1.5rpx solid rgba(28, 20, 16, 0.22);
  color: #1c1410;
  line-height: 1;
  padding: 0;
}

/* Reset WeChat button default border pseudo-element */
.action-button::after {
  border: none;
}

.action-button:active {
  opacity: 0.52;
}

.action-button.primary {
  background: linear-gradient(135deg, #c49a3c 0%, #b8882a 100%);
  color: #1c1410;
  border-color: transparent;
  box-shadow: 0 4rpx 20rpx rgba(196, 154, 60, 0.35);
  font-weight: 700;
}

/* ── SVG ICON SYSTEM ───────────────────────────────────────── */

.btn-icon {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* Camera — ink dark (for gold/amber primary button) */
.icon-camera-ink {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231c1410' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z'/><circle cx='12' cy='13' r='4'/></svg>");
}

/* Camera — light (legacy, kept for other uses) */
.icon-camera-light {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23f5f0e8' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z'/><circle cx='12' cy='13' r='4'/></svg>");
}

/* Album / Gallery — dark */
.icon-album-dark {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231c1410' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='18' height='18' rx='2' ry='2'/><circle cx='8.5' cy='8.5' r='1.5'/><polyline points='21 15 16 10 5 21'/></svg>");
}

/* ── PREVIEW CARD ──────────────────────────────────────────── */

.preview-card {
  background: #faf7f2;
  border-radius: 16rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.08);
  padding: 20rpx;
  margin-bottom: 28rpx;
}

.preview-image {
  width: 100%;
  height: 480rpx;
  border-radius: 10rpx;
  background: #ede8df;
  margin-bottom: 20rpx;
  display: block;
}

.preview-actions {
  display: flex;
  gap: 12rpx;
}

/* ── MINOR BUTTONS ─────────────────────────────────────────── */

.minor-button {
  flex: 1;
  height: 88rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
  line-height: 1;
  padding: 0;
  background: rgba(28, 20, 16, 0.06);
  color: #1c1410;
  border: none;
}

.minor-button::after {
  border: none;
}

.minor-button.primary {
  background: linear-gradient(135deg, #c49a3c 0%, #b8882a 100%);
  color: #1c1410;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(196, 154, 60, 0.3);
}

.minor-button.ghost {
  background: transparent;
  border: 1.5rpx solid rgba(28, 20, 16, 0.18);
  color: rgba(28, 20, 16, 0.58);
}

.minor-button:active {
  opacity: 0.55;
}

.minor-button[loading] {
  opacity: 0.5;
}

/* ── ERROR CARD ────────────────────────────────────────────── */

.error-card {
  background: #faf7f2;
  border-radius: 16rpx;
  margin-bottom: 28rpx;
  padding: 32rpx 28rpx 32rpx 32rpx;
  border-top: 1rpx solid rgba(28, 20, 16, 0.07);
  border-right: 1rpx solid rgba(28, 20, 16, 0.07);
  border-bottom: 1rpx solid rgba(28, 20, 16, 0.07);
  border-left: 4rpx solid #7d2020;
}

/* Warning icon via CSS background */
.error-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 18rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center left;
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%237d2020' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/></svg>");
}

.error-title {
  display: block;
  color: #7d2020;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.error-message {
  display: block;
  margin-top: 10rpx;
  color: rgba(28, 20, 16, 0.55);
  font-size: 26rpx;
  line-height: 1.75;
}

.ocr-debug {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(28, 20, 16, 0.08);
}

.debug-label {
  display: block;
  color: rgba(28, 20, 16, 0.38);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.debug-text {
  display: block;
  margin-top: 8rpx;
  color: rgba(28, 20, 16, 0.65);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ── RESULT CARD ───────────────────────────────────────────── */

.result-card {
  background: #faf7f2;
  border-radius: 16rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.08);
  margin-bottom: 28rpx;
  overflow: hidden;
}

.result-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 36rpx 32rpx 28rpx;
  border-bottom: 1rpx solid rgba(28, 20, 16, 0.07);
}

.result-info {
  flex: 1;
}

.result-title {
  display: block;
  color: #1c1410;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.result-subtitle {
  display: block;
  margin-top: 10rpx;
  color: rgba(28, 20, 16, 0.46);
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.result-time {
  display: block;
  color: rgba(28, 20, 16, 0.28);
  font-size: 22rpx;
  white-space: nowrap;
  margin-top: 8rpx;
}

/* ── MONGOLIAN HERO — the centerpiece ─────────────────────── */

.mongolian-box {
  display: flex;
  justify-content: center;
  align-items: center;
  /* Return to page background — creates a "window" feel inside the card */
  background: #f5f0e8;
  padding: 88rpx 40rpx;
  border-bottom: 1rpx solid rgba(28, 20, 16, 0.07);
}

.result-mongolian {
  display: block;
  color: #1c1410;
  font-size: 96rpx;
  writing-mode: vertical-rl;
  min-height: 300rpx;
  letter-spacing: 14rpx;
  text-align: center;
}

/* ── RESULT PREVIEW IMAGE ──────────────────────────────────── */

.result-preview {
  width: 100%;
  height: 220rpx;
  display: block;
  background: #ede8df;
}

/* ── STROKE ORDER PLAYER ───────────────────────────────────── */

.player-card {
  border-top: 1rpx solid rgba(28, 20, 16, 0.07);
  padding: 28rpx 32rpx 36rpx;
}

.player-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.player-title {
  display: block;
  color: #1c1410;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.player-status {
  display: block;
  color: rgba(28, 20, 16, 0.36);
  font-size: 24rpx;
}

.player-canvas {
  width: 100%;
  height: 400rpx;
  background: #f5f0e8;
  border-radius: 10rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.06);
}

.player-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.player-actions .minor-button {
  height: 80rpx;
  font-size: 26rpx;
}
