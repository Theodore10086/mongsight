<view class="guide-overlay active splash-page" wx:if="{{showSplash}}">
  <view class="starfield-bg">
    <view class="stars"></view>
    <view class="stars-mid"></view>
    <view class="stars-near"></view>
    <view class="milky-way"></view>
    <view class="nebula"></view>
    <view class="horizon-glow"></view>
    <view class="grassland"></view>
  </view>

  <view class="corner-tl"></view>
  <view class="corner-tr"></view>
  <view class="corner-bl"></view>
  <view class="corner-br"></view>

  <view class="guide-title-wrap">
    <view class="title-deco-row">
      <view class="deco-line"></view>
      <view class="deco-rhombus"></view>
      <view class="deco-line"></view>
    </view>
    <text class="guide-title-main">智墨穿梭</text>
    <view class="title-deco-row">
      <view class="deco-line"></view>
      <view class="deco-rhombus"></view>
      <view class="deco-line"></view>
    </view>
    <text class="guide-title-sub">开启你的草原书法之旅</text>
  </view>

  <view class="start-btn-wrap" catchtap="onAuthTap">
    <view class="start-btn-glow"></view>
    <view class="start-btn-inner">
      <view class="btn-inner-ring"></view>
      <view class="btn-inner-ring btn-inner-ring-2"></view>
      <text class="start-btn-text">开启入籍</text>
    </view>
  </view>

  <view class="guide-choice-wrap {{showGuideChoice ? 'active' : ''}}" wx:if="{{showGuideChoice}}">
    <view class="guide-choice-btns">
      <view class="guide-choice-btn guide-choice-skip" bindtap="onSkipGuide">
        <text>跳过引导</text>
      </view>
      <view class="guide-choice-btn guide-choice-start" bindtap="onStartGuide">
        <text>开始探索</text>
      </view>
    </view>
  </view>
</view>
