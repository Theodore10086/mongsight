page {
  background: linear-gradient(180deg, #f5efe3 0%, #fcf8f0 100%);
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hidden-crop-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 540px;
  height: 900px;
  opacity: 0;
  pointer-events: none;
}

.hero-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #f1eadc;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 20, 16, 0.08);
  border: 1rpx solid rgba(31, 20, 16, 0.08);
  position: relative;
  overflow: hidden;
}

.hero-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255, 249, 239, 0.52);
  z-index: 1;
}

.hero-card-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-mascot,
.hero-text {
  position: relative;
  z-index: 2;
}

.hero-mascot {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(31, 20, 16, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-mascot-glyph {
  width: 56rpx;
  height: 56rpx;
  background-color: var(--brand-secondary-dark);
}

.hero-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-title,
.result-title,
.archive-primer-title,
.player-title {
  color: #221813;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
}

.hero-subtitle,
.result-subtitle,
.error-message,
.lesson-label,
.archive-primer-text,
.player-status {
  color: #5e5349;
}

.hero-subtitle,
.lesson-text,
.archive-primer-text {
  font-size: 24rpx;
  line-height: 1.6;
}

.action-grid,
.preview-actions,
.player-actions,
.study-actions {
  display: flex;
  gap: 16rpx;
}

.action-button,
.minor-button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 18rpx;
  border: none;
  padding: 0 24rpx;
  background: rgba(255, 252, 247, 0.96);
  color: #221813;
  font-weight: 700;
  border: 2rpx solid rgba(31, 20, 16, 0.12);
}

.action-button {
  height: 112rpx;
  font-size: 30rpx;
}

.minor-button {
  height: 88rpx;
  font-size: 28rpx;
}

.action-button::after,
.minor-button::after {
  border: none;
}

.action-button-glyph {
  width: 40rpx;
  height: 40rpx;
}

.action-button.primary,
.minor-button.primary {
  color: #fff;
  border: none;
}

.action-button.primary {
  background: linear-gradient(180deg, #8ba144 0%, #4b7424 100%);
  box-shadow: 0 10rpx 18rpx rgba(75, 116, 36, 0.22);
}

.minor-button.primary {
  background: linear-gradient(180deg, #c79235 0%, #9a671d 100%);
  box-shadow: 0 8rpx 18rpx rgba(154, 103, 29, 0.22);
}

.minor-button.ghost {
  background: transparent;
}

.preview-card,
.error-card,
.result-card,
.archive-primer-card {
  background: rgba(255, 252, 247, 0.96);
  border-radius: 24rpx;
  border: 1rpx solid rgba(31, 20, 16, 0.08);
  padding: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(31, 20, 16, 0.06);
}

.preview-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.preview-image,
.result-preview {
  width: 100%;
  border-radius: 20rpx;
  background: #f5efe3;
  display: block;
}

.preview-image {
  height: 520rpx;
}

.result-preview {
  height: 280rpx;
  margin-top: 20rpx;
}

.error-card {
  background: #fff5f5;
  border-left: 6rpx solid #d96d6d;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.error-title-row,
.player-header,
.result-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.error-title-row {
  justify-content: flex-start;
  align-items: center;
}

.error-title-glyph {
  width: 32rpx;
  height: 32rpx;
}

.error-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #b14c4c;
}

.result-card,
.result-title-block {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 800;
}

.result-subtitle,
.result-time {
  font-size: 22rpx;
}

.result-time {
  color: #75685d;
}

.result-mongolian {
  display: block;
  margin: 24rpx 0 8rpx;
  color: #221813;
  font-size: 80rpx;
  writing-mode: vertical-rl;
  min-height: 240rpx;
  letter-spacing: 12rpx;
  text-align: center;
}

.lesson-card {
  position: relative;
  overflow: hidden;
  border-radius: 22rpx;
  border: 1rpx solid rgba(31, 20, 16, 0.08);
  min-height: 280rpx;
}

.lesson-card-image,
.lesson-card-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.lesson-card-overlay {
  background: linear-gradient(180deg, rgba(255, 251, 245, 0.94) 0%, rgba(246, 239, 226, 0.88) 100%);
}

.lesson-card-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 22rpx;
}

.lesson-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.lesson-label {
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.lesson-text {
  color: #221813;
}

.archive-primer-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  background: linear-gradient(180deg, #f9f4ea 0%, #fffdf8 100%);
}

.archive-primer-title {
  font-size: 30rpx;
  font-weight: 800;
}

.archive-primer-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.archive-primer-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.archive-primer-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #9a671d;
  flex-shrink: 0;
}

.candidate-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 14rpx;
}

.candidate-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 20rpx 6rpx;
  border-radius: 18rpx;
  background: #f7f1e8;
  border: 2rpx solid transparent;
  min-height: 130rpx;
  line-height: 1.2;
  font-size: 26rpx;
  color: #221813;
}

.candidate-button::after {
  border: none;
}

.candidate-chinese {
  font-size: 28rpx;
  font-weight: 800;
}

.candidate-trans,
.candidate-score {
  font-size: 22rpx;
  color: #75685d;
}

.player-card {
  background: #f7f1e8;
  border-radius: 20rpx;
  border: 1rpx solid rgba(31, 20, 16, 0.08);
  padding: 20rpx;
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.player-title {
  font-size: 28rpx;
  font-weight: 700;
}

.player-canvas {
  width: 100%;
  height: 420rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid rgba(31, 20, 16, 0.08);
  display: block;
}
