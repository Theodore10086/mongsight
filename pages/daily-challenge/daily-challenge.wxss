page {
  background: var(--bg-page);
  min-height: 100vh;
}

.challenge-page {
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.challenge-hero {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  text-align: center;
}

.challenge-hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.challenge-hero-desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 挑战卡片 */
.challenge-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
}

.challenge-progress {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.progress-bar {
  height: 10rpx;
  background: var(--bg-soft);
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--brand-primary);
  border-radius: 5rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: right;
}

.challenge-question-wrap {
  margin-bottom: 24rpx;
}

.challenge-type-pill {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-accent-soft);
  font-size: 20rpx;
  color: var(--brand-secondary-dark);
  margin-bottom: 12rpx;
}

.challenge-question {
  display: block;
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.55;
  font-weight: 600;
}

.challenge-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.challenge-option {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 18rpx;
  border-radius: var(--radius-md);
  background: var(--bg-soft);
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.challenge-option:active {
  background: #e8dfcf;
  border-color: var(--brand-primary);
  transform: scale(0.98);
}

.option-letter {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.option-text {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.4;
}

/* 结果卡片 */
.result-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 36rpx 28rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
  text-align: center;
}

.result-header {
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--brand-primary);
}

.result-stats {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 20rpx;
}

.result-stat {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.result-stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.result-stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.result-reward {
  padding: 20rpx;
  background: var(--bg-soft);
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
}

.reward-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-primary);
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
