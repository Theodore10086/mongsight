.uh-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 20rpx 24rpx;
}

.uh-header-card {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 28rpx;
  box-shadow: var(--shadow-card);
}

.uh-header-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #fdf7ed 0%, #fcf3e2 40%, #f8ecce 100%);
}

.uh-header-body {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx 32rpx;
  gap: 14rpx;
}

.uh-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 16rpx rgba(31, 20, 16, 0.1);
}

.uh-avatar-emoji {
  font-size: 90rpx;
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
}

.uh-avatar-default {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
}

.uh-nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.uh-level-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.uh-level-pill {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-accent);
  color: #fff;
  font-weight: 600;
}

.uh-title {
  font-size: 24rpx;
  color: var(--text-muted);
}

.uh-stats {
  display: flex;
  align-items: center;
  gap: 48rpx;
  margin-top: 8rpx;
}

.uh-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.uh-stat-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.uh-stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.uh-follow-btn {
  margin-top: 16rpx;
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  background: var(--brand-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 0 #46a302;
}

.uh-follow-btn-following {
  background: var(--bg-muted);
  color: var(--text-secondary);
  box-shadow: 0 6rpx 0 rgba(31, 20, 16, 0.1);
}

.uh-feed {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.post-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.post-user {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.post-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.post-avatar-emoji {
  font-size: 52rpx;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  flex-shrink: 0;
}

.post-avatar-default {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.post-avatar-glyph {
  width: 32rpx;
  height: 32rpx;
}

.post-user-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.post-nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.post-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.post-content {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.post-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.post-image {
  width: 100%;
  border-radius: var(--radius-sm);
  aspect-ratio: 1;
}

.post-image-1,
.post-image-2 {
  grid-column: span 3;
  aspect-ratio: 16 / 10;
}

.post-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid var(--border-soft);
}

.post-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.post-action-glyph {
  width: 32rpx;
  height: 32rpx;
}

.post-action-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.post-action-liked .post-action-count {
  color: var(--brand-pink);
}
