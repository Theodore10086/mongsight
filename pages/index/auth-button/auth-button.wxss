.auth-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 400rpx;
  height: 96rpx;
  background: #1c1410;
  border-radius: 12rpx;
  overflow: hidden;
  transition: opacity 0.2s ease;
}

.auth-button:active:not(.disabled):not(.loading) {
  opacity: 0.72;
}

.auth-button.disabled {
  background: rgba(28, 20, 16, 0.25);
}

.auth-button.loading {
  background: #1c1410;
}

.button-content {
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 1;
  transition: opacity 0.2s ease;
}

.auth-button.loading .button-content {
  opacity: 0;
}

.button-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.button-text {
  font-size: 30rpx;
  color: #f5f0e8;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.button-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  background: #f5f0e8;
  border-radius: 50%;
  animation: loadingBounce 1.4s ease-in-out infinite;
}

.loading-dot:nth-child(1) { animation-delay: 0s; }
.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes loadingBounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}
