.guide-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.5s ease;
}

.guide-container.active {
  opacity: 1;
  pointer-events: auto;
}

.guide-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #100c08;
  transition: opacity 0.8s ease;
}

/* ── Intro Narrative ───────────────────────────────────────── */

.guide-intro {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 10;
  width: 80%;
}

.intro-narrative {
  display: block;
  font-size: 48rpx;
  color: #f5f0e8;
  letter-spacing: 8rpx;
  font-family: "Noto Serif SC", "STSong", serif;
}

.intro-subtitle {
  display: block;
  margin-top: 40rpx;
  font-size: 30rpx;
  color: rgba(245, 240, 232, 0.55);
  letter-spacing: 8rpx;
  font-weight: 400;
}

.guide-buttons {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-top: 60rpx;
}

.guide-btn {
  padding: 20rpx 60rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  transition: opacity 0.2s ease;
}

.guide-btn-skip {
  background: transparent;
  border: 1.5rpx solid rgba(245, 240, 232, 0.2);
  color: rgba(245, 240, 232, 0.5);
}

.guide-btn-skip:active {
  opacity: 0.6;
}

.guide-btn-start {
  background: #c49a3c;
  color: #1c1410;
  font-weight: 600;
}

.guide-btn-start:active {
  opacity: 0.75;
}

/* ── Fade Animations ───────────────────────────────────────── */

.fade-in {
  animation: fadeIn 2s ease-out forwards;
}

.fade-in-delay {
  animation: fadeIn 2s ease-out 1.5s forwards;
  opacity: 0;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ── Highlight Box ─────────────────────────────────────────── */

.guide-highlight {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.highlight-box {
  position: absolute;
  border-radius: 16rpx;
  box-sizing: border-box;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.highlight-box::before {
  content: '';
  position: absolute;
  top: -3rpx;
  left: -3rpx;
  right: -3rpx;
  bottom: -3rpx;
  border-radius: 18rpx;
  background: rgba(245, 240, 232, 0.15);
  animation: breathing 3s ease-in-out infinite;
  z-index: -1;
}

.highlight-box.breathing::before {
  animation: breathing 2.5s ease-in-out infinite;
}

.highlight-corner {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-color: #f5f0e8;
  border-style: solid;
}

.highlight-corner.top-left    { top: 0;    left: 0;  border-width: 3rpx 0 0 3rpx; }
.highlight-corner.top-right   { top: 0;    right: 0; border-width: 3rpx 3rpx 0 0; }
.highlight-corner.bottom-left { bottom: 0; left: 0;  border-width: 0 0 3rpx 3rpx; }
.highlight-corner.bottom-right{ bottom: 0; right: 0; border-width: 0 3rpx 3rpx 0; }

@keyframes breathing {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50%       { opacity: 0.7; transform: scale(1.02); }
}

/* ── Arrow Pointer ─────────────────────────────────────────── */

.guide-arrow {
  position: absolute;
  z-index: 20;
  animation: arrowBounce 1.5s ease-in-out infinite;
}

.arrow-body {
  width: 3rpx;
  height: 36rpx;
  background: rgba(245, 240, 232, 0.7);
  margin: 0 auto;
}

.arrow-head {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 14rpx solid rgba(245, 240, 232, 0.7);
  margin: 0 auto;
}

.arrow-pulse {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 56rpx;
  height: 56rpx;
  border: 1.5rpx solid rgba(245, 240, 232, 0.35);
  border-radius: 50%;
  animation: arrowPulse 1.5s ease-out infinite;
}

@keyframes arrowBounce {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-10rpx); }
}

@keyframes arrowPulse {
  0%   { transform: translate(-50%, -50%) scale(0.5); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(2);   opacity: 0; }
}

/* ── NPC / Dialog ──────────────────────────────────────────── */

.guide-npc {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 7, 4, 0.5);
}

.npc-sprite {
  width: 100vw;
  height: 100vh;
  object-fit: contain;
}

.npc-bell {
  position: absolute;
  top: 80rpx;
  left: 20rpx;
  width: 24rpx;
  height: 24rpx;
  background: #c49a3c;
  border-radius: 50%;
  animation: bellRing 2s ease-in-out infinite;
}

@keyframes bellRing {
  0%, 100% { transform: rotate(0deg); }
  25%       { transform: rotate(15deg); }
  75%       { transform: rotate(-15deg); }
}

.npc-slideInRight {
  animation: npcFadeIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes npcFadeIn {
  from { transform: translate(-50%, -50%) scale(0.85); opacity: 0; }
  to   { transform: translate(-50%, -50%) scale(1);    opacity: 1; }
}

/* ── Dialog Box ────────────────────────────────────────────── */

.guide-dialog {
  position: fixed;
  top: 50% !important;
  left: 50% !important;
  transform: translate(-50%, -50%) !important;
  width: 80%;
  max-width: 600rpx;
  z-index: 50;
}

.dialog-content {
  background: #1c1410;
  border-radius: 20rpx;
  padding: 40rpx 44rpx;
  border: 1rpx solid rgba(196, 154, 60, 0.3);
  position: relative;
  overflow: hidden;
}

/* Thin gold accent at top of dialog */
.dialog-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: #c49a3c;
}

.dialog-fadein {
  animation: dialogFadeIn 0.4s ease-out 0.3s forwards;
  opacity: 0;
}

@keyframes dialogFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.dialog-text {
  font-size: 30rpx;
  color: #f5f0e8;
  line-height: 1.85;
  letter-spacing: 2rpx;
}

.dialog-action {
  margin-top: 24rpx;
  text-align: right;
}

.dialog-action text {
  display: inline-block;
  padding: 14rpx 44rpx;
  background: #c49a3c;
  color: #1c1410;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}

.dialog-typing {
  margin-top: 24rpx;
  text-align: right;
}

.typing-cursor {
  color: #c49a3c;
  font-size: 30rpx;
  animation: cursorBlink 0.8s infinite;
}

@keyframes cursorBlink {
  0%, 50%  { opacity: 1; }
  51%, 100% { opacity: 0; }
}

/* ── Awakening Effect ──────────────────────────────────────── */

.guide-awakening {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 50;
  text-align: center;
}

.awakening-effect {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.golden-burst {
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(196, 154, 60, 0.6) 0%, rgba(196, 154, 60, 0) 70%);
  animation: goldenBurst 1.5s ease-out forwards;
}

@keyframes goldenBurst {
  0%   { transform: translate(-50%, -50%) scale(0); opacity: 0; }
  30%  { opacity: 0.8; }
  100% { transform: translate(-50%, -50%) scale(3); opacity: 0; }
}

.awakening-badge {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: badgeAppear 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s forwards;
  opacity: 0;
}

@keyframes badgeAppear {
  from { transform: scale(0) rotate(-20deg); opacity: 0; }
  to   { transform: scale(1) rotate(0deg);   opacity: 1; }
}

.badge-icon {
  font-size: 80rpx;
  line-height: 1;
}

.badge-text {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #c49a3c;
  letter-spacing: 4rpx;
  font-weight: 600;
}
