.bubble-container {
  position: fixed;
  z-index: 100;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: none;
}

.bubble-container.active {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.bubble-wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  max-width: 560rpx;
}

.bubble-tail {
  position: absolute;
  left: 40rpx;
  top: -14rpx;
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 14rpx solid #faf7f2;
}

.bubble-content {
  display: flex;
  align-items: flex-start;
  background: #faf7f2;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.1);
  box-shadow: 0 8rpx 32rpx rgba(28, 20, 16, 0.08);
}

.bubble-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: #ede8df;
}

.bubble-text-area {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bubble-name {
  font-size: 22rpx;
  color: rgba(28, 20, 16, 0.45);
  font-weight: 600;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.bubble-message {
  font-size: 28rpx;
  color: #1c1410;
  line-height: 1.65;
  letter-spacing: 1rpx;
}

.bubble-action {
  margin-top: 16rpx;
  text-align: right;
}

.action-text {
  display: inline-block;
  padding: 14rpx 36rpx;
  background: #1c1410;
  color: #f5f0e8;
  font-size: 26rpx;
  border-radius: 10rpx;
  letter-spacing: 2rpx;
}
