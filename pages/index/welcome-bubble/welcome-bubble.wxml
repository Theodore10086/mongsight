<view class="bubble-container {{visible ? 'active' : ''}}">
  <view class="bubble-wrapper">
    <view class="bubble-tail"></view>
    <view class="bubble-content">
      <image class="bubble-avatar" src="{{avatar}}" mode="aspectFit"></image>
      <view class="bubble-text-area">
        <text class="bubble-name">{{name}}</text>
        <text class="bubble-message">{{message}}</text>
      </view>
    </view>
  </view>
  <view class="bubble-action" wx:if="{{showAction}}">
    <text class="action-text">{{actionText}}</text>
  </view>
</view>
