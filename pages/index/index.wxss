  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  backdrop-filter: blur(5px);
}

.btn-circle.primary {
  background: linear-gradient(135deg, #d74a49 0%, #a63231 100%);
  border: none;
  box-shadow: 0 8rpx 25rpx rgba(215, 74, 73, 0.4);
}

.btn-circle:active {
  transform: scale(0.9);
}

.btn-icon {
  font-size: 40rpx;
}

.btn-label {
  color: #fff;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* --- 典雅中式选帖面板 --- */
.lesson-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.lesson-picker-modal.active {
  opacity: 1;
  pointer-events: auto;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(10px);
}

.picker-content {
  position: relative;
  width: 90%;
  max-width: 600rpx;
  background: #f4f3ea; /* 米黄色宣纸纹理 */
  border: 3rpx solid #8b4513; /* 深棕色边框 */
  border-radius: 12rpx;
  box-shadow: 
    0 10rpx 40rpx rgba(0, 0, 0, 0.3),
    0 0 0 2rpx rgba(139, 69, 19, 0.2);
  transform: scale(0.9);
  opacity: 0;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.lesson-picker-modal.active .picker-content {
  transform: scale(1);
  opacity: 1;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  border-bottom: 2rpx solid #8b4513;
  background: linear-gradient(135deg, rgba(139, 69, 19, 0.05) 0%, rgba(160, 82, 45, 0.05) 100%);
}

.picker-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #8b4513;
  font-family: "STKaiti", "KaiTi", "SimKai", serif;
  letter-spacing: 4rpx;
}

.picker-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(139, 69, 19, 0.1);
  border-radius: 50%;
  border: 1rpx solid #8b4513;
  cursor: pointer;
  transition: all 0.3s;
}

.picker-close:active {
  background: rgba(139, 69, 19, 0.2);
  transform: scale(0.9);
}

.close-icon {
  font-size: 20rpx;
  color: #8b4513;
}

.picker-body {
  padding: 40rpx;
}

.lesson-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.lesson-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(139, 69, 19, 0.3);
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
}

.lesson-item:active {
  transform: scale(0.95);
}

.lesson-item.active {
  border-color: #d74a49;
  background: rgba(215, 74, 73, 0.05);
  box-shadow: 0 0 0 2rpx rgba(215, 74, 73, 0.3);
}

.lesson-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.lesson-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #8b4513;
  font-family: "STKaiti", "KaiTi", "SimKai", serif;
  margin-bottom: 8rpx;
}

.lesson-subtitle {
  font-size: 18rpx;
  color: #a0522d;
  opacity: 0.7;
}

.seal-mark {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  background: #d74a49;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(215, 74, 73, 0.4);
}

.seal-mark text {
  font-size: 16rpx;
  color: #fff;
  font-weight: 700;
  font-family: "STKaiti", "KaiTi", "SimKai", serif;
}

.picker-footer {
  padding: 24rpx 40rpx;
  border-top: 1rpx solid rgba(139, 69, 19, 0.2);
  text-align: center;
  background: rgba(139, 69, 19, 0.02);
}

.footer-tip {
  font-size: 20rpx;
  color: #8b4513;
  opacity: 0.6;
  font-family: "STKaiti", "KaiTi", "SimKai", serif;
  letter-spacing: 2rpx;
}

/* --- 底部工具栏折叠样式（居中设计） --- */
.bottom-dock {
  position: fixed;
  bottom: 50rpx; /* 适配全面屏安全区 */
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100; /* 固定在底部 */
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.bottom-dock.minimized {
  bottom: 20rpx;
}

.bottom-dock.minimized .action-capsule {
  width: 100rpx; /* 最小化时变成小横条 */
  height: 40rpx;
  border-radius: 20rpx;
  padding: 0;
  justify-content: center;
  background: rgba(0, 0, 0, 0.4);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(20px);
  box-shadow: 
    0 4rpx 20rpx rgba(0, 0, 0, 0.2),
    0 0 0 1rpx rgba(255, 255, 255, 0.1);
}

.bottom-dock.minimized .capsule-btn,
.bottom-dock.minimized .capsule-divider {
  display: none; /* 隐藏所有按钮 */
}

.dock-toggle {
  width: 140rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 2.5rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  backdrop-filter: blur(30px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 
    0 1rpx 4rpx rgba(0, 0, 0, 0.4),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.2);
}

.bottom-dock.collapsed .dock-toggle {
  background: rgba(255, 255, 255, 0.9);
  transform: scale(1);
  opacity: 0.9;
  width: 140rpx;
  height: 5rpx;
}

.dock-toggle:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.7);
}

.bottom-dock.collapsed .dock-toggle:active {
  transform: scale(1.1);
  background: rgba(255, 255, 255, 0.6);
}

.toggle-icon {
  font-size: 14rpx;
  color: rgba(255, 255, 255, 0.9);
  transition: all 0.3s ease;
  opacity: 0;
}

.bottom-dock.collapsed .toggle-icon {
  opacity: 0;
  transform: rotate(0deg);
}

.bottom-dock:not(.collapsed) .toggle-icon {
  opacity: 1;
}

.action-capsule {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(40px);
  border-radius: 50rpx;
  padding: 0 20rpx;
  box-shadow: 
    0 16rpx 50rpx rgba(0, 0, 0, 0.25),
    0 0 0 1rpx rgba(255, 255, 255, 0.5);
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  transform-origin: center bottom;
}

.bottom-dock.collapsed .action-capsule {
  opacity: 0;
  transform: scale(0.6) translateY(30rpx);
  pointer-events: none;
}

.bottom-dock:not(.collapsed) .action-capsule {
  opacity: 1;
  transform: scale(1) translateY(0);
  animation: capsuleBounce 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes capsuleBounce {
  0% {
    transform: scale(0.6) translateY(30rpx);
    opacity: 0;
  }
  60% {
    transform: scale(1.1) translateY(-5rpx);
    opacity: 0.9;
  }
  80% {
    transform: scale(0.95) translateY(2rpx);
    opacity: 1;
  }
  100% {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

/* --- 字帖调节悬浮球样式 --- */
.template-control-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 110;
  pointer-events: none; /* 整个区域不拦截事件 */
}

.template-control-area.visible {
  pointer-events: none;
}

.template-control-ball {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  z-index: 111;
  pointer-events: auto; /* 只有球本身可交互 */
}

.ball-icon {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(40px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.2),
    0 0 0 1rpx rgba(255, 255, 255, 0.4);
  transition: all 0.3s ease;
}

.ball-panel {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) scale(0);
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: none;
  margin-top: 10rpx;
}

.ball-panel.expanded {
  transform: translateX(-50%) scale(1);
  opacity: 1;
  pointer-events: auto;
}

.panel-content {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(50px);
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 
    0 20rpx 60rpx rgba(0, 0, 0, 0.25),
    0 0 0 1rpx rgba(255, 255, 255, 0.5);
  min-width: 280rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.control-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.control-label {
  font-size: 14rpx;
  color: #666;
  font-weight: 600;
  min-width: 40rpx;
}

.control-group slider {
  flex: 1;
  margin: 0;
}

.control-value {
  font-size: 14rpx;
  color: #1c1410;
  font-weight: 600;
  min-width: 40rpx;
  text-align: center;
}

/* --- 选帖面板幽灵按钮样式 --- */
.footer-actions {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
}

.ghost-button {
  padding: 12rpx 24rpx;
  background: transparent;
  border: 1rpx solid rgba(139, 69, 19, 0.3);
  border-radius: 20rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.ghost-button:active {
  background: rgba(139, 69, 19, 0.05);
  transform: scale(0.95);
}

.ghost-text {
  font-size: 20rpx;
  color: #8b4513;
  opacity: 0.7;
  font-family: "STKaiti", "KaiTi", "SimKai", serif;
}

/* ========================================
   沉浸式仪式容器 - 原神风格
   ======================================== */

/* 全屏容器 */
.ritual-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.8s ease;
}

.ritual-container.active {
  opacity: 1;
  pointer-events: auto;
}

/* 背景层 */
.ritual-bg-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.ritual-poster,
.ritual-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ritual-poster {
  z-index: 1;
}

.ritual-video {
  z-index: 2;
}

/* NPC 角色锚点 */
.npc-anchors {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.npc-slot {
  position: absolute;
  bottom: 10vh;
  width: 25vh;
  height: 40vh;
  max-width: 280rpx;
  max-height: 400rpx;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@media (min-width: 768px) {
  .npc-slot {
    bottom: 12vh;
    width: 30vh;
    height: 45vh;
  }
}

.npc-slot.visible {
  opacity: 1;
  transform: translateY(0);
}

.npc-left {
  left: 20rpx;
}

.npc-right {
  right: 20rpx;
}

.npc-portrait {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* NPC 发光效果 */
.npc-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 120%;
  height: 120%;
  border-radius: 50%;
  filter: blur(40rpx);
  opacity: 0;
  animation: npcGlow 2s ease-in-out infinite;
}

.npc-slot.visible .npc-glow {
  opacity: 0.6;
}

.npc-glow-mengbao {
  background: radial-gradient(circle, rgba(255, 200, 100, 0.8), transparent 70%);
}

.npc-glow-altan {
  background: radial-gradient(circle, rgba(100, 180, 255, 0.8), transparent 70%);
}

@keyframes npcGlow {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
  50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.8; }
}

/* 原神风格对话框 */
.dialog-box {
  position: absolute;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  min-height: 240rpx;
  max-height: 320rpx;
  z-index: 20;
  background: rgba(30, 25, 20, 0.85);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border-radius: 24rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.4);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  opacity: 0;
  transform: translateY(30rpx);
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
}

.dialog-box.visible {
  opacity: 1;
  transform: translateY(0);
}

/* 蒙古云纹装饰 */
.dialog-cloud-decoration {
  position: absolute;
  left: 0;
  right: 0;
  height: 16rpx;
  background-repeat: repeat-x;
  background-size: 60rpx 16rpx;
}

.dialog-cloud-decoration.top {
  top: 0;
  background-position: 0 0;
  background-image: 
    radial-gradient(ellipse 20rpx 8rpx at 10rpx 8rpx, rgba(212, 175, 55, 0.6) 0%, transparent 70%),
    radial-gradient(ellipse 16rpx 6rpx at 40rpx 10rpx, rgba(212, 175, 55, 0.4) 0%, transparent 70%),
    radial-gradient(ellipse 20rpx 8rpx at 70rpx 6rpx, rgba(212, 175, 55, 0.5) 0%, transparent 70%),
    radial-gradient(ellipse 14rpx 5rpx at 100rpx 10rpx, rgba(212, 175, 55, 0.3) 0%, transparent 70%),
    radial-gradient(ellipse 18rpx 7rpx at 130rpx 8rpx, rgba(212, 175, 55, 0.4) 0%, transparent 70%),
    radial-gradient(ellipse 16rpx 6rpx at 160rpx 10rpx, rgba(212, 175, 55, 0.5) 0%, transparent 70%),
    radial-gradient(ellipse 20rpx 8rpx at 190rpx 6rpx, rgba(212, 175, 55, 0.3) 0%, transparent 70%),
    radial-gradient(ellipse 14rpx 5rpx at 220rpx 10rpx, rgba(212, 175, 55, 0.4) 0%, transparent 70%),
    radial-gradient(ellipse 18rpx 7rpx at 250rpx 8rpx, rgba(212, 175, 55, 0.5) 0%, transparent 70%),
    radial-gradient(ellipse 16rpx 6rpx at 280rpx 10rpx, rgba(212, 175, 55, 0.3) 0%, transparent 70%),
    radial-gradient(ellipse 20rpx 8rpx at 310rpx 6rpx, rgba(212, 175, 55, 0.4) 0%, transparent 70%),
    radial-gradient(ellipse 14rpx 5rpx at 340rpx 10rpx, rgba(212, 175, 55, 0.5) 0%, transparent 70%);
}

.dialog-cloud-decoration.bottom {
  bottom: 0;
  background-image: 
    radial-gradient(ellipse 14rpx 5rpx at 10rpx 8rpx, rgba(212, 175, 55, 0.3) 0%, transparent 70%),
    radial-gradient(ellipse 18rpx 7rpx at 40rpx 6rpx, rgba(212, 175, 55, 0.4) 0%, transparent 70%),
    radial-gradient(ellipse 16rpx 6rpx at 70rpx 10rpx, rgba(212, 175, 55, 0.5) 0%, transparent 70%),
    radial-gradient(ellipse 20rpx 8rpx at 100rpx 8rpx, rgba(212, 175, 55, 0.4) 0%, transparent 70%),
    radial-gradient(ellipse 14rpx 5rpx at 130rpx 6rpx, rgba(212, 175, 55, 0.3) 0%, transparent 70%),
    radial-gradient(ellipse 18rpx 7rpx at 160rpx 10rpx, rgba(212, 175, 55, 0.5) 0%, transparent 70%),
    radial-gradient(ellipse 16rpx 6rpx at 190rpx 8rpx, rgba(212, 175, 55, 0.4) 0%, transparent 70%),
    radial-gradient(ellipse 20rpx 8rpx at 220rpx 6rpx, rgba(212, 175, 55, 0.3) 0%, transparent 70%),
    radial-gradient(ellipse 14rpx 5rpx at 250rpx 10rpx, rgba(212, 175, 55, 0.4) 0%, transparent 70%),
    radial-gradient(ellipse 18rpx 7rpx at 280rpx 8rpx, rgba(212, 175, 55, 0.5) 0%, transparent 70%),
    radial-gradient(ellipse 16rpx 6rpx at 310rpx 6rpx, rgba(212, 175, 55, 0.3) 0%, transparent 70%),
    radial-gradient(ellipse 20rpx 8rpx at 340rpx 10rpx, rgba(212, 175, 55, 0.4) 0%, transparent 70%);
}

/* 说话者名称 */
.dialog-speaker {
  padding: 20rpx 32rpx 12rpx;
}

.speaker-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #c49a3c;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
  letter-spacing: 2rpx;
}

/* 对话内容 */
.dialog-content {
  padding: 16rpx 32rpx;
  min-height: 100rpx;
  display: flex;
  align-items: flex-start;
}

.dialog-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #f5f0e6;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.5);
}

/* 打字机光标 */
.dialog-cursor {
  width: 4rpx;
  height: 32rpx;
  background: #c49a3c;
  margin-left: 4rpx;
  animation: cursorBlink 0.8s steps(1) infinite;
}

@keyframes cursorBlink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

/* 继续提示 */
.dialog-continue {
  padding: 16rpx 32rpx 24rpx;
  display: flex;
  justify-content: center;
}

.continue-text {
  font-size: 24rpx;
  color: rgba(212, 175, 55, 0.8);
  animation: continuePulse 1.5s ease-in-out infinite;
}

@keyframes continuePulse {
  0%, 100% { opacity: 0.6; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(4rpx); }
}

