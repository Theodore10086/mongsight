    inset 0 0 20rpx rgba(212, 175, 55, 0.05);
  position: relative;
  overflow: hidden;
}

.footer-chip.coordinate-chip::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at center, rgba(212, 175, 55, 0.15) 0%, transparent 70%);
