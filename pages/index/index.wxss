.guide-capsule.collapsed {
  width: 60rpx;
  justify-content: center;
}

/* 展开态：横向展开显示文字 */
.guide-capsule.expanded {
  width: auto;
}

.guide-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.guide-capsule.collapsed .guide-icon {
  margin-right: 0;
}

.guide-text {
  font-size: 24rpx;
  color: #fff; /* 白色文字 */
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.app-footer {
  position: fixed;
  bottom: 6rpx;
