/* ========================================
   引导流程界面样式
   ======================================== */

.guide-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s ease;
}

.guide-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

/* 对话舞台样式 */
.dialog-stage {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s ease;
}

.dialog-stage.active {
  opacity: 1;
  pointer-events: auto;
}

.dialog-stage .hero-portrait-center {
  position: absolute;
  bottom: 15vh;
  left: 50%;
  transform: translateX(-50%);
  width: 45vh;
  height: 65vh;
  max-width: 500rpx;
  max-height: 700rpx;
  opacity: 0;
  transition: all 0.5s ease;
  z-index: 5;
  transform-style: preserve-3d;
  backface-visibility: hidden;
}

.dialog-stage .hero-portrait-center.flip-to-back {
  transform: translateX(-50%) rotateY(180deg);
}

.dialog-stage .hero-portrait-center.inactive {
  opacity: 0;
  transform: translateX(-50%) scale(0.8) rotateY(180deg);
  z-index: 3;
}

.dialog-stage .hero-portrait-center:not(.inactive) {
  opacity: 1;
  z-index: 10;
}

@media (min-width: 768px) {
  .dialog-stage .hero-portrait-center {
    bottom: 18vh;
    width: 50vh;
    height: 70vh;
    max-width: 600rpx;
    max-height: 800rpx;
  }
}

.dialog-stage .hero-portrait-center.inactive {
  opacity: 0;
  transform: translateX(-50%) scale(0.8) rotateY(180deg);
  z-index: 3;
}

.dialog-stage .hero-portrait-center:not(.inactive) {
  opacity: 1;
  z-index: 10;
}

.dialog-stage .dialog-box {
  position: absolute;
  bottom: 60rpx;
  left: 40rpx;
  right: 40rpx;
  opacity: 0;
  transform: translateY(30rpx);
  transition: all 0.4s ease;
}

.dialog-stage .dialog-box.visible {
  opacity: 1;
  transform: translateY(0);
}

.dialog-speaker {
  background: linear-gradient(135deg, #c49a3c, #c9a227);
  padding: 12rpx 24rpx;
  border-radius: 12rpx 12rpx 0 0;
  display: inline-block;
}

.speaker-name {
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 600;
}

.dialog-stage .dialog-content {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 0 24rpx 24rpx 24rpx;
  padding: 32rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(212, 175, 55, 0.3);
}

.dialog-stage .dialog-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
}

.dialog-stage .dialog-continue {
  text-align: center;
  padding: 20rpx;
}

.continue-text {
  color: #c49a3c;
  font-size: 26rpx;
}

.dialog-cursor {
  display: inline-block;
  width: 4rpx;
  height: 30rpx;
  background: #c49a3c;
  animation: blink 0.8s infinite;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

/* 星空草原背景 */
.starfield-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #0d0906;
  overflow: hidden;
}

.stars {
  position: absolute;
  width: 100%;
  height: 100%;
  background-image: 
    radial-gradient(2rpx 2rpx at 20rpx 30rpx, #fff, transparent),
    radial-gradient(2rpx 2rpx at 40rpx 70rpx, rgba(255,255,255,0.8), transparent),
    radial-gradient(1rpx 1rpx at 90rpx 40rpx, #fff, transparent),
    radial-gradient(2rpx 2rpx at 130rpx 80rpx, rgba(255,255,255,0.6), transparent),
    radial-gradient(1rpx 1rpx at 160rpx 120rpx, #fff, transparent),
    radial-gradient(2rpx 2rpx at 200rpx 50rpx, rgba(255,255,255,0.7), transparent),
    radial-gradient(1rpx 1rpx at 250rpx 150rpx, #fff, transparent),
    radial-gradient(2rpx 2rpx at 300rpx 90rpx, rgba(255,255,255,0.5), transparent),
    radial-gradient(1rpx 1rpx at 350rpx 180rpx, #fff, transparent),
    radial-gradient(2rpx 2rpx at 400rpx 60rpx, rgba(255,255,255,0.8), transparent);
  background-size: 450rpx 200rpx;
  animation: twinkle 4s ease-in-out infinite;
}

.nebula {
  position: absolute;
  width: 100%;
  height: 60%;
  bottom: 0;
  background: linear-gradient(180deg, transparent 0%, rgba(88, 28, 135, 0.15) 30%, rgba(59, 7, 100, 0.2) 60%, rgba(30, 10, 50, 0.4) 100%);
  filter: blur(30rpx);
}

@keyframes twinkle {
  0%, 100% { opacity: 0.8; }
  50% { opacity: 1; }
}

/* 角色立绘 */
.hero-portrait {
  position: absolute;
  bottom: 0;
  height: 75vh;
  width: 45vw;
  z-index: 10;
  -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,1) 60%, rgba(0,0,0,0.7) 80%, rgba(0,0,0,0) 100%);
  mask-image: linear-gradient(to top, rgba(0,0,0,1) 60%, rgba(0,0,0,0.7) 80%, rgba(0,0,0,0) 100%);
  -webkit-mask-position: bottom;
  mask-position: bottom;
  animation: heroBreathe 6s ease-in-out infinite;
}

.hero-left {
  left: 0;
  animation-delay: 0s;
}

.hero-right {
  right: 0;
  animation-delay: -3s;
}

@keyframes heroBreathe {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15rpx); }
}

/* 角色非活动状态 - 半透明+灰度 */
.hero-portrait.inactive {
  opacity: 0.4;
  filter: grayscale(0.8);
  transition: all 0.5s ease;
}

/* 标题区域 */
.guide-title-wrap {
  position: absolute;
  top: 15vh;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 20;
}

.guide-title-main {
  font-size: 72rpx;
  font-weight: 800;
  color: #f5e6c8;
  text-shadow: 0 0 30rpx rgba(212, 175, 55, 0.5), 0 4rpx 20rpx rgba(0, 0, 0, 0.8);
  letter-spacing: 8rpx;
}

.guide-title-sub {
  font-size: 28rpx;
  color: rgba(200, 180, 150, 0.8);
  margin-top: 20rpx;
  letter-spacing: 4rpx;
}

/* 金色光晕按钮 */
.start-btn-wrap {
  position: absolute;
  bottom: 28vh;
  left: 50%;
  transform: translateX(-50%);
  z-index: 30;
  cursor: pointer;
}

.start-btn-glow {
  position: absolute;
  top: -20rpx;
  left: -30rpx;
  right: -30rpx;
  bottom: -20rpx;
  background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.4) 0%, rgba(212, 175, 55, 0.1) 50%, transparent 70%);
  border-radius: 100rpx;
  animation: glowPulse 2s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { transform: scale(1); opacity: 0.8; }
  50% { transform: scale(1.1); opacity: 1; }
}

.start-btn-inner {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c49a3c 0%, #f5e6c8 50%, #c9a227 100%);
  display: flex;
