/* ============================================================
   SVG ICON SYSTEM
   All icons are thin line-style SVGs embedded as CSS backgrounds.
   Ink color (#1c1410) used on light surfaces.
   Light color (#f5f0e8) used on dark surfaces.
   ============================================================ */

/* Hamburger menu icon */
.icon-menu {
  width: 36rpx;
  height: 36rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231c1410' stroke-width='1.5' stroke-linecap='round'><line x1='3' y1='6' x2='21' y2='6'/><line x1='3' y1='12' x2='21' y2='12'/><line x1='3' y1='18' x2='21' y2='18'/></svg>");
}

/* Score/chart icon */
.icon-score {
  width: 32rpx;
  height: 32rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23f5f0e8' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><line x1='18' y1='20' x2='18' y2='10'/><line x1='12' y1='20' x2='12' y2='4'/><line x1='6' y1='20' x2='6' y2='14'/></svg>");
}

/* Sidebar tab icons */
.icon-tab-zitie, .icon-tab-bi, .icon-tab-lk, .icon-tab-sl {
  width: 32rpx;
  height: 32rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* 字帖: book/scroll icon */
.icon-tab-zitie {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231c1410' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M4 19.5A2.5 2.5 0 0 1 6.5 17H20'/><path d='M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z'/></svg>");
}

.tab-item.active .icon-tab-zitie {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23f5f0e8' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M4 19.5A2.5 2.5 0 0 1 6.5 17H20'/><path d='M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z'/></svg>");
}

/* 笔纸: pen nib icon */
.icon-tab-bi {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231c1410' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M12 20h9'/><path d='M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z'/></svg>");
}

.tab-item.active .icon-tab-bi {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23f5f0e8' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M12 20h9'/><path d='M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z'/></svg>");
}

/* 落款: seal/stamp icon */
.icon-tab-lk {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231c1410' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='18' height='18' rx='2'/><line x1='9' y1='9' x2='15' y2='9'/><line x1='9' y1='12' x2='15' y2='12'/><line x1='9' y1='15' x2='13' y2='15'/></svg>");
}

.tab-item.active .icon-tab-lk {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23f5f0e8' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='18' height='18' rx='2'/><line x1='9' y1='9' x2='15' y2='9'/><line x1='9' y1='12' x2='15' y2='12'/><line x1='9' y1='15' x2='13' y2='15'/></svg>");
}

/* 试炼: target/challenge icon */
.icon-tab-sl {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231c1410' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><circle cx='12' cy='12' r='6'/><circle cx='12' cy='12' r='2'/></svg>");
}

.tab-item.active .icon-tab-sl {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23f5f0e8' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><circle cx='12' cy='12' r='6'/><circle cx='12' cy='12' r='2'/></svg>");
}

/* Action button icons in sidebar */
.icon-frame, .icon-export {
  width: 40rpx;
  height: 40rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.icon-frame {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231c1410' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='18' height='18' rx='2'/><path d='M3 9h18M9 21V9'/></svg>");
}

.icon-export {
  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231c1410' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'/><polyline points='17 8 12 3 7 8'/><line x1='12' y1='3' x2='12' y2='15'/></svg>");
}

/* ============================================================ */

page {
  height: 100vh;
  overflow: hidden;
  background: #f5f0e8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.canvas-zone {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.canvas-zone::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: -1;
}

.canvas-zone.skin-xuan {
  background: 
    linear-gradient(135deg, rgba(250, 248, 245, 0.95) 0%, rgba(240, 235, 227, 0.95) 100%),
    url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
}

.canvas-zone.skin-cao {
  background: 
    linear-gradient(135deg, rgba(232, 220, 200, 0.95) 0%, rgba(212, 196, 168, 0.95) 100%),
    url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
}

.canvas-zone.skin-gold {
  background-color: #f4f3ea; /* 米白底 */
  background-image: 
    radial-gradient(#c49a3c 1.5px, transparent 1.5px), 
    radial-gradient(#c49a3c 1px, transparent 1px);
  background-size: 60px 60px, 40px 40px;
  background-position: 0 0, 30px 30px;
}

.template-layer {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: auto;
  opacity: 0;
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
  filter: blur(0px);
  padding: 20rpx;
  box-sizing: border-box;
}

.template-layer.visible {
  opacity: 0.5;
  filter: blur(0.5px);
}

.main-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 100;
  pointer-events: auto;
}

.canvas-area {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 100;
  pointer-events: auto;
}

.top-bar {
  position: fixed;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 250;
  width: 94%;
  max-width: 720rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sidebar-trigger {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(250, 247, 242, 0.95);
  border-radius: 50%;
  border: 1rpx solid rgba(28, 20, 16, 0.1);
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.sidebar-trigger:active {
  transform: scale(0.92);
}

.trigger-icon {
  width: 36rpx;
  height: 36rpx;
}

.user-pill {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 20rpx 10rpx 12rpx;
  background: rgba(250, 247, 242, 0.95);
  border-radius: 50rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.1);
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.user-avatar-small {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background: #1c1410;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
}

.user-avatar-small image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-avatar-small::after {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  right: 2rpx;
  height: 40%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.4) 0%, transparent 100%);
  border-radius: 50% 50% 0 0;
}

.user-meta {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.user-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

.user-rank {
  font-size: 18rpx;
  color: #888;
  font-weight: 400;
}

.ink-jade-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  background: rgba(28, 20, 16, 0.08);
  border-radius: 16rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.14);
}

.jade-icon {
  font-size: 18rpx;
}

.jade-count {
  font-size: 22rpx;
  font-weight: 700;
  color: #1c1410;
}

.template-modules {
  position: fixed;
  top: 100rpx;
  right: 20rpx;
  z-index: 160;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  opacity: 0;
  transform: translateX(50rpx);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.template-modules.visible {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}

.tools-row {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

.floating-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 22rpx;
  background: rgba(250, 247, 242, 0.95);
  border-radius: 40rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.1);
  cursor: pointer;
  transition: opacity 0.2s ease;
  position: relative;
  z-index: 260;
}

.floating-pill:active {
  opacity: 0.6;
}

.floating-pill.active {
  background: #1c1410;
  border-color: transparent;
}

.floating-pill.active .pill-text {
  color: #f5f0e8;
}

.floating-pill.active .pill-icon {
  color: #f5f0e8;
}

.pill-icon {
  font-size: 28rpx;
  position: relative;
  z-index: 1;
}

.pill-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #2a2a2a;
  position: relative;
  z-index: 1;
}

.coordinate-fab {
  position: fixed;
  left: 18rpx;
  top: 38%;
  z-index: 180;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 96rpx;
  height: 96rpx;
  background: #1c1410;
  border-radius: 20rpx;
  cursor: pointer;
  transition: opacity 0.2s ease;
  overflow: hidden;
}

.coordinate-fab .fab-icon {
  font-size: 36rpx;
}

.coordinate-fab .fab-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  position: relative;
  z-index: 1;
}

.coordinate-fab:active {
  transform: scale(0.92);
}

.fab-icon {
  font-size: 36rpx;
}

@keyframes rotate {
  100% { transform: rotate(360deg); }
}

.fab-icon {
  font-size: 52rpx;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2));
}

.fab-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #1c1410;
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
}

.elegant-sidebar {
  position: fixed;
  left: -420rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 170;
  width: 400rpx;
  max-height: 75vh;
  background: #faf7f2;
  border-radius: 0 24rpx 24rpx 0;
  box-shadow: 8rpx 0 40rpx rgba(28, 20, 16, 0.1);
  border-right: 1rpx solid rgba(28, 20, 16, 0.08);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  display: flex;
}

.elegant-sidebar.expanded {
  left: 0;
}

.sidebar-content {
  flex: 1;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  overflow-y: auto;
}

.sidebar-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.section-title {
  font-size: 18rpx;
  font-weight: 600;
  color: #999;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  padding-left: 8rpx;
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 16rpx;
  background: #1c1410;
  border-radius: 2rpx;
}

.quick-actions {
  display: flex;
  gap: 10rpx;
  position: relative;
  z-index: 10;
}

.action-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 12rpx;
  background: linear-gradient(135deg, rgba(245, 245, 245, 0.9) 0%, rgba(235, 235, 235, 0.9) 100%);
  border-radius: 20rpx;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  z-index: 10;
}

.action-chip::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.6) 0%, transparent 100%);
  pointer-events: none;
}

.action-chip:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
  background: linear-gradient(135deg, #fff 0%, #f8f8f8 100%);
}

.action-chip:active {
  transform: scale(0.96);
  transition: all 0.1s;
}

.chip-icon {
  font-size: 32rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.chip-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #444;
}

.paper-selector {
  display: flex;
  gap: 10rpx;
}

.paper-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 10rpx;
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.paper-option::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(28, 20, 16, 0.1) 0%, rgba(28, 20, 16, 0.1) 100%);
  opacity: 0;
  transition: opacity 0.3s;
}

.paper-option.active::before {
  opacity: 1;
}

.paper-option.active {
  box-shadow: 0 4rpx 20rpx rgba(28, 20, 16, 0.2);
}

.paper-preview {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  box-shadow: 
    0 3rpx 10rpx rgba(0, 0, 0, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
  position: relative;
  overflow: hidden;
}

.paper-preview::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 40%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, transparent 100%);
  border-radius: 12rpx 12rpx 0 0;
}

.paper-preview.xuan {
  background: linear-gradient(135deg, #faf8f5 0%, #f4f1ea 100%);
}

.paper-preview.cao {
  background: linear-gradient(135deg, #e8dcc8 0%, #d4c4a8 100%);
}

.paper-preview.gold {
  background: linear-gradient(135deg, #faf6e8 0%, #f0e6c8 100%);
  background-image: 
    radial-gradient(circle at 20% 30%, rgba(212, 175, 55, 0.25) 0%, transparent 30%),
    radial-gradient(circle at 80% 70%, rgba(212, 175, 55, 0.25) 0%, transparent 30%),
    radial-gradient(circle at 50% 50%, rgba(218, 165, 32, 0.15) 0%, transparent 40%),
    radial-gradient(circle at 30% 80%, rgba(255, 215, 0, 0.2) 0%, transparent 25%),
    radial-gradient(circle at 70% 20%, rgba(255, 215, 0, 0.2) 0%, transparent 25%);
}

.paper-option text {
  font-size: 16rpx;
  color: #666;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.paper-option.active text {
  color: #1c1410;
  font-weight: 600;
}

/* --- 笔刷粗细调节器样式 --- */
.pen-settings-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.size-slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.size-label {
  font-size: 16rpx;
  color: #999;
  font-weight: 600;
  min-width: 40rpx;
}

.size-slider-row slider {
  flex: 1;
  margin: 0;
}

.current-size-dot {
  border-radius: 50%;
  transition: all 0.2s ease;
  box-shadow: 
    0 2rpx 8rpx rgba(0, 0, 0, 0.3),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.color-swatches {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  position: relative;
  z-index: 1;
  overflow: hidden;
}

.color-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx;
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  z-index: 1;
  overflow: hidden;
  isolation: isolate;
}

.color-option::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(28, 20, 16, 0.1) 0%, rgba(28, 20, 16, 0.1) 100%);
  opacity: 0;
  transition: opacity 0.3s;
  border-radius: 16rpx;
  pointer-events: none;
}

.color-option.active::before {
  opacity: 1;
}

.color-option.active {
  box-shadow: 0 2rpx 10rpx rgba(28, 20, 16, 0.2);
}

.color-swatch {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  box-shadow: 
    0 2rpx 6rpx rgba(0, 0, 0, 0.15),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.1),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.3);
  position: relative;
  z-index: 1;
}

.color-swatch::after {
  content: '';
  position: absolute;
  top: 3rpx;
  left: 10%;
  width: 80%;
  height: 40%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.6) 0%, transparent 100%);
  border-radius: 50%;
}

.color-option:hover {
  transform: scale(1.05);
}

.color-option.active .color-swatch {
  transform: scale(1.1);
  box-shadow: 
    0 0 0 3rpx #fff,
    0 3rpx 15rpx rgba(28, 20, 16, 0.4),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.1),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.3);
}

.color-name {
  font-size: 16rpx;
  color: #666;
