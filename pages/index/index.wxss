  align-items: center;
  gap: 8rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stat-num {
  font-size: 40rpx;
  color: #1c1410;
  font-weight: 700;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.music-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.music-picker-mask.active {
  opacity: 1;
  visibility: visible;
}

.music-picker {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #100c08;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 10000;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.music-picker.active {
  transform: translateY(0);
}

.music-picker-title {
  font-size: 32rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 30rpx;
  font-weight: 600;
}

.music-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.music-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.music-item.active {
  background: rgba(28, 20, 16, 0.2);
  border-color: rgba(28, 20, 16, 0.25);
}

.music-name {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
}

.music-epname {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 16rpx;
}

.music-check {
  margin-left: auto;
  color: #1c1410;
  font-size: 32rpx;
}

.music-picker-close {
  margin-top: 30rpx;
  text-align: center;
  padding: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
}

.guide-choice-wrap {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 60rpx 60rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.8) 30%);
  opacity: 0;
  visibility: hidden;
  transform: translateY(20rpx);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 35;
}

.guide-choice-wrap.active {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.guide-choice-btns {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.guide-choice-btn {
  padding: 24rpx 80rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  transition: all 0.3s ease;
}

.guide-choice-skip {
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.8);
}

.guide-choice-skip:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.guide-choice-start {
  background: linear-gradient(135deg, #c49a3c 0%, #f5d76e 100%);
  color: #1c1410;
  font-weight: 600;
  box-shadow: 0 6rpx 24rpx rgba(212, 175, 55, 0.5);
}

.guide-choice-start:active {
  transform: scale(0.95);
  box-shadow: 0 3rpx 12rpx rgba(212, 175, 55, 0.4);
}
