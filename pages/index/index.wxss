}

.memory-box-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  background: linear-gradient(135deg, #0a1628 0%, #0f1e35 50%, #0a1220 100%);
  opacity: 0;
  visibility: hidden;
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.memory-box-container.active {
  opacity: 1;
  visibility: visible;
}

.memory-box-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(ellipse at 20% 30%, rgba(0, 255, 136, 0.1) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 70%, rgba(0, 200, 255, 0.1) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 50%, rgba(28, 20, 16, 0.05) 0%, transparent 60%);
  pointer-events: none;
}

.blueprint-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.25;
  filter: blur(2px);
}

.playback-canvas {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  height: 75%;
}

.flow-cursor {
  position: absolute;
  width: 80px;
  height: 80px;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 100;
}

.flow-cursor.active {
  opacity: 1;
  animation: cursorPulse 0.6s ease-in-out infinite;
}

.cursor-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 255, 255, 0.9) 0%, rgba(0, 220, 255, 0.6) 15%, rgba(0, 150, 255, 0.3) 40%, transparent 70%);
  animation: glowPulse 1s ease-in-out infinite, glowRotate 3s linear infinite;
  box-shadow: 0 0 30px rgba(0, 255, 255, 0.6), 0 0 60px rgba(0, 200, 255, 0.4), 0 0 100px rgba(0, 150, 255, 0.2);
}

.cursor-core {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #ffffff 0%, #88ffff 40%, #00ffff 70%, #0088ff 100%);
  box-shadow: 0 0 20px #00ffff, 0 0 40px #00ffff, 0 0 60px rgba(0, 255, 255, 0.7), 0 0 100px rgba(0, 200, 255, 0.4);
  animation: corePulse 0.6s ease-in-out infinite;
}

.cursor-inner {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 0 15px #ffffff, 0 0 30px #00ffff, 0 0 50px rgba(0, 255, 255, 0.8);
}

.cursor-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 50px;
  height: 50px;
  border: 2px solid rgba(0, 255, 255, 0.6);
  border-radius: 50%;
  animation: ringExpand 1.5s ease-out infinite;
}

.cursor-particles {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 80px;
  height: 80px;
  transform: translate(-50%, -50%);
}

.cursor-particles::before,
.cursor-particles::after {
  content: '';
  position: absolute;
  width: 4px;
  height: 4px;
  background: #00ffff;
  border-radius: 50%;
  box-shadow: 0 0 10px #00ffff, 0 0 20px #00ffff;
  animation: particleOrbit 2s linear infinite;
}

.cursor-particles::after {
  animation-delay: -1s;
  width: 3px;
  height: 3px;
}

@keyframes cursorPulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    transform: translate(-50%, -50%) scale(1.1);
  }
}

@keyframes glowPulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.2);
    opacity: 0.7;
  }
}

@keyframes glowRotate {
  0% {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  100% {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

@keyframes corePulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    box-shadow: 0 0 20px #00ffff, 0 0 40px #00ffff, 0 0 60px rgba(0, 255, 255, 0.7);
  }
  50% {
    transform: translate(-50%, -50%) scale(1.15);
    box-shadow: 0 0 30px #00ffff, 0 0 50px #00ffff, 0 0 80px rgba(0, 255, 255, 0.9);
  }
}

@keyframes ringExpand {
  0% {
    transform: translate(-50%, -50%) scale(0.5);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(1.5);
    opacity: 0;
  }
}

@keyframes particleOrbit {
  0% {
    transform: rotate(0deg) translateX(30px) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: rotate(360deg) translateX(30px) rotate(-360deg);
    opacity: 0.5;
  }
}

