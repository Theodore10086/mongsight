/* --- 胶囊式悬浮窗样式 --- */
.tips-movable-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 20;
  pointer-events: none; /* 让点击事件穿透到画布 */
}

.guide-capsule {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: rgba(0, 0, 0, 0.6); /* 半透明黑底 */
  border-radius: 30rpx; /* 胶囊形状 */
  min-width: 60rpx; /* 防止收起时太小 */
  max-width: 60%; /* 防止文字太长挡屏 */
  transition: width 0.3s ease, background 0.3s ease;
  pointer-events: auto; /* 只有提示框本身可交互 */
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

