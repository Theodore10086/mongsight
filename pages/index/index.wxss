.coordinate-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 120rpx 0 calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(15px);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  z-index: 1000;
  overflow-y: auto;
}

.coordinate-content {
  width: 88%;
  max-width: 680rpx;
  max-height: none;
  background: linear-gradient(135deg, #0a1628 0%, #1a2744 50%, #0d1b2a 100%);
  border-radius: 24rpx;
  box-shadow: 
    0 30rpx 120rpx rgba(0, 0, 0, 0.5),
    0 0 0 2rpx rgba(212, 175, 55, 0.4),
    inset 0 0 60rpx rgba(212, 175, 55, 0.05);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: modalIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.coordinate-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: 
    radial-gradient(ellipse at 30% 20%, rgba(212, 175, 55, 0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 70% 80%, rgba(66, 102, 204, 0.08) 0%, transparent 50%);
