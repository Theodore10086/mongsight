  flex-direction: column;
  box-shadow: 0 12rpx 48rpx rgba(28, 20, 16, 0.12);
  border-radius: 32rpx;
  overflow: hidden;
  transform: translateX(-120%);
}

.left-sidebar.active {
  transform: translateX(0);
}

.left-sidebar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
