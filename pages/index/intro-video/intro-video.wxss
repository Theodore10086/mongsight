.video-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9997;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s ease;
  background: #000000;
}

.video-container.active {
  opacity: 1;
  pointer-events: auto;
}

.intro-video {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* 备选方案样式 */
.fallback-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fallback-image {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.fallback-overlay {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 60rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 24rpx;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.fallback-title {
  font-size: 64rpx;
  font-weight: 800;
  color: #d4af37;
  text-shadow: 0 0 20rpx rgba(212, 175, 55, 0.5);
  margin-bottom: 20rpx;
  letter-spacing: 8rpx;
}

.fallback-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 40rpx;
  letter-spacing: 4rpx;
}

.fallback-progress {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.progress-bar {
  width: 300rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #d4af37, #f5e6c8);
  border-radius: 4rpx;
  transition: width 1s linear;
}

.progress-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.skip-button {
  position: absolute;
  top: 120rpx;
  right: 40rpx;
  z-index: 10;
  padding: 16rpx 32rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.skip-button:active {
  background: rgba(0, 0, 0, 0.8);
  transform: scale(0.95);
}

.skip-text {
  font-size: 24rpx;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.mute-toggle {
  position: absolute;
  bottom: 200rpx;
  right: 40rpx;
  z-index: 10;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.mute-icon {
  font-size: 36rpx;
}
