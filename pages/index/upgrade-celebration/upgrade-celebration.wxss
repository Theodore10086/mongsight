.celebration-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.5s ease, visibility 0.5s ease;
}

.celebration-overlay.active {
  opacity: 1;
  visibility: visible;
}

.celebration-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10rpx);
}

.celebration-content {
  position: relative;
  z-index: 1;
  transform: scale(0.8);
  opacity: 0;
  transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.celebration-content.animation-enter {
  transform: scale(1);
  opacity: 1;
}

.particle-container {
  position: absolute;
  top: -100rpx;
  left: -100rpx;
  right: -100rpx;
  bottom: -100rpx;
  overflow: hidden;
  pointer-events: none;
}

.particle {
  position: absolute;
  border-radius: 50%;
  animation: particleFall 3s ease-out forwards;
}

.particle-gold {
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, #d4af37, #f5d76e);
  box-shadow: 0 0 10rpx rgba(212, 175, 55, 0.8);
}

.particle-silver {
  width: 10rpx;
  height: 10rpx;
  background: linear-gradient(135deg, #c0c0c0, #e8e8e8);
  box-shadow: 0 0 8rpx rgba(192, 192, 192, 0.6);
}

.particle-iron {
  width: 14rpx;
  height: 14rpx;
  background: linear-gradient(135deg, #4a4a4a, #6a6a6a);
  box-shadow: 0 0 12rpx rgba(100, 100, 100, 0.5);
}

@keyframes particleFall {
  0% {
    transform: translateY(-50rpx) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translateY(400rpx) rotate(720deg);
    opacity: 0;
  }
}

.upgrade-card {
  position: relative;
  width: 600rpx;
  background: linear-gradient(145deg, #2a2a2a, #1a1a1a);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}

.card-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.15) 0%, transparent 60%);
  animation: glowRotate 4s linear infinite;
}

@keyframes glowRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.card-content {
  position: relative;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.material-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  animation: iconBounce 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes iconBounce {
  0% { transform: scale(0); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.material-icon.bronze {
  background: linear-gradient(145deg, #cd7f32, #8b4513);
  box-shadow: 0 8rpx 30rpx rgba(205, 127, 50, 0.5);
}

.material-icon.silver {
  background: linear-gradient(145deg, #c0c0c0, #808080);
  box-shadow: 0 8rpx 30rpx rgba(192, 192, 192, 0.5);
}

.material-icon.gold {
  background: linear-gradient(145deg, #d4af37, #8b6914);
  box-shadow: 0 8rpx 30rpx rgba(212, 175, 55, 0.5);
}

.material-icon.iron {
  background: linear-gradient(145deg, #4a4a4a, #1a1a1a);
  box-shadow: 0 8rpx 30rpx rgba(100, 100, 100, 0.5);
}

.icon-emoji {
  font-size: 80rpx;
}

.upgrade-info {
  text-align: center;
  margin-bottom: 40rpx;
}

.upgrade-title {
  display: block;
  font-size: 40rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.upgrade-subtitle {
  display: block;
  font-size: 28rpx;
  color: #d4af37;
  letter-spacing: 2rpx;
}

.character-section {
  display: flex;
  align-items: flex-start;
  width: 100%;
  margin-bottom: 40rpx;
}

.character-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid #d4af37;
  flex-shrink: 0;
  margin-right: 20rpx;
  animation: avatarSlideIn 0.6s ease-out;
}

@keyframes avatarSlideIn {
  from {
    transform: translateX(-50rpx);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.character-dialog {
  flex: 1;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 20rpx;
  animation: dialogFadeIn 0.6s ease-out 0.2s forwards;
  opacity: 0;
}

@keyframes dialogFadeIn {
  to { opacity: 1; }
}

.dialog-text {
  font-size: 26rpx;
  color: #e8e8e8;
  line-height: 1.6;
}

.action-buttons {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.primary {
  background: linear-gradient(145deg, #d4af37, #c9a227);
  box-shadow: 0 4rpx 20rpx rgba(212, 175, 55, 0.4);
}

.action-btn.primary text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.action-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.action-btn.secondary text {
  font-size: 26rpx;
  color: #e8e8e8;
}
