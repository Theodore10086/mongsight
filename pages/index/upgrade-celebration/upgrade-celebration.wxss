.celebration-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.5s ease, visibility 0.5s ease;
}

.celebration-overlay.active {
  opacity: 1;
  visibility: visible;
}

.celebration-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 7, 4, 0.82);
  backdrop-filter: blur(8rpx);
}

.celebration-content {
  position: relative;
  z-index: 1;
  transform: scale(0.8);
  opacity: 0;
  transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.celebration-content.animation-enter {
  transform: scale(1);
  opacity: 1;
}

/* ── Particles ─────────────────────────────────────────────── */

.particle-container {
  position: absolute;
  top: -100rpx;
  left: -100rpx;
  right: -100rpx;
  bottom: -100rpx;
  overflow: hidden;
  pointer-events: none;
}

.particle {
  position: absolute;
  border-radius: 50%;
  animation: particleFall 3s ease-out forwards;
}

.particle-gold {
  width: 10rpx;
  height: 10rpx;
  background: #c49a3c;
}

.particle-silver {
  width: 8rpx;
  height: 8rpx;
  background: #a0a0a0;
}

.particle-iron {
  width: 10rpx;
  height: 10rpx;
  background: #5a5a5a;
}

@keyframes particleFall {
  0% {
    transform: translateY(-50rpx) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translateY(400rpx) rotate(720deg);
    opacity: 0;
  }
}

/* ── Upgrade Card ──────────────────────────────────────────── */

.upgrade-card {
  position: relative;
  width: 600rpx;
  background: #1c1410;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(196, 154, 60, 0.3);
}

/* Thin gold accent line at top — only decorative element */
.card-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: #c49a3c;
}

.card-content {
  position: relative;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ── Material Icons ────────────────────────────────────────── */

.material-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  animation: iconBounce 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes iconBounce {
  0% { transform: scale(0); }
  50% { transform: scale(1.15); }
  100% { transform: scale(1); }
}

/* Material tier colors remain distinct — they represent different achievement levels */
.material-icon.bronze { background: #8b4513; }
.material-icon.silver { background: #808080; }
.material-icon.gold   { background: #8b6914; }
.material-icon.iron   { background: #2a2a2a; }

.icon-emoji {
  font-size: 80rpx;
}

/* ── Upgrade Info ──────────────────────────────────────────── */

.upgrade-info {
  text-align: center;
  margin-bottom: 40rpx;
}

.upgrade-title {
  display: block;
  font-size: 40rpx;
  color: #f5f0e8;
  font-weight: 700;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.upgrade-subtitle {
  display: block;
  font-size: 28rpx;
  color: #c49a3c;
  letter-spacing: 2rpx;
}

/* ── Character Section ─────────────────────────────────────── */

.character-section {
  display: flex;
  align-items: flex-start;
  width: 100%;
  margin-bottom: 40rpx;
}

.character-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(196, 154, 60, 0.4);
  flex-shrink: 0;
  margin-right: 20rpx;
  animation: avatarSlideIn 0.6s ease-out;
}

@keyframes avatarSlideIn {
  from { transform: translateX(-50rpx); opacity: 0; }
  to   { transform: translateX(0);      opacity: 1; }
}

.character-dialog {
  flex: 1;
  background: rgba(245, 240, 232, 0.08);
  border-radius: 12rpx;
  padding: 20rpx;
  animation: dialogFadeIn 0.6s ease-out 0.2s forwards;
  opacity: 0;
}

@keyframes dialogFadeIn {
  to { opacity: 1; }
}

.dialog-text {
  font-size: 26rpx;
  color: rgba(245, 240, 232, 0.8);
  line-height: 1.65;
}

/* ── Action Buttons ────────────────────────────────────────── */

.action-buttons {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s ease;
}

.action-btn:active {
  opacity: 0.65;
}

.action-btn.primary {
  background: #c49a3c;
}

.action-btn.primary text {
  font-size: 28rpx;
  color: #1c1410;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.action-btn.secondary {
  background: transparent;
  border: 1.5rpx solid rgba(245, 240, 232, 0.2);
}

.action-btn.secondary text {
  font-size: 26rpx;
  color: rgba(245, 240, 232, 0.65);
}
