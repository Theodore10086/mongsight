<view class="celebration-overlay {{visible ? 'active' : ''}}" catchtouchmove="preventTouch">
  <view class="celebration-mask"></view>
  
  <view class="celebration-content {{animationClass}}">
    <view class="particle-container">
      <view 
        wx:for="{{particles}}" 
        wx:key="index" 
        class="particle particle-{{item.type}}"
        style="left: {{item.x}}%; top: {{item.y}}%; animation-delay: {{item.delay}}s;"
      ></view>
    </view>

    <view class="upgrade-card">
      <view class="card-glow"></view>
      <view class="card-content">
        <view class="material-icon {{newMaterial}}">
          <text class="icon-emoji">{{materialEmoji}}</text>
        </view>
        
        <view class="upgrade-info">
          <text class="upgrade-title">材质进化</text>
          <text class="upgrade-subtitle">{{fromMaterialName}} → {{toMaterialName}}</text>
        </view>

        <view class="character-section" wx:if="{{showCharacter}}">
          <image 
            class="character-avatar" 
            src="{{characterAvatar}}" 
            mode="aspectFit"
          ></image>
          <view class="character-dialog">
            <text class="dialog-text">{{characterMessage}}</text>
          </view>
        </view>

        <view class="action-buttons">
          <view 
            class="action-btn primary" 
            bindtap="handleConfirm"
          >
            <text>{{confirmText}}</text>
          </view>
          <view 
            class="action-btn secondary" 
            bindtap="handleShare"
            wx:if="{{showShare}}"
          >
            <text>分享成就</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
