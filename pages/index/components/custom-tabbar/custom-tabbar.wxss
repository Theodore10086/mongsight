.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #faf7f2;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(28, 20, 16, 0.1);
  z-index: 1000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  position: relative;
}

.tab-icon {
  font-size: 40rpx;
  transition: transform 0.2s ease;
}

.tab-item.active .tab-icon {
  transform: scale(1.1);
}

.tab-name {
  font-size: 22rpx;
  color: rgba(28, 20, 16, 0.38);
  transition: color 0.2s ease;
}

.tab-item.active .tab-name {
  color: #1c1410;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 8rpx;
  width: 32rpx;
  height: 3rpx;
  background: #1c1410;
  border-radius: 2rpx;
}
