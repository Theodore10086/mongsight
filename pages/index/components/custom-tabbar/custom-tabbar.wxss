/* ── Labels ───────────────────────────────────────────────── */

.tab-name {
  font-size: 20rpx;
  color: rgba(28, 20, 16, 0.38);
  transition: color 0.2s ease;
  letter-spacing: 0.5rpx;
}

.tab-item.active .tab-name {
  color: #c49a3c;
  font-weight: 600;
}

/* ── Active indicator dot ─────────────────────────────────── */

.tab-indicator {
  position: absolute;
  bottom: 6rpx;
  width: 8rpx;
  height: 8rpx;
  background: #c49a3c;
  border-radius: 50%;
}
