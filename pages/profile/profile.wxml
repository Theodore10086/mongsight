<view class="profile-page">

  <!-- 个人信息卡 -->
  <view class="profile-hero">
    <view class="profile-hero-bg"></view>
    <view class="profile-hero-body">
      <view class="profile-avatar-wrap" hover-class="profile-avatar-wrap-hover" hover-stay-time="80" bindtap="onEditAvatar">
        <image
          class="profile-avatar"
          wx:if="{{avatarIsImage}}"
          src="{{userProfile.avatarUrl}}"
          mode="aspectFill"
        ></image>
        <view class="profile-avatar profile-avatar-emoji" wx:else>
          <text>{{userProfile.avatar || '🎨'}}</text>
        </view>
        <view class="profile-avatar-edit-icon">✎</view>
      </view>
      <view class="profile-info">
        <view class="profile-nickname-row" hover-class="profile-nickname-row-hover" hover-stay-time="80" bindtap="onEditNickname">
          <text class="profile-nickname">{{userProfile.nickName || userProfile.nickname || '墨客'}}</text>
          <text class="profile-nickname-edit">✎</text>
        </view>
        <view class="profile-level-row">
          <view class="profile-level-pill">
            <text class="profile-level-text">Lv.{{userProfile.level || 1}}</text>
            <text class="profile-level-title">· {{userProfile.title || '牧羊人'}}</text>
          </view>
          <view class="profile-jade-pill">
            <text class="jade-emoji">💎</text>
            <text class="jade-count">{{userProfile.inkJades || 0}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats-row">
    <view class="stats-cell" hover-class="stats-cell-hover" bindtap="onGoToMyWorks">
      <text class="stats-cell-num">{{myWorksCount}}</text>
      <text class="stats-cell-label">作品</text>
    </view>
    <view class="stats-cell-divider"></view>
    <view class="stats-cell" hover-class="stats-cell-hover" bindtap="onGoToMyPosts">
      <text class="stats-cell-num">{{myPostCount}}</text>
      <text class="stats-cell-label">帖子</text>
    </view>
    <view class="stats-cell-divider"></view>
    <view class="stats-cell" hover-class="stats-cell-hover" bindtap="onGoToMyLikes">
      <text class="stats-cell-num">{{myLikesCount}}</text>
      <text class="stats-cell-label">点赞</text>
    </view>
    <view class="stats-cell-divider"></view>
    <view class="stats-cell" hover-class="stats-cell-hover" bindtap="onGoToFollows">
      <text class="stats-cell-num">{{userProfile.following || 0}}</text>
      <text class="stats-cell-label">关注</text>
    </view>
    <view class="stats-cell-divider"></view>
    <view class="stats-cell" hover-class="stats-cell-hover" bindtap="onGoToFollowers">
      <text class="stats-cell-num">{{userProfile.followers || 0}}</text>
      <text class="stats-cell-label">粉丝</text>
    </view>
  </view>

  <!-- 签到卡 -->
  <view class="checkin-card" hover-class="checkin-card-hover" hover-stay-time="80" bindtap="onDailyCheckin">
    <view class="checkin-left">
      <view class="checkin-icon">
        <text class="checkin-icon-emoji">📅</text>
      </view>
      <view class="checkin-text">
        <text class="checkin-title">每日签到</text>
        <text class="checkin-desc">连续 {{userProfile.streak || 0}} 天 · 今日签到 +5 墨玉</text>
      </view>
    </view>
    <view class="checkin-btn {{hasCheckedIn ? 'checkin-btn-done' : ''}}">
      <text>{{hasCheckedIn ? '已签到' : '签到'}}</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="zm-section-title">
    <text class="zm-section-title-text">我的</text>
  </view>

  <view class="menu-card">
    <view class="menu-item" hover-class="menu-item-hover" bindtap="onGoToMyWorks">
      <view class="menu-icon menu-icon-accent"><text>🖼️</text></view>
      <text class="menu-text">我的作品</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" hover-class="menu-item-hover" bindtap="onGoToMyPosts">
      <view class="menu-icon menu-icon-primary"><text>📝</text></view>
      <text class="menu-text">我的帖子</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" hover-class="menu-item-hover" bindtap="onGoToMyLikes">
      <view class="menu-icon menu-icon-pink"><text>❤️</text></view>
      <text class="menu-text">我的点赞</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" hover-class="menu-item-hover" bindtap="onGoToMyCollections">
      <view class="menu-icon menu-icon-warm"><text>⭐</text></view>
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" hover-class="menu-item-hover" bindtap="onGoToAchievements">
      <view class="menu-icon menu-icon-purple"><text>🏆</text></view>
      <text class="menu-text">成就中心</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" hover-class="menu-item-hover" bindtap="onGoToSettings">
      <view class="menu-icon menu-icon-secondary"><text>⚙️</text></view>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- ─────────── 编辑头像弹窗（始终渲染以保证动画） ─────────── -->
  <view class="modal-mask {{showEditAvatar ? 'modal-mask-active' : ''}}" bindtap="onCloseEditAvatar"></view>
  <view class="bottom-sheet {{showEditAvatar ? 'bottom-sheet-active' : ''}}" catchtap="">
    <view class="sheet-header">
      <text class="sheet-title">更换头像</text>
      <view class="sheet-close" bindtap="onCloseEditAvatar">✕</view>
    </view>
    <scroll-view scroll-y class="avatar-sheet-body" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="avatar-grid">
        <view
          class="avatar-option {{selectedAvatar === item ? 'avatar-option-active' : ''}}"
          wx:for="{{avatarOptions}}"
          wx:key="*this"
          data-avatar="{{item}}"
          bindtap="onSelectAvatar"
        >
          <text class="avatar-option-emoji">{{item}}</text>
        </view>
      </view>
      <view
        class="upload-avatar-btn"
        hover-class="upload-avatar-btn-hover"
        bindtap="onUploadAvatar"
      >
        <text class="upload-avatar-emoji">📷</text>
        <text class="upload-avatar-text">从相册上传</text>
      </view>
      <view class="upload-avatar-preview" wx:if="{{selectedAvatarIsImage}}">
        <text class="upload-avatar-preview-label">预览：</text>
        <image class="upload-avatar-preview-img" src="{{selectedAvatar}}" mode="aspectFill"></image>
      </view>
    </scroll-view>
    <view class="sheet-footer">
      <button class="zm-btn-primary" bindtap="onConfirmAvatar">确定</button>
    </view>
  </view>

  <!-- ─────────── 编辑昵称弹窗 ─────────── -->
  <view class="modal-mask {{showEditNickname ? 'modal-mask-active' : ''}}" bindtap="onCloseEditNickname"></view>
  <view class="bottom-sheet {{showEditNickname ? 'bottom-sheet-active' : ''}}" catchtap="">
    <view class="sheet-header">
      <text class="sheet-title">修改昵称</text>
      <view class="sheet-close" bindtap="onCloseEditNickname">✕</view>
    </view>
    <view class="sheet-form">
      <input
        class="sheet-form-input"
        type="text"
        placeholder="请输入新昵称"
        value="{{tempNickname}}"
        bindinput="onNicknameInput"
        cursor-spacing="20"
        maxlength="12"
      />
    </view>
    <view class="sheet-footer">
      <button class="zm-btn-primary" bindtap="onConfirmNickname">确定</button>
    </view>
  </view>

  <!-- ─────────── 设置弹窗 ─────────── -->
  <view class="modal-mask {{showSettingsModal ? 'modal-mask-active' : ''}}" bindtap="onCloseSettingsModal"></view>
  <view class="bottom-sheet {{showSettingsModal ? 'bottom-sheet-active' : ''}}" catchtap="">
    <view class="sheet-header">
      <text class="sheet-title">设置</text>
      <view class="sheet-close" bindtap="onCloseSettingsModal">✕</view>
    </view>
    <view class="settings-list">
      <view class="settings-row">
        <text class="settings-label">版本</text>
        <text class="settings-value">5.0.1</text>
      </view>
      <view class="settings-row">
        <text class="settings-label">关于我们</text>
        <text class="settings-value">蒙格书法研究中心</text>
      </view>
      <view class="settings-row">
        <text class="settings-label">联系反馈</text>
        <text class="settings-value">3101342481@qq.com</text>
      </view>
      <view class="settings-row">
        <text class="settings-label">版权声明</text>
        <text class="settings-value">原创仅限学习交流</text>
      </view>
    </view>
    <view class="sheet-footer">
      <button class="zm-btn-ghost" bindtap="onCloseSettingsModal">关闭</button>
    </view>
  </view>

</view>
