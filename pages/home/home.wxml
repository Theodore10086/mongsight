<view class="home-page">

  <!-- ─────────── Greeting ─────────── -->
  <view class="home-greeting">
    <text class="home-greeting-date">{{todayLabel}}</text>
    <text class="home-greeting-title">{{greeting}}，{{nickname}}</text>
    <text class="home-greeting-sub">今天也来穿梭蒙古文字之间</text>
  </view>

  <!-- ─────────── Gold divider ─────────── -->
  <view class="home-divider">
    <view class="home-rhombus"></view>
    <view class="home-divider-line"></view>
    <view class="home-rhombus"></view>
  </view>

  <!-- ─────────── Feature card · 拍照识别 ─────────── -->
  <view class="home-feature" hover-class="home-feature-hover" hover-stay-time="60" bindtap="onGoToRecognition">
    <image class="home-feature-img" src="/assets/images/ui/home-recognition-card-bg.png" mode="aspectFill"></image>
    <view class="home-feature-veil"></view>
    <view class="home-feature-body">
      <view class="home-feature-top">
        <view class="home-feature-badge">
          <view class="zm-icon zm-icon-camera zm-icon-gold-dark home-feature-badge-glyph"></view>
        </view>
        <text class="home-feature-eyebrow">主线 · 识读起点</text>
      </view>
      <text class="home-feature-title">拍照识别</text>
      <text class="home-feature-desc">打开相机识读蒙古文，开启完整学习闭环</text>
      <text class="home-feature-flow">{{flowLine}}</text>
      <view class="home-feature-action">
        <text class="home-feature-action-text">开始穿梭</text>
        <text class="home-feature-action-arrow">→</text>
      </view>
    </view>
  </view>

  <!-- ─────────── Stats (divided) ─────────── -->
  <view class="home-stats">
    <view class="home-stat">
      <text class="home-stat-num">{{recognitionTotal}}</text>
      <text class="home-stat-label">词条</text>
    </view>
    <view class="home-stat-divider"></view>
    <view class="home-stat" hover-class="home-stat-hover" hover-stay-time="60" bindtap="onGoToReview">
      <text class="home-stat-num">{{todayReviewWords}}</text>
      <text class="home-stat-label">待复习</text>
    </view>
    <view class="home-stat-divider"></view>
    <view class="home-stat">
      <text class="home-stat-num">{{totalXp}}</text>
      <text class="home-stat-label">经验</text>
    </view>
    <view class="home-stat-divider"></view>
    <view class="home-stat" hover-class="home-stat-hover" hover-stay-time="60" bindtap="onGoToChallenge">
      <text class="home-stat-num">{{streakDays}}</text>
      <text class="home-stat-label">连击</text>
    </view>
  </view>

  <!-- ─────────── Section divider · 探索 ─────────── -->
  <view class="home-divider">
    <view class="home-rhombus"></view>
    <view class="home-divider-line"></view>
    <text class="home-divider-label">探索</text>
    <view class="home-divider-line"></view>
    <view class="home-rhombus"></view>
  </view>

  <!-- ─────────── Quick grid ─────────── -->
  <view class="home-quick-grid">
    <view
      class="home-quick-card"
      wx:for="{{quickActions}}"
      wx:key="key"
      data-key="{{item.key}}"
      hover-class="home-quick-card-hover"
      hover-stay-time="60"
      bindtap="onTapQuickAction"
    >
      <view class="home-quick-icon home-quick-icon-{{item.key}}">
        <view class="zm-icon zm-icon-{{item.icon}} home-quick-glyph"></view>
      </view>
      <view class="home-quick-body">
        <text class="home-quick-title">{{item.title}}</text>
        <text class="home-quick-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

</view>
