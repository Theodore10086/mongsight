page {
  background: var(--bg-page);
  min-height: 100vh;
}

.home-page {
  padding: 36rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* ──────────────────────── GREETING ──────────────────────── */

.home-greeting {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 12rpx 4rpx 0;
}

.home-greeting-date {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand-accent-dark);
  letter-spacing: 4rpx;
}

.home-greeting-title {
  font-size: 50rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 1rpx;
  line-height: 1.18;
}

.home-greeting-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

/* ──────────────────────── GOLD DIVIDER ──────────────────────── */

.home-divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 6rpx;
}

.home-divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(196, 154, 60, 0.5), transparent);
}

.home-divider-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand-accent-dark);
  letter-spacing: 6rpx;
  text-indent: 6rpx;
}

.home-rhombus {
  width: 12rpx;
  height: 12rpx;
  background: var(--brand-accent);
  transform: rotate(45deg);
  flex-shrink: 0;
  box-shadow: 0 0 10rpx rgba(196, 154, 60, 0.4);
}

/* ──────────────────────── FEATURE CARD ──────────────────────── */

.home-feature {
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: 0 14rpx 36rpx rgba(31, 20, 16, 0.14);
  border: 1rpx solid rgba(196, 154, 60, 0.3);
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.home-feature-hover {
  transform: translateY(3rpx);
  box-shadow: 0 8rpx 20rpx rgba(31, 20, 16, 0.12);
}

.home-feature-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.home-feature-veil {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255, 249, 239, 0.64) 0%, rgba(246, 230, 184, 0.32) 58%, rgba(244, 234, 214, 0.52) 100%);
  z-index: 1;
  pointer-events: none;
}

.home-feature-body {
  position: relative;
  z-index: 2;
  padding: 36rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.home-feature-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.home-feature-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(196, 154, 60, 0.25);
  border: 1rpx solid rgba(196, 154, 60, 0.32);
}

.home-feature-badge-glyph {
  width: 36rpx;
  height: 36rpx;
}

.home-feature-eyebrow {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--brand-accent-dark);
  letter-spacing: 4rpx;
}

.home-feature-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #4a2e00;
  letter-spacing: 2rpx;
  line-height: 1.12;
}

.home-feature-desc {
  font-size: 26rpx;
  color: rgba(74, 46, 0, 0.82);
  line-height: 1.5;
}

.home-feature-flow {
  font-size: 22rpx;
  color: rgba(74, 46, 0, 0.58);
  letter-spacing: 1rpx;
}

.home-feature-action {
  margin-top: 12rpx;
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 34rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-accent-dark);
  box-shadow: 0 6rpx 0 #7d5e1a;
}

.home-feature-action-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.home-feature-action-arrow {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

/* ──────────────────────── STATS (divided) ──────────────────────── */

.home-stats {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 26rpx 8rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
}

.home-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 0;
  border-radius: var(--radius-sm);
}

.home-stat-hover {
  background: var(--bg-soft);
}

.home-stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1;
}

.home-stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
}

.home-stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--border-soft);
  flex-shrink: 0;
}

/* ──────────────────────── QUICK GRID ──────────────────────── */

.home-quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.home-quick-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 20rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: transform 0.14s ease, box-shadow 0.14s ease;
}

.home-quick-card-hover {
  transform: scale(0.97);
  box-shadow: var(--shadow-card-hover);
}

.home-quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.home-quick-icon-writing { background: #fef0d7; }
.home-quick-icon-review { background: #e8f1dc; }
.home-quick-icon-class { background: #fce9d6; }
.home-quick-icon-stats { background: #e6eef5; }
.home-quick-icon-ai { background: #f2e0fa; }
.home-quick-icon-challenge { background: #fde4d0; }

.home-quick-glyph {
  width: 36rpx;
  height: 36rpx;
}

.home-quick-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.home-quick-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.home-quick-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.4;
}
