page {
  background: var(--bg-page);
  min-height: 100vh;
}

.home-page {
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* ──────────────────────── GOAL CARD ──────────────────────── */

.goal-card {
  background: linear-gradient(135deg, #ffffff 0%, #fff7e1 100%);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
  position: relative;
  overflow: hidden;
}

.goal-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.goal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.goal-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.45;
}

.goal-bar {
  margin-top: 6rpx;
  width: 100%;
  height: 16rpx;
  background: rgba(31, 20, 16, 0.08);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.goal-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--brand-warm) 0%, #ffc02e 100%);
  border-radius: var(--radius-pill);
  box-shadow: inset 0 -4rpx 0 rgba(0, 0, 0, 0.1);
  transition: width 0.5s ease;
}

.goal-bar-meta {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.goal-bar-current {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--brand-warm-dark);
}

.goal-bar-target {
  font-size: 22rpx;
  color: var(--text-muted);
}

.goal-medal {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goal-medal-hover { transform: scale(0.95); }

.goal-medal-ring {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd57e 0%, #ffa826 100%);
  box-shadow: 0 4rpx 0 var(--brand-warm-dark);
}

.goal-medal-percent {
  position: relative;
  z-index: 1;
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}

/* ──────────────────────── PATH CARD（学习卡片） ──────────────────────── */

.path-card {
  position: relative;
  border-radius: var(--radius-xl);
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  overflow: hidden;
  color: var(--text-inverse);
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.12);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.path-card-hover {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
}

.path-card-primary {
  background: linear-gradient(135deg, #6dd820 0%, #47a302 100%);
}

.path-card-secondary {
  background: linear-gradient(135deg, #46c1ff 0%, #1899d6 100%);
}

.path-card-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.path-card-blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  filter: blur(2rpx);
}

.path-blob-a {
  width: 220rpx;
  height: 220rpx;
  top: -60rpx;
  right: -40rpx;
}

.path-blob-b {
  width: 140rpx;
  height: 140rpx;
  bottom: -40rpx;
  left: 30%;
  background: rgba(255, 255, 255, 0.1);
}

.path-card-body {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  z-index: 1;
  min-width: 0;
}

.path-card-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 -4rpx 0 rgba(0, 0, 0, 0.12);
}

.path-card-icon-text {
  font-size: 50rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}

.path-card-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.path-card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.path-card-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}

.path-card-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.5;
}

.path-card-stats {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 10rpx;
}

.path-card-stat {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.stat-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.path-card-divider {
  width: 2rpx;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.4);
}

.path-card-cta {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 22rpx;
  background: rgba(255, 255, 255, 0.95);
  color: var(--brand-primary-dark);
  border-radius: var(--radius-pill);
  font-weight: 800;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
}

.path-card-cta.cta-blue {
  color: var(--brand-secondary-dark);
}

.cta-text {
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.cta-arrow {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

/* ──────────────────────── QUICK GRID ──────────────────────── */

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.quick-tile {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 22rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.quick-tile-hover {
  transform: scale(0.97);
  box-shadow: var(--shadow-card-hover);
}

.quick-tile-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.quick-tile-icon-purple {
  background: linear-gradient(135deg, #efd9ff 0%, #ce82ff 100%);
  box-shadow: 0 4rpx 0 #a14bd8;
}

.quick-tile-icon-warm {
  background: linear-gradient(135deg, #ffd9b1 0%, #ff9600 100%);
  box-shadow: 0 4rpx 0 #c97200;
}

.quick-tile-icon-accent {
  background: linear-gradient(135deg, #f6e6b8 0%, #c49a3c 100%);
  box-shadow: 0 4rpx 0 var(--brand-accent-dark);
}

.quick-tile-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.quick-tile-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
}

.quick-tile-desc {
  font-size: 20rpx;
  color: var(--text-muted);
  text-align: center;
}

/* ──────────────────────── STATS CARD ──────────────────────── */

.stats-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 16rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-cell-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.stat-cell-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.1;
}

.stat-cell-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.stat-cell-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--border-soft);
}

/* ──────────────────────── TIP CARD ──────────────────────── */

.tip-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, #fff8de 0%, #ffe6b8 100%);
  border-radius: var(--radius-lg);
  border: 1rpx dashed rgba(196, 154, 60, 0.6);
}

.tip-card-mascot {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 0 var(--brand-accent-dark);
}

.tip-card-mascot-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.tip-card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.tip-card-title {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--brand-accent-dark);
  letter-spacing: 1rpx;
}

.tip-card-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}
