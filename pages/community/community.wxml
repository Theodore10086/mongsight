<view class="community-page">

  <!-- 顶部 Hero -->
  <view class="comm-hero">
    <view class="comm-hero-text">
      <text class="comm-hero-title">学习社区</text>
      <text class="comm-hero-subtitle">和同学一起交流学习心得</text>
    </view>
    <view class="comm-hero-cta" hover-class="comm-hero-cta-hover" hover-stay-time="80" bindtap="onOpenPostModal">
      <view class="zm-icon zm-icon-plus zm-icon-white comm-hero-cta-glyph"></view>
      <text class="comm-hero-cta-text">发帖</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="comm-search">
    <view class="comm-search-bar">
      <view class="zm-icon zm-icon-search zm-icon-muted comm-search-icon"></view>
      <input
        class="comm-search-input"
        placeholder="搜索帖子和用户…"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearchConfirm"
      />
      <view class="comm-search-clear" wx:if="{{searchKeyword}}" catchtap="onClearSearch">
        <text>✕</text>
      </view>
    </view>
  </view>

  <!-- 搜索结果面板 -->
  <view class="comm-search-panel" wx:if="{{searchKeyword}}">
    <view class="comm-search-tabs">
      <text class="comm-search-tab {{searchTab === 'posts' ? 'active' : ''}}" bindtap="onSwitchSearchTab" data-tab="posts">帖子</text>
      <text class="comm-search-tab {{searchTab === 'users' ? 'active' : ''}}" bindtap="onSwitchSearchTab" data-tab="users">用户</text>
    </view>

    <view class="zm-empty" wx:if="{{searchTab === 'posts' && !searchPosts.length && !searching}}">
      <text>未找到相关帖子</text>
    </view>
    <view class="zm-empty" wx:if="{{searchTab === 'users' && !searchUsers.length && !searching}}">
      <text>未找到相关用户</text>
    </view>

    <view class="comm-search-results" wx:if="{{searchTab === 'posts' && searchPosts.length}}">
      <view class="post-card" wx:for="{{searchPosts}}" wx:key="id" data-id="{{item.id}}" bindtap="onGoToPostDetail">
        <view class="post-user">
          <block wx:if="{{item.avatarIsImage}}">
            <image class="post-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          </block>
          <block wx:elif="{{item.avatarText || item.avatar}}">
            <text class="post-avatar post-avatar-emoji"><text>{{item.avatarText || item.avatar}}</text></text>
          </block>
          <block wx:else>
            <view class="post-avatar post-avatar-default">
              <view class="zm-icon zm-icon-user zm-icon-gold-dark post-avatar-glyph"></view>
            </view>
          </block>
          <view class="post-user-info">
            <text class="post-nickname">{{item.nickname || '游客'}}</text>
            <text class="post-time" wx:if="{{item.create_time_str}}">{{item.create_time_str}}</text>
          </view>
        </view>
        <text class="post-content" wx:if="{{item.content}}">{{item.content}}</text>
      </view>
    </view>

    <view class="comm-search-results" wx:if="{{searchTab === 'users' && searchUsers.length}}">
      <view class="search-user-card" wx:for="{{searchUsers}}" wx:key="openId" data-openid="{{item.openId}}" bindtap="onGoToUserHome">
        <block wx:if="{{item.avatarIsImage}}">
          <image class="search-user-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        </block>
        <block wx:elif="{{item.avatarText}}">
          <text class="search-user-avatar-emoji">{{item.avatarText}}</text>
        </block>
        <block wx:else>
          <view class="search-user-avatar-default">
            <view class="zm-icon zm-icon-user zm-icon-muted" style="width:36rpx;height:36rpx;"></view>
          </view>
        </block>
        <view class="search-user-info">
          <text class="search-user-name">{{item.nickName}}</text>
          <text class="search-user-level" wx:if="{{item.level}}">Lv.{{item.level}} · {{item.title || ''}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Feed 主体 -->
  <view class="comm-feed" wx:if="{{!searchKeyword}}">

    <!-- 空状态 -->
    <view class="zm-empty" wx:if="{{!isLoadingPosts && communityPosts.length === 0}}">
      <view class="zm-icon zm-icon-inbox zm-icon-muted zm-empty-icon"></view>
      <text class="zm-empty-text">还没有帖子，快来分享第一条吧~</text>
    </view>

    <!-- 帖子卡片 -->
    <view
      class="post-card"
      wx:for="{{communityPosts}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onGoToPostDetail"
    >
      <!-- 用户头部 -->
      <view class="post-user">
        <image
          class="post-avatar"
          wx:if="{{item.avatarIsImage}}"
          src="{{item.avatarUrl}}"
          mode="aspectFill"
        ></image>
        <view class="post-avatar post-avatar-emoji" wx:elif="{{item.avatarText || item.avatar}}">
          <text>{{item.avatarText || item.avatar}}</text>
        </view>
        <view class="post-avatar post-avatar-default" wx:else>
          <view class="zm-icon zm-icon-user zm-icon-gold-dark post-avatar-glyph"></view>
        </view>
        <view class="post-user-info">
          <text class="post-nickname">{{item.nickname || '游客'}}</text>
          <text class="post-time" wx:if="{{item.create_time_str}}">{{item.create_time_str}}</text>
        </view>
      </view>

      <!-- 内容 -->
      <text class="post-content" wx:if="{{item.content}}">{{item.content}}</text>

      <!-- 图片 -->
      <view class="post-images" wx:if="{{item.images && item.images.length}}">
        <image
          class="post-image post-image-{{item.images.length}}"
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:key="*this"
          src="{{img}}"
          mode="aspectFill"
          data-src="{{img}}"
          data-list="{{item.images}}"
          catchtap="onPreviewImage"
        ></image>
      </view>

      <!-- 操作栏 -->
      <view class="post-actions">
        <view
          class="post-action {{item.liked ? 'post-action-liked' : ''}}"
          data-id="{{item.id}}"
          catchtap="onLikePost"
        >
          <view class="zm-icon {{item.liked ? 'zm-icon-heart-fill zm-icon-pink' : 'zm-icon-heart zm-icon-secondary-text'}} post-action-glyph"></view>
          <text class="post-action-count">{{item.likes || 0}}</text>
        </view>
        <view class="post-action" data-id="{{item.id}}" catchtap="onGoToPostDetail">
          <view class="zm-icon zm-icon-comment zm-icon-secondary-text post-action-glyph"></view>
          <text class="post-action-count">{{item.comments || 0}}</text>
        </view>
        <view
          class="post-action {{item.isFavorited ? 'post-action-favorited' : ''}}"
          data-id="{{item.id}}"
          catchtap="onToggleFavorite"
        >
          <view class="zm-icon {{item.isFavorited ? 'zm-icon-bookmark-fill zm-icon-warm' : 'zm-icon-bookmark zm-icon-secondary-text'}} post-action-glyph"></view>
          <text class="post-action-count">{{item.isFavorited ? '已收藏' : '收藏'}}</text>
        </view>
      </view>

      <!-- 内联评论列表（最多2条） -->
      <view
        class="post-inline-comments"
        wx:if="{{item.commentsList && item.commentsList.length}}"
      >
        <view
          class="inline-comment"
          wx:for="{{item.commentsList}}"
          wx:for-item="cmt"
          wx:key="id"
        >
          <text class="inline-comment-name">{{cmt.nickname}}：</text>
          <text class="inline-comment-text">{{cmt.content}}</text>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="zm-loading" wx:if="{{isLoadingPosts}}">
      <text>加载中…</text>
    </view>
    <view class="zm-loading" wx:if="{{!hasMorePosts && communityPosts.length > 0 && !isLoadingPosts}}">
      <text>—— 已经到底啦 ——</text>
    </view>

  </view>

  <!-- ─────────── 评论弹窗（始终渲染以保证动画） ─────────── -->
  <view class="modal-mask {{showCommentModal ? 'modal-mask-active' : ''}}" bindtap="onCloseCommentModal"></view>
  <view class="bottom-sheet {{showCommentModal ? 'bottom-sheet-active' : ''}}" catchtap="">
    <view class="sheet-header">
      <text class="sheet-title">评论</text>
      <view class="sheet-close" bindtap="onCloseCommentModal">✕</view>
    </view>
    <scroll-view scroll-y class="sheet-comments" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="modal-comment" wx:for="{{currentComments}}" wx:key="id">
        <image
          class="modal-comment-avatar"
          wx:if="{{item.avatarIsImage}}"
          src="{{item.avatarUrl}}"
          mode="aspectFill"
        ></image>
        <view class="modal-comment-avatar modal-comment-avatar-emoji" wx:elif="{{item.avatarText || item.avatar}}">
          <text>{{item.avatarText || item.avatar}}</text>
        </view>
        <view class="modal-comment-avatar modal-comment-avatar-default" wx:else>
          <view class="zm-icon zm-icon-user zm-icon-gold-dark modal-comment-avatar-glyph"></view>
        </view>
        <view class="modal-comment-body">
          <text class="modal-comment-name">{{item.nickname || '游客'}}</text>
          <text class="modal-comment-text">{{item.content}}</text>
        </view>
      </view>
      <view class="zm-empty zm-empty-small" wx:if="{{!currentComments.length}}">
        <text class="zm-empty-text">还没有评论，快来抢沙发~</text>
      </view>
    </scroll-view>
    <view class="sheet-input-bar">
      <input
        class="sheet-input"
        placeholder="说点什么…"
        value="{{commentText}}"
        bindinput="onCommentInput"
        confirm-type="send"
        cursor-spacing="20"
        bindconfirm="onSendComment"
      />
      <button class="zm-btn-primary sheet-send-btn" size="mini" bindtap="onSendComment">发送</button>
    </view>
  </view>

  <!-- ─────────── 发帖弹窗 ─────────── -->
  <view class="modal-mask {{showPostModal ? 'modal-mask-active' : ''}}" bindtap="onClosePostModal"></view>
  <view class="bottom-sheet {{showPostModal ? 'bottom-sheet-active' : ''}}" catchtap="">
    <view class="sheet-header">
      <text class="sheet-title">发布新帖</text>
      <view class="sheet-close" bindtap="onClosePostModal">✕</view>
    </view>
    <scroll-view scroll-y class="post-form" enhanced="{{true}}" show-scrollbar="{{false}}">
      <textarea
        class="post-content-input"
        placeholder="分享你的学习心得…"
        value="{{postContent}}"
        bindinput="onPostContentInput"
        maxlength="500"
        cursor-spacing="20"
        auto-height
      ></textarea>
      <view class="post-images-grid">
        <view
          class="post-image-item"
          wx:for="{{postImages}}"
          wx:key="*this"
        >
          <image class="post-image-thumb" src="{{item}}" mode="aspectFill"></image>
          <view class="post-image-remove" data-index="{{index}}" catchtap="onRemovePostImage">✕</view>
        </view>
        <view
          class="post-image-add"
          hover-class="post-image-add-hover"
          bindtap="onAddPostImage"
          wx:if="{{postImages.length < 9}}"
        >
          <view class="zm-icon zm-icon-plus zm-icon-muted post-image-add-glyph"></view>
          <text class="post-image-add-text">添加图片</text>
        </view>
      </view>
      <text class="post-form-tip">最多9张图片 · {{postContent.length}}/500</text>
    </scroll-view>
    <view class="sheet-footer">
      <button class="zm-btn-primary post-submit-btn" bindtap="onSubmitPost">发布</button>
    </view>
  </view>

</view>
