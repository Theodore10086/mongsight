        placeholder="说点什么…"
        value="{{commentText}}"
        bindinput="onCommentInput"
        confirm-type="send"
        cursor-spacing="20"
        bindconfirm="onSendComment"
      />
      <button class="zm-btn-primary sheet-send-btn" size="mini" bindtap="onSendComment">发送</button>
    </view>
  </view>

  <!-- ─────────── 发帖弹窗 ─────────── -->
