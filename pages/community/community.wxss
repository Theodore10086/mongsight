page {
  background: var(--bg-page);
  min-height: 100vh;
}

.community-page {
  padding: 0 0 calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* ──────────────────────── SEARCH ──────────────────────── */

.comm-search {
  padding: 0 28rpx 16rpx;
  background: var(--bg-page);
}

.comm-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--bg-card);
  border-radius: 36rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--border-soft);
}

.comm-search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.comm-search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  background: transparent;
}

.comm-search-clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--bg-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

.comm-search-panel {
  padding: 0 28rpx 16rpx;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.comm-search-tabs {
  display: flex;
  gap: 16rpx;
}

.comm-search-tab {
  font-size: 28rpx;
  color: var(--text-muted);
  padding: 8rpx 0;
  border-bottom: 4rpx solid transparent;
}

.comm-search-tab.active {
  color: var(--text-primary);
  font-weight: 600;
  border-bottom-color: var(--brand-primary);
}

.comm-search-results {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.search-user-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
}

.search-user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.search-user-avatar-emoji {
  font-size: 56rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  flex-shrink: 0;
}

.search-user-avatar-default {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--bg-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-user-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.search-user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.search-user-level {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ──────────────────────── HERO ──────────────────────── */

.comm-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 28rpx 20rpx;
  background: var(--bg-page);
}

.comm-hero-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.comm-hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.comm-hero-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.comm-hero-cta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 26rpx;
  background: var(--brand-primary);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-press-primary);
  flex-shrink: 0;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.comm-hero-cta-hover {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 var(--brand-primary-dark);
}

.comm-hero-cta-icon {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}

.comm-hero-cta-glyph {
  width: 28rpx;
  height: 28rpx;
}

.comm-hero-cta-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}

/* ──────────────────────── FEED ──────────────────────── */

.comm-feed {
  padding: 0 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ──────────────────────── POST CARD ──────────────────────── */

.post-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 24rpx 20rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.post-user {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--brand-accent-soft);
}

.post-avatar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #f1dfad;
}

.post-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1dfad;
}

.post-avatar-glyph {
  width: 40rpx;
  height: 40rpx;
}

.post-user-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.post-nickname {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.post-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.post-content {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 图片网格 */
.post-images {
  display: grid;
  gap: 8rpx;
  grid-template-columns: repeat(3, 1fr);
}

.post-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
}

.post-image-1 {
  grid-column: span 3;
  aspect-ratio: 16 / 10;
}

.post-image-2 {
  grid-column: span 3;
  aspect-ratio: 16 / 10;
}

/* 操作栏 */
.post-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-soft);
  margin-top: 4rpx;
}

.post-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 4rpx;
  transition: opacity 0.15s ease;
}

.post-action:active { opacity: 0.6; }

.post-action-icon {
  font-size: 32rpx;
  line-height: 1;
}

.post-action-glyph {
  width: 36rpx;
  height: 36rpx;
}

.post-action-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.post-action-liked .post-action-count { color: var(--brand-pink); font-weight: 700; }
.post-action-favorited .post-action-count { color: var(--brand-warm); font-weight: 700; }

/* 内联评论 */
.post-inline-comments {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 14rpx 16rpx;
  background: var(--bg-soft);
  border-radius: var(--radius-sm);
}

.inline-comment {
  font-size: 24rpx;
  line-height: 1.55;
}

.inline-comment-name {
  font-weight: 700;
  color: var(--brand-secondary-dark);
}

.inline-comment-text {
  color: var(--text-primary);
}

/* ──────────────────────── 评论 sheet 内容 ──────────────────────── */

.sheet-comments {
  flex: 1;
  min-height: 200rpx;
  max-height: 60vh;
  padding: 16rpx 28rpx;
  box-sizing: border-box;
}

.modal-comment {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.modal-comment:last-child { border-bottom: none; }

.modal-comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--brand-accent-soft);
}

.modal-comment-avatar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #f1dfad;
}

.modal-comment-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1dfad;
}

.modal-comment-avatar-glyph {
  width: 32rpx;
  height: 32rpx;
}

.modal-comment-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.modal-comment-name {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand-secondary-dark);
}

.modal-comment-text {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.55;
}

.sheet-input-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid var(--border-soft);
}

.sheet-input {
  flex: 1;
  height: 72rpx;
  padding: 0 22rpx;
  background: var(--bg-soft);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--text-primary);
}

.sheet-send-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  flex-shrink: 0;
  margin: 0;
}

/* ──────────────────────── 发帖表单 ──────────────────────── */

.post-form {
  flex: 1;
  min-height: 0;
  max-height: 65vh;
  padding: 24rpx 28rpx 8rpx;
  box-sizing: border-box;
}

.post-content-input {
  width: 100%;
  min-height: 220rpx;
  padding: 20rpx;
  background: var(--bg-soft);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.55;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.post-images-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.post-image-item {
  position: relative;
  aspect-ratio: 1 / 1;
}

.post-image-thumb {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-sm);
  background: var(--bg-soft);
}

.post-image-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(31, 20, 16, 0.7);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-image-add {
  aspect-ratio: 1 / 1;
  background: var(--bg-soft);
  border: 2rpx dashed var(--border-medium);
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transition: background 0.15s ease;
}

.post-image-add-hover {
  background: var(--bg-muted);
}

.post-image-add-icon {
  font-size: 44rpx;
  color: var(--text-muted);
  line-height: 1;
}

.post-image-add-glyph {
  width: 40rpx;
  height: 40rpx;
}

.post-image-add-text {
  font-size: 22rpx;
  color: var(--text-muted);
}

.post-form-tip {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
}

.post-submit-btn {
  width: 100%;
}
