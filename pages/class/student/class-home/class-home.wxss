.page--tablet .banner__name {
  font-size: 40rpx;
}

.page--tablet .card {
  padding: 36rpx 32rpx;
}

.page--tablet .card-title {
  font-size: 32rpx;
}

.banner {
  margin-bottom: 32rpx;
  padding: 30rpx 32rpx 26rpx;
  border-radius: 20rpx;
  background: #f4ead6;
  box-shadow: 0 12rpx 40rpx rgba(92, 64, 51, 0.1);
  border: 1rpx solid rgba(201, 162, 39, 0.12);
  position: relative;
  overflow: hidden;
}

.banner::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255, 249, 239, 0.4);
  pointer-events: none;
  z-index: 1;
}

.class-workbench-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.banner__name {
  position: relative;
  z-index: 2;
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1e3a5c;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.banner__hint {
  position: relative;
  z-index: 2;
  display: block;
  font-size: 22rpx;
  color: rgba(92, 64, 51, 0.55);
}

/* 作业卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(61, 52, 40, 0.08);
  border: 1rpx solid rgba(92, 64, 51, 0.06);
}

.card-main {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: space-between;
  gap: 20rpx;
}

.card-left {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2418;
  line-height: 1.45;
  margin-bottom: 12rpx;
}

.card-date {
  display: block;
  font-size: 24rpx;
  color: #7a6b5c;
  line-height: 1.4;
}

.card-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 120rpx;
}

.card-row-status {
  margin-bottom: 12rpx;
}

.tag-undone {
  font-size: 26rpx;
  color: #9a3412;
  font-weight: 600;
  padding: 4rpx 0;
}

.tag-progress {
  font-size: 26rpx;
  color: #1d4ed8;
  font-weight: 600;
  padding: 4rpx 0;
}

.tag-done {
  font-size: 26rpx;
  color: #0d9488;
  font-weight: 600;
  padding: 4rpx 0;
}

.btn {
  font-size: 24rpx;
  line-height: 1.4;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  text-align: center;
  min-width: 160rpx;
  box-sizing: border-box;
}

.btn-practice {
  color: #faf8f5;
  background: #5c4033;
  border: 1rpx solid #4a3428;
  font-weight: 500;
}

.btn-outline {
  color: #5c4033;
  background: rgba(248, 246, 240, 0.9);
  border: 2rpx solid rgba(92, 64, 51, 0.45);
  font-weight: 500;
}

.btn-disabled {
  color: rgba(92, 64, 51, 0.55);
  background: rgba(0, 0, 0, 0.04);
  border-color: rgba(92, 64, 51, 0.18);
}

.btn--hover {
  opacity: 0.88;
}

.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 46vh;
  padding: 40rpx 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8a7a6a;
  line-height: 1.6;
  text-align: center;
}
