<view class="page class-flow {{layoutClass}}">
  <view class="banner">
    <image class="class-workbench-image" src="/assets/images/ui/class-workbench-bg.png" mode="aspectFill"></image>
    <text class="banner__name">{{className}}</text>
    <text class="banner__hint">点击作业进入练习</text>
  </view>

  <block wx:if="{{assignmentList.length > 0}}">
    <view
      class="card"
      wx:for="{{assignmentList}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-status="{{item.status}}"
      bindtap="goToAssignment"
    >
      <view class="card-main">
        <view class="card-left">
          <text class="card-title">{{item.title}}</text>
          <text class="card-date">布置时间：{{item.date}}</text>
        </view>
        <view class="card-right">
          <block wx:if="{{item.status === 'pending_submit'}}">
            <view class="card-row-status">
              <text class="tag-undone">待提交</text>
            </view>
            <view class="btn btn-practice" hover-class="btn--hover">去提交</view>
          </block>
          <block wx:elif="{{item.status === 'passed'}}">
            <view class="card-row-status">
              <text class="tag-done">已通过</text>
            </view>
            <view class="btn btn-outline btn-disabled">已完成</view>
          </block>
          <block wx:elif="{{item.status === 'rejected'}}">
            <view class="card-row-status">
              <text class="tag-rejected">已驳回，待重做</text>
            </view>
            <view class="btn btn-practice" hover-class="btn--hover">重新完成</view>
          </block>
          <block wx:elif="{{item.status === 'pending_review'}}">
            <view class="card-row-status">
              <text class="tag-progress">已提交，待批改</text>
            </view>
            <view class="btn btn-outline btn-disabled">等待批改</view>
          </block>
          <block wx:else>
            <view class="card-row-status">
              <text class="tag-progress">{{item.progressText || '待提交'}}</text>
            </view>
            <view class="btn btn-outline btn-disabled">待提交</view>
          </block>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="empty-wrap">
    <text class="empty-text">老师暂时还没布置作业哦～</text>
  </view>
</view>
