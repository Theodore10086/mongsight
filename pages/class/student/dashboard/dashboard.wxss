/* 安全区/平板主列由 app.wxss 引入的 class-surface 提供 */
.page--tablet .profile-welcome {
  font-size: 44rpx;
}

.page--tablet .section-title {
  font-size: 36rpx;
}

.page--tablet .class-card {
  padding: 36rpx 32rpx;
}

.page--tablet .class-card-name {
  font-size: 34rpx;
}

/* 顶部个人信息区 */
.profile {
  margin-bottom: 36rpx;
}

.profile-card {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  padding: 36rpx 32rpx 32rpx;
  background: linear-gradient(160deg, #fcfaf6 0%, #f0ebe3 48%, #e8e1d4 100%);
  box-shadow: 0 12rpx 40rpx rgba(92, 64, 51, 0.1);
  border: 1rpx solid rgba(201, 162, 39, 0.12);
}

.profile-paper {
  position: absolute;
  inset: 0;
  opacity: 0.35;
  background-image: repeating-linear-gradient(
      -8deg,
      rgba(201, 162, 39, 0.03) 0,
      rgba(201, 162, 39, 0.03) 1rpx,
      transparent 1rpx,
      transparent 8rpx
    ),
    repeating-linear-gradient(92deg, rgba(92, 64, 51, 0.02) 0, transparent 3rpx);
  pointer-events: none;
}

.profile-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.profile-text {
  flex: 1;
  min-width: 0;
}

.profile-welcome,
.profile-class {
  display: block;
}

.profile-welcome {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1e3a5c;
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
}

.profile-class {
  font-size: 26rpx;
  color: #5c4033;
  line-height: 1.5;
  font-weight: 500;
}

.profile-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.profile-action {
  font-size: 22rpx;
  color: #8b5a2b;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(139, 90, 43, 0.32);
  background-color: rgba(255, 255, 255, 0.75);
  text-align: center;
}

.profile-action--logout {
  color: #a05040;
  border-color: rgba(160, 80, 64, 0.45);
}

.profile-action:active {
  opacity: 0.78;
}

/* 区块标题 · 金色竖线 */
.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-left: 4rpx;
}

.section-gold {
  width: 6rpx;
  height: 32rpx;
  border-radius: 3rpx;
  margin-right: 16rpx;
  background: linear-gradient(180deg, #d4b84a 0%, #a67c2d 100%);
  box-shadow: 0 0 12rpx rgba(199, 162, 64, 0.35);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3d3428;
  letter-spacing: 2rpx;
}

/* 班级卡片 */
.class-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(61, 52, 40, 0.08);
  border: 1rpx solid rgba(92, 64, 51, 0.06);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.class-card:active {
  opacity: 0.92;
}

.class-card-main {
  flex: 1;
  min-width: 0;
}

.class-card-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2c2418;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.class-card-teacher {
  display: block;
  font-size: 22rpx;
  color: rgba(61, 46, 40, 0.6);
  margin-bottom: 4rpx;
}

.class-card-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(61, 46, 40, 0.55);
  line-height: 1.5;
}

.class-card-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.class-card-stat {
  font-size: 22rpx;
  color: rgba(92, 64, 51, 0.65);
  font-weight: 500;
}

.class-card-arrow {
  font-size: 38rpx;
  color: rgba(92, 64, 51, 0.45);
  line-height: 1;
}

/* 无班级 */
.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 46vh;
  padding: 40rpx 32rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #8a7a6a;
  line-height: 1.6;
  text-align: center;
}
