/* 布局由 app.wxss 中的 class-surface 提供；与 class-flow--canvas 配合，保证全高 flex 链 */
page {
  height: 100%;
}

.page--tablet .toolbar {
  width: 128rpx;
}

.page--tablet .top-bar__progress {
  font-size: 30rpx;
}

.page--tablet .top-bar__submit {
  padding: 16rpx 40rpx;
  font-size: 30rpx;
}

.page--tablet .pen-opt {
  padding: 16rpx 0;
  font-size: 26rpx;
}

/* 顶部 */
.top-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 8rpx 20rpx;
}

.top-bar__progress {
  font-size: 28rpx;
  color: #3d3428;
  font-weight: 500;
}

.top-bar__submit {
  padding: 14rpx 36rpx;
  font-size: 28rpx;
  color: #faf8f5;
  background: #5c4033;
  border-radius: 12rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(92, 64, 51, 0.25);
}

.top-bar__submit--hover {
  opacity: 0.9;
}

/* 主体行 */
.main-row {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  min-height: 0;
  gap: 16rpx;
  overflow: hidden;
}

/* 左侧工具栏 */
.toolbar {
  flex-shrink: 0;
  width: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 8rpx;
  background: rgba(255, 255, 255, 0.65);
  border-radius: 16rpx;
  border: 1rpx solid rgba(92, 64, 51, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(61, 52, 40, 0.06);
}

.toolbar-block {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tool-item {
  width: 96rpx;
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.tool-item--active {
  background: rgba(92, 64, 51, 0.14);
  border-color: #5c4033;
}

.tool-icon {
  font-size: 36rpx;
  line-height: 1.2;
  color: #3d3428;
}

.tool-icon--pen {
  font-size: 32rpx;
  font-weight: 600;
}

.tool-icon--undo {
  font-size: 34rpx;
  font-weight: 600;
}

.tool-icon--clear {
  font-size: 34rpx;
}

.tool-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #5c5348;
}

/* 画笔粗细展开 */
.pen-menu {
  margin-top: 12rpx;
  padding: 8rpx;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid rgba(92, 64, 51, 0.15);
  box-shadow: 0 8rpx 24rpx rgba(61, 52, 40, 0.08);
}

.pen-opt {
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #5c5348;
  border-radius: 8rpx;
}

.pen-opt--on {
  background: rgba(92, 64, 51, 0.12);
  color: #5c4033;
  font-weight: 600;
}

/* 画板区：双层 Canvas 容器 */
.canvas-wrap {
  flex: 1;
  min-width: 0;
  min-height: 420rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f0e8;
  border: 1rpx solid rgba(92, 64, 51, 0.1);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8),
    0 8rpx 28rpx rgba(61, 52, 40, 0.08);
}

/* 绝对填满 canvas-wrap，避免 height:100% 在 flex 子元素里解析为 0 */
.canvas-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

/* 底：字帖静态渲染（z-index:1） */
.target-canvas {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
}

/* 顶：学生书写，透明底（z-index:2，遮罩层已移除，灰度渲染由 JS 处理） */
.write-canvas {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  display: block;
  touch-action: none;
  background: transparent;
}

/* 底部翻页 */
.pager {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 20rpx 12rpx 8rpx;
}

.pager-btn {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #5c4033;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 999rpx;
  border: 1rpx solid rgba(92, 64, 51, 0.22);
}

.pager-btn--disabled {
  opacity: 0.35;
  pointer-events: none;
}

.pager-num {
  font-size: 28rpx;
  color: #3d3428;
  font-weight: 600;
  min-width: 120rpx;
  text-align: center;
}
