@import '../teacher-class-surface.wxss';

.page {
  min-height: 100vh;
  min-height: 100dvh;
  box-sizing: border-box;
  width: 100%;
  background-color: #f8f6f0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  padding-left: constant(safe-area-inset-left);
  padding-left: env(safe-area-inset-left);
  padding-right: constant(safe-area-inset-right);
  padding-right: env(safe-area-inset-right);
  overflow: visible;
}

.class-banner {
  padding: 28rpx 32rpx 20rpx;
  background-color: #faf8f4;
  border-bottom: 1rpx solid rgba(139, 90, 43, 0.1);
}

.class-banner__name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #3d2e28;
  margin-bottom: 8rpx;
}

.class-banner__hint {
  font-size: 22rpx;
  color: rgba(92, 64, 51, 0.45);
}

/* Tab 栏 */
.tabs {
  display: flex;
  flex-direction: row;
  background-color: #fffdf9;
  border-bottom: 1rpx solid rgba(139, 90, 43, 0.12);
}

.tabs-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx 18rpx;
  position: relative;
}

.tabs-item__text {
  font-size: 30rpx;
  color: rgba(92, 64, 51, 0.45);
  font-weight: 400;
}

.tabs-item--active .tabs-item__text {
  color: #3d2e28;
  font-weight: 700;
}

.tabs-item__indicator {
  margin-top: 14rpx;
  width: 56rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: #d4af37;
}

/* 工具栏（批量添加 / 批量 / 批量删除） */
.toolbar {
  padding: 16rpx 28rpx 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.toolbar-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.toolbar-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 54rpx;
  font-size: 24rpx;
  color: #5c4033;
  background-color: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(139, 90, 43, 0.35);
  border-radius: 28rpx;
}

.toolbar-btn--primary {
  color: #ffffff;
  background-color: #5c4033;
  border-color: #5c4033;
}

.toolbar-btn--danger {
  color: #a05040;
  background-color: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(160, 80, 64, 0.45);
}

.toolbar-btn::after {
  border: none;
}

/* 批量添加面板 */
.import-panel {
  margin: 0 28rpx 20rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background-color: #fffdf9;
  border: 2rpx solid rgba(139, 90, 43, 0.2);
  box-shadow: 0 4rpx 12rpx rgba(92, 64, 51, 0.06);
}

.import-tip {
  margin-bottom: 16rpx;
}

.import-tip-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #8b5a2b;
  margin-bottom: 8rpx;
}

.import-tip-text {
  font-size: 22rpx;
  color: rgba(61, 46, 40, 0.7);
  line-height: 1.5;
}

.import-textarea {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  padding: 20rpx;
  font-size: 24rpx;
  color: #3d2e28;
  line-height: 1.5;
  border-radius: 10rpx;
  border: 1rpx solid rgba(139, 90, 43, 0.25);
  background-color: #ffffff;
}

.import-ph {
  color: rgba(92, 64, 51, 0.35);
  font-size: 24rpx;
}

.import-parse {
  width: 100%;
  margin-top: 20rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  background-color: #5c4033;
  border-radius: 36rpx;
  border: none;
}

.import-parse::after {
  border: none;
}

.student-empty {
  margin: 48rpx 40rpx;
  padding: 40rpx;
  text-align: center;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.7);
  border: 1rpx dashed rgba(139, 90, 43, 0.22);
}

.student-empty-text {
  font-size: 26rpx;
  color: rgba(92, 64, 51, 0.55);
  line-height: 1.6;
}

/* 列表区域 */
.panel-scroll {
  height: calc(100vh - 280rpx);
  box-sizing: border-box;
}

.panel-scroll--import {
  height: calc(100vh - 520rpx);
}

.panel-scroll--fab {
  height: calc(100vh - 280rpx);
  padding-bottom: 140rpx;
}

.scroll-pad {
  height: 32rpx;
}

.scroll-pad--fab {
  height: 160rpx;
}

/* 卡片 */
.card {
  margin: 0 28rpx 24rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(92, 64, 51, 0.06);
  border: 1rpx solid rgba(139, 90, 43, 0.06);
}

.card-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.card-check {
  flex-shrink: 0;
  padding: 8rpx 16rpx 0 0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(139, 90, 43, 0.45);
  box-sizing: border-box;
}

.checkbox--on {
  background-color: #d4af37;
  border-color: #c49a3c;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-body--student {
  padding-top: 4rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #3d2e28;
  margin-bottom: 10rpx;
}

.card-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(61, 46, 40, 0.72);
  margin-bottom: 6rpx;
}

.card-meta {
  display: block;
  font-size: 22rpx;
  color: rgba(92, 64, 51, 0.55);
}

.card-meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.card-meta-action {
  font-size: 22rpx;
  color: #8b5a2b;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(139, 90, 43, 0.32);
  background-color: rgba(212, 175, 55, 0.08);
}

.card-meta-action:active {
  opacity: 0.78;
}

.card-assign {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
}

.assign-tap {
  flex: 1;
  min-width: 0;
}

.assign-tap:active {
  opacity: 0.92;
}

.assign-del {
  flex-shrink: 0;
  align-self: center;
  font-size: 24rpx;
  color: #a05040;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(160, 80, 64, 0.35);
  background: rgba(255, 252, 248, 0.95);
}

.assign-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.assign-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2e28;
  line-height: 1.45;
}

.assign-type {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8b5a2b;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background-color: rgba(212, 175, 55, 0.15);
}

.assign-foot {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.assign-progress {
  font-size: 22rpx;
  color: rgba(92, 64, 51, 0.65);
}

.assign-date {
  font-size: 22rpx;
  color: rgba(92, 64, 51, 0.45);
}

/* FAB — 仅作业 Tab */
.fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 80;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background-color: #5c4033;
  box-shadow: 0 8rpx 28rpx rgba(92, 64, 51, 0.35);
}

.fab:active {
  opacity: 0.9;
}

.fab-icon {
  font-size: 32rpx;
  font-weight: 400;
  color: #ffffff;
  line-height: 1;
}

.fab-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}
