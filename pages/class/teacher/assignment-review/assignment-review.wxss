@import '../teacher-class-surface.wxss';

/* ── 页面根容器 ───────────────────────────────────────────────────── */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  height: 100dvh;
  box-sizing: border-box;
  background-color: #f8f6f0;
  overflow: hidden;
}

/* ── 顶部信息区 ──────────────────────────────────────────────────── */
.header {
  flex-shrink: 0;
  padding: 28rpx 32rpx 20rpx;
  background: #fdfaf4;
  border-bottom: 1rpx solid rgba(139, 90, 43, 0.12);
}

.header__title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #2c1f14;
  margin-bottom: 16rpx;
  line-height: 1.3;
}

.header__stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.header__stat-label {
  font-size: 24rpx;
  color: rgba(92, 64, 51, 0.55);
}

.header__stat-label--tail {
  margin-right: 16rpx;
}

.header__stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a4d7c;
  margin: 0 4rpx;
}

.header__stat-sep {
  font-size: 24rpx;
  color: rgba(92, 64, 51, 0.35);
}

.header__stat-total {
  font-size: 26rpx;
  color: #3d2e28;
  margin: 0 4rpx;
}

.header__pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.header__pill--pending {
  background: rgba(224, 112, 32, 0.12);
  color: #b85a00;
}

.header__pill--passed {
  background: rgba(42, 157, 143, 0.12);
  color: #1d7a6e;
}

/* ── 列表滚动区 ──────────────────────────────────────────────────── */
.list-scroll {
  flex: 1;
  min-height: 0;
  padding: 16rpx 24rpx 0;
  box-sizing: border-box;
}

/* ── 空状态 ──────────────────────────────────────────────────────── */
.empty-box {
  padding: 80rpx 0;
  display: flex;
  justify-content: center;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(92, 64, 51, 0.35);
}

/* ── 学生卡片 ────────────────────────────────────────────────────── */
.card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 18rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 52, 40, 0.06);
  gap: 18rpx;
}

/* 左侧信息 */
.card__left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c1f14;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card__no {
  font-size: 22rpx;
  color: rgba(92, 64, 51, 0.5);
}

.card__score-wrap {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 6rpx;
}

.card__score-label {
  font-size: 20rpx;
  color: rgba(92, 64, 51, 0.45);
}

.card__score {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.card__score--high {
  color: #1d8a7d;
}

.card__score--mid {
  color: #c05a00;
}

.card__unsub-hint {
  font-size: 22rpx;
  color: rgba(92, 64, 51, 0.3);
  margin-top: 6rpx;
}

/* 中间缩略图 */
.card__thumb-wrap {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(139, 90, 43, 0.12);
  overflow: hidden;
  background: #f5f0e8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card__thumb {
  width: 100%;
  height: 100%;
}

.card__thumb-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card__thumb-ph-icon {
  font-size: 28rpx;
  color: rgba(92, 64, 51, 0.25);
  font-weight: 300;
}

/* 右侧操作区 */
.card__right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  min-width: 100rpx;
}

/* 状态标签 */
.status-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
}

.status-tag__text {
  font-size: 22rpx;
  font-weight: 500;
}

.status-tag--pending {
  background: rgba(224, 112, 32, 0.12);
}

.status-tag--pending .status-tag__text {
  color: #b85a00;
}

.status-tag--passed {
  background: rgba(42, 157, 143, 0.14);
}

.status-tag--passed .status-tag__text {
  color: #1a7a6e;
}

.status-tag--rejected {
  background: rgba(176, 58, 46, 0.1);
}

.status-tag--rejected .status-tag__text {
  color: #922b1e;
}

.status-tag--unsubmitted {
  background: rgba(120, 120, 120, 0.1);
}

.status-tag--unsubmitted .status-tag__text {
  color: #888;
}

/* 通过 / 驳回 按钮 */
.action-btn {
  width: 100rpx;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn--pass {
  background: rgba(42, 157, 143, 0.14);
  color: #1a7a6e;
  border: 1rpx solid rgba(42, 157, 143, 0.3);
}

.action-btn--reject {
  background: rgba(176, 58, 46, 0.09);
  color: #922b1e;
  border: 1rpx solid rgba(176, 58, 46, 0.2);
}

/* 列表底部填充（为底部操作栏留空间）*/
.scroll-pad {
  height: 180rpx;
}

/* ── 底部吸底操作栏 ───────────────────────────────────────────────── */
.bottom-bar {
  flex-shrink: 0;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  padding-left: calc(28rpx + constant(safe-area-inset-left));
  padding-left: calc(28rpx + env(safe-area-inset-left));
  padding-right: calc(28rpx + constant(safe-area-inset-right));
  padding-right: calc(28rpx + env(safe-area-inset-right));
  background: rgba(248, 246, 240, 0.96);
  border-top: 1rpx solid rgba(139, 90, 43, 0.12);
  backdrop-filter: blur(10px);
  box-shadow: 0 -4rpx 20rpx rgba(61, 52, 40, 0.07);
  z-index: 100;
}

.bottom-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(61, 52, 40, 0.12);
}

.bottom-btn--pass {
  background: #2a7d6f;
}

.bottom-btn--export {
  background: #2a4d7c;
}

.bottom-btn--hover {
  opacity: 0.82;
}

.bottom-btn__text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* ── 平板适配 ─────────────────────────────────────────────────────── */
.page--tablet .card {
  padding: 28rpx 28rpx;
}

.page--tablet .card__thumb-wrap {
  width: 140rpx;
  height: 140rpx;
}

.page--tablet .card__name {
  font-size: 32rpx;
}

.page--tablet .card__score {
  font-size: 38rpx;
}

.page--tablet .bottom-btn {
  height: 96rpx;
}

.page--tablet .bottom-btn__text {
  font-size: 30rpx;
}
