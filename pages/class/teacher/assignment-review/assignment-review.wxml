<view class="page {{layoutClass}}">

  <!-- 顶部信息区 -->
  <view class="header">
    <text class="header__title">{{assignmentTitle}}</text>
    <view class="header__stats">
      <text class="header__stat-label">已提交</text>
      <text class="header__stat-num">{{submittedCount}}</text>
      <text class="header__stat-sep">/</text>
      <text class="header__stat-total">{{totalCount}}</text>
      <text class="header__stat-label header__stat-label--tail">人</text>
      <view class="header__pill header__pill--pending">待批改 {{pendingCount}}</view>
      <view class="header__pill header__pill--passed">已通过 {{passedCount}}</view>
    </view>
  </view>

  <!-- 学生提交列表 -->
  <scroll-view
    scroll-y
    class="list-scroll"
    show-scrollbar="{{false}}"
    enhanced="{{true}}"
    fast-deceleration="{{false}}"
  >
    <block wx:if="{{submissionList.length === 0}}">
      <view class="empty-box">
        <text class="empty-text">暂无学生数据</text>
      </view>
    </block>

    <view
      wx:for="{{submissionList}}"
      wx:key="id"
      class="card"
    >
      <!-- 左侧：姓名 / 学号 / AI 评分 -->
      <view class="card__left">
        <text class="card__name">{{item.studentName}}</text>
        <text class="card__no">{{item.studentNo}}</text>
        <view wx:if="{{item.status !== 'unsubmitted'}}" class="card__score-wrap">
          <text class="card__score-label">AI 评分</text>
          <text class="card__score {{item.aiScore >= 90 ? 'card__score--high' : 'card__score--mid'}}">
            {{item.aiScore}}
          </text>
        </view>
        <text wx:else class="card__unsub-hint">未提交</text>
      </view>

      <!-- 中间：字帖缩略图 -->
      <view
        class="card__thumb-wrap"
        bindtap="previewImage"
        data-url="{{item.imageUrl}}"
        data-status="{{item.status}}"
      >
        <image
          wx:if="{{item.imageUrl}}"
          class="card__thumb"
          src="{{item.imageUrl}}"
          mode="aspectFill"
          lazy-load="{{true}}"
        />
        <view wx:else class="card__thumb-ph">
          <text class="card__thumb-ph-icon">{{item.status === 'unsubmitted' ? '—' : '图'}}</text>
        </view>
      </view>

      <!-- 右侧：状态 + 操作按钮 -->
      <view class="card__right">
        <view class="status-tag status-tag--{{item.status}}">
          <text class="status-tag__text">{{statusLabel[item.status]}}</text>
        </view>
        <block wx:if="{{item.status === 'pending'}}">
          <view
            class="action-btn action-btn--pass"
            catchtap="handleReview"
            data-id="{{item.id}}"
            data-action="pass"
          >通过</view>
          <view
            class="action-btn action-btn--reject"
            catchtap="handleReview"
            data-id="{{item.id}}"
            data-action="reject"
          >驳回</view>
        </block>
      </view>
    </view>

    <view class="scroll-pad"></view>
  </scroll-view>

  <!-- 底部吸底操作栏 -->
  <view class="bottom-bar">
    <view
      class="bottom-btn bottom-btn--pass"
      hover-class="bottom-btn--hover"
      bindtap="handlePassAll"
    >
      <text class="bottom-btn__text">一键全部通过</text>
    </view>
    <view
      class="bottom-btn bottom-btn--export"
      hover-class="bottom-btn--hover"
      bindtap="handleExportAll"
    >
      <text class="bottom-btn__text">保存已通过到相册</text>
    </view>
  </view>

</view>
