page {
  background: var(--bg-page);
  min-height: 100vh;
}

.stats-page {
  padding: 0 28rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.stats-overview {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx 24rpx 24rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
}

.stats-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 24rpx;
}

.stats-hero-num {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--brand-primary);
  line-height: 1.1;
}

.stats-hero-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

.stats-row-top {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.stats-mini {
  background: var(--bg-soft);
  border-radius: var(--radius-sm);
  padding: 16rpx 12rpx;
  text-align: center;
}

.stats-mini-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.stats-mini-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

/* 掌握度 */
.mastery-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.mastery-card {
  border-radius: var(--radius-md);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.mastery-new { background: #f0ebe0; }
.mastery-learning { background: #e8dfcf; }
.mastery-proficient { background: #e0d5ba; }
.mastery-mastered { background: #d9cba5; }

.mastery-num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.mastery-label {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.mastery-hint {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 进度条 */
.mastery-bar-wrap { padding: 0 4rpx; }

.mastery-bar {
  display: flex;
  height: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: var(--bg-soft);
}

.mastery-bar-seg { height: 100%; }
.mastery-bar-new { background: #d4c5a9; }
.mastery-bar-learning { background: #b8a67c; }
.mastery-bar-proficient { background: #8c7a54; }
.mastery-bar-mastered { background: #5c4a2e; }

.mastery-bar-legend {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 2rpx;
}

.legend-new { background: #d4c5a9; }
.legend-learning { background: #b8a67c; }
.legend-proficient { background: #8c7a54; }
.legend-mastered { background: #5c4a2e; }

.legend-text {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-right: 14rpx;
}

/* 队列 */
.queue-list {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
  overflow: hidden;
}

.queue-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border-soft);
}

.queue-item:last-child { border-bottom: none; }

.queue-word {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.queue-word-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.queue-word-def {
  font-size: 22rpx;
  color: var(--text-muted);
}

.queue-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.queue-review-count {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.queue-arrow {
  width: 28rpx;
  height: 28rpx;
}

.queue-empty {
  padding: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

.stats-cta { padding-top: 8rpx; }
