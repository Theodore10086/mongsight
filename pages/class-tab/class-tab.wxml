<view class="class-tab-page">

  <!-- 顶部欢迎条 -->
  <view class="class-hero">
    <view class="class-hero-mascot">
      <text class="class-hero-emoji">🎓</text>
    </view>
    <view class="class-hero-text">
      <text class="class-hero-title">班级教学</text>
      <text class="class-hero-subtitle">教师布置作业，学生提交并由蒙宝AI评分</text>
    </view>
  </view>

  <!-- 单一入口：进入班级登录 -->
  <view class="login-cta">
    <view class="login-cta-text">
      <text class="login-cta-title">进入班级</text>
      <text class="login-cta-desc">在登录页选择"教师"或"学生"身份后进入对应工作台</text>
    </view>
    <button class="zm-btn-primary login-cta-btn" bindtap="onGoToClassLogin">进入班级登录</button>
  </view>

</view>
