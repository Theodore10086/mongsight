/* ═══════════════════════════════════════════════════════════
   WARM AMBER FLUID DESIGN — Non-Newtonian blob system
   Organic flowing blobs with blur create liquid metal effect.
   Palette: deep brown #1a0e08 → amber #c49a3c → peach #ffb366
   ═══════════════════════════════════════════════════════════ */

/* Base blob element */
.fluid-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(28rpx);
  pointer-events: none;
  will-change: transform;
}

/* ── Community header ─────────────────────────────────────── */
.community-header {
  padding: 44rpx 36rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #1a0e08 0%, #2a1508 50%, #1a0e08 100%);
  position: relative;
  overflow: hidden;
}

/* Blobs for community header */
.community-header .fluid-blob-1 {
  width: 260rpx;
  height: 200rpx;
  top: -60rpx;
  right: -40rpx;
  background: radial-gradient(ellipse, rgba(212, 134, 11, 0.65) 0%, rgba(196, 130, 30, 0.2) 50%, transparent 75%);
  animation: fluidDrift1 8s ease-in-out infinite;
}

.community-header .fluid-blob-2 {
  width: 180rpx;
  height: 160rpx;
  bottom: -40rpx;
  left: 30%;
  background: radial-gradient(ellipse, rgba(255, 140, 66, 0.45) 0%, rgba(230, 120, 40, 0.15) 50%, transparent 70%);
  animation: fluidDrift2 10s ease-in-out infinite;
  animation-delay: -3s;
}

.community-header .fluid-blob-3 {
  width: 140rpx;
  height: 120rpx;
  top: -20rpx;
  left: -30rpx;
  background: radial-gradient(ellipse, rgba(196, 154, 60, 0.5) 0%, rgba(180, 120, 30, 0.15) 50%, transparent 70%);
  animation: fluidDrift3 12s ease-in-out infinite;
  animation-delay: -5s;
}

.community-title {
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(245, 240, 232, 0.95);
  position: relative;
  z-index: 2;
  letter-spacing: 2rpx;
}

/* ── Fluid blob animations ────────────────────────────────── */
@keyframes fluidDrift1 {
  0%   { transform: translate(0, 0)       scale(1)    rotate(0deg); }
  25%  { transform: translate(-20rpx, 15rpx) scale(1.12) rotate(3deg); }
  50%  { transform: translate(10rpx, -10rpx) scale(0.92) rotate(-2deg); }
  75%  { transform: translate(-10rpx, 5rpx)  scale(1.08) rotate(1deg); }
  100% { transform: translate(0, 0)       scale(1)    rotate(0deg); }
}

@keyframes fluidDrift2 {
  0%   { transform: translate(0, 0)       scale(1)    rotate(0deg); }
  33%  { transform: translate(30rpx, -15rpx) scale(1.15) rotate(-3deg); }
  66%  { transform: translate(-15rpx, 10rpx) scale(0.88) rotate(4deg); }
  100% { transform: translate(0, 0)       scale(1)    rotate(0deg); }
}

@keyframes fluidDrift3 {
  0%   { transform: translate(0, 0)       scale(1); }
  20%  { transform: translate(15rpx, 10rpx) scale(1.1); }
  40%  { transform: translate(-20rpx, -8rpx) scale(0.95); }
  60%  { transform: translate(8rpx, -15rpx) scale(1.08); }
  80%  { transform: translate(-10rpx, 12rpx) scale(0.92); }
  100% { transform: translate(0, 0)       scale(1); }
}

