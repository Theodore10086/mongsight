  bottom: 0;
  z-index: 9999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s ease;
}

.guide-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

/* 对话舞台样式 */
.dialog-stage {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s ease;
}

.dialog-stage.active {
  opacity: 1;
  pointer-events: auto;
}

.dialog-stage .hero-portrait-center {
  position: absolute;
  bottom: 15vh;
  left: 50%;
  transform: translateX(-50%);
  width: 45vh;
  height: 65vh;
  max-width: 500rpx;
  max-height: 700rpx;
  opacity: 0;
  transition: all 0.5s ease;
  z-index: 5;
  transform-style: preserve-3d;
  backface-visibility: hidden;
}

.dialog-stage .hero-portrait-center.flip-to-back {
  transform: translateX(-50%) rotateY(180deg);
}

.dialog-stage .hero-portrait-center.inactive {
  opacity: 0;
  transform: translateX(-50%) scale(0.8) rotateY(180deg);
  z-index: 3;
}

.dialog-stage .hero-portrait-center:not(.inactive) {
  opacity: 1;
  z-index: 10;
}

@media (min-width: 768px) {
  .dialog-stage .hero-portrait-center {
    bottom: 18vh;
    width: 50vh;
    height: 70vh;
    max-width: 600rpx;
    max-height: 800rpx;
  }
}

.dialog-stage .hero-portrait-center.inactive {
  opacity: 0;
  transform: translateX(-50%) scale(0.8) rotateY(180deg);
  z-index: 3;
}

.dialog-stage .hero-portrait-center:not(.inactive) {
  opacity: 1;
  z-index: 10;
}

.dialog-stage .dialog-box {
  position: absolute;
  bottom: 60rpx;
  left: 40rpx;
  right: 40rpx;
  opacity: 0;
  transform: translateY(30rpx);
  transition: all 0.4s ease;
}

.dialog-stage .dialog-box.visible {
  opacity: 1;
  transform: translateY(0);
}

.dialog-speaker {
  background: linear-gradient(135deg, #c49a3c, #c9a227);
  padding: 12rpx 24rpx;
  border-radius: 12rpx 12rpx 0 0;
