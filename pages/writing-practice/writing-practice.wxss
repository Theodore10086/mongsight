/* ═══════════════════════════════════════════════════════════
   蒙古草原银河星空 — Mongolian Grassland Milky Way
   一个真正令人震撼的银河夜空 — 宇宙的浩瀚与神秘
   ═══════════════════════════════════════════════════════════ */

.starfield-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  /* 深空底色 — 从天顶深邃墨蓝过渡到地平线暖褐 */
  background: linear-gradient(
    180deg,
    #04060e 0%,
    #06080f 15%,
    #080a12 30%,
    #0a0c14 50%,
    #0e0a0a 72%,
    #1a0e06 88%,
    #2a1808 100%
  );
  overflow: hidden;
}

/* ── Layer 1 — 星尘：最密集的远星 ──────────────────────────── */
.stars {
  position: absolute;
  width: 100%; height: 85%; top: 0;
  background-image:
    radial-gradient(1rpx 1rpx at  10rpx  15rpx, rgba(255,255,255,0.9),  transparent),
    radial-gradient(1rpx 1rpx at  28rpx  52rpx, rgba(200,220,255,0.6),  transparent),
    radial-gradient(1rpx 1rpx at  42rpx  8rpx,  rgba(255,255,255,0.7),  transparent),
    radial-gradient(1rpx 1rpx at  58rpx  38rpx, rgba(255,248,220,0.5),  transparent),
    radial-gradient(1rpx 1rpx at  72rpx  65rpx, rgba(200,210,255,0.65), transparent),
    radial-gradient(1rpx 1rpx at  88rpx  22rpx, rgba(255,255,255,0.85), transparent),
    radial-gradient(1rpx 1rpx at 105rpx  58rpx, rgba(255,255,255,0.5),  transparent),
    radial-gradient(1rpx 1rpx at 118rpx  5rpx,  rgba(200,220,255,0.7),  transparent),
    radial-gradient(1rpx 1rpx at 135rpx  45rpx, rgba(255,255,255,0.6),  transparent),
    radial-gradient(1rpx 1rpx at 150rpx  72rpx, rgba(255,248,220,0.55), transparent),
    radial-gradient(1rpx 1rpx at 168rpx  18rpx, rgba(255,255,255,0.8),  transparent),
    radial-gradient(1rpx 1rpx at 182rpx  55rpx, rgba(200,210,255,0.6),  transparent),
    radial-gradient(1rpx 1rpx at 198rpx  32rpx, rgba(255,248,220,0.75), transparent),
    radial-gradient(1rpx 1rpx at 215rpx  68rpx, rgba(255,255,255,0.5),  transparent),
    radial-gradient(1rpx 1rpx at 232rpx  12rpx, rgba(200,220,255,0.65), transparent),
    radial-gradient(1rpx 1rpx at 248rpx  48rpx, rgba(255,255,255,0.7),  transparent),
    radial-gradient(1rpx 1rpx at 265rpx  75rpx, rgba(255,248,220,0.5),  transparent),
    radial-gradient(1rpx 1rpx at 280rpx  25rpx, rgba(200,210,255,0.6),  transparent),
    radial-gradient(1rpx 1rpx at 295rpx  60rpx, rgba(255,255,255,0.7),  transparent),
    radial-gradient(1rpx 1rpx at 312rpx  15rpx, rgba(255,255,255,0.85), transparent);
  background-size: 340rpx 85rpx;
  animation: twinkle1 4s ease-in-out infinite;
}

/* ── Layer 1b — 额外星尘（偏移铺设，增密度）──────────────── */
.stars::before {
  content: '';
  position: absolute;
  width: 100%; height: 100%;
  background-image:
    radial-gradient(1rpx 1rpx at 15rpx  42rpx, rgba(255,255,255,0.6),  transparent),
    radial-gradient(1rpx 1rpx at 48rpx  18rpx, rgba(200,215,255,0.55), transparent),
    radial-gradient(1rpx 1rpx at 75rpx  70rpx, rgba(255,255,255,0.5),  transparent),
    radial-gradient(1rpx 1rpx at 108rpx 28rpx, rgba(255,248,220,0.65), transparent),
    radial-gradient(1rpx 1rpx at 142rpx 62rpx, rgba(200,210,255,0.5),  transparent),
    radial-gradient(1rpx 1rpx at 175rpx 10rpx, rgba(255,255,255,0.7),  transparent),
    radial-gradient(1rpx 1rpx at 205rpx 50rpx, rgba(255,248,220,0.55), transparent),
    radial-gradient(1rpx 1rpx at 238rpx 35rpx, rgba(200,220,255,0.6),  transparent),
    radial-gradient(1rpx 1rpx at 268rpx 78rpx, rgba(255,255,255,0.5),  transparent),
    radial-gradient(1rpx 1rpx at 298rpx 22rpx, rgba(200,210,255,0.65), transparent),
    radial-gradient(1rpx 1rpx at 325rpx 55rpx, rgba(255,255,255,0.7),  transparent),
    radial-gradient(1rpx 1rpx at 352rpx 8rpx,  rgba(255,248,220,0.6),  transparent),
    radial-gradient(1rpx 1rpx at 378rpx 68rpx, rgba(255,255,255,0.5),  transparent),
    radial-gradient(1rpx 1rpx at 402rpx 40rpx, rgba(200,215,255,0.55), transparent),
    radial-gradient(1rpx 1rpx at 430rpx 15rpx, rgba(255,255,255,0.75), transparent);
  background-size: 450rpx 90rpx;
  animation: twinkle2 5.5s ease-in-out infinite;
  animation-delay: -1.5s;
}

/* ── Layer 2 — 中等亮星 ────────────────────────────────────── */
.stars-mid {
  position: absolute;
  width: 100%; height: 78%; top: 2%;
  background-image:
    radial-gradient(1.5rpx 1.5rpx at 20rpx  30rpx, rgba(255,255,255,0.9),  transparent),
    radial-gradient(1.5rpx 1.5rpx at 58rpx  58rpx, rgba(200,215,255,0.75), transparent),
    radial-gradient(2rpx   2rpx   at 95rpx  12rpx, rgba(255,250,230,0.95), transparent),
    radial-gradient(1.5rpx 1.5rpx at 132rpx 50rpx, rgba(200,210,255,0.7),  transparent),
    radial-gradient(1.5rpx 1.5rpx at 170rpx 25rpx, rgba(255,255,255,0.8),  transparent),
    radial-gradient(2rpx   2rpx   at 208rpx 65rpx, rgba(255,248,220,0.85), transparent),
    radial-gradient(1.5rpx 1.5rpx at 245rpx 8rpx,  rgba(200,220,255,0.9),  transparent),
    radial-gradient(1.5rpx 1.5rpx at 282rpx 45rpx, rgba(255,255,255,0.7),  transparent),
    radial-gradient(2rpx   2rpx   at 318rpx 32rpx, rgba(255,248,220,0.85), transparent),
    radial-gradient(1.5rpx 1.5rpx at 355rpx 70rpx, rgba(200,210,255,0.75), transparent),
    radial-gradient(1.5rpx 1.5rpx at 392rpx 18rpx, rgba(255,255,255,0.8),  transparent),
    radial-gradient(2rpx   2rpx   at 428rpx 55rpx, rgba(255,250,230,0.9),  transparent);
  background-size: 460rpx 95rpx;
  animation: twinkle2 7s ease-in-out infinite;
  animation-delay: -2.5s;
}

/* ── Layer 3 — 明亮近星（稀疏、大粒） ──────────────────────── */
.stars-near {
  position: absolute;
  width: 100%; height: 72%; top: 3%;
  background-image:
    radial-gradient(3rpx 3rpx   at 55rpx  35rpx, rgba(255,255,255,1),    transparent),
    radial-gradient(3.5rpx 3.5rpx at 165rpx 20rpx, rgba(255,248,220,1), transparent),
    radial-gradient(2.5rpx 2.5rpx at 275rpx 58rpx, rgba(200,220,255,0.95), transparent),
    radial-gradient(4rpx 4rpx   at 385rpx 15rpx, rgba(255,250,235,1),    transparent),
    radial-gradient(3rpx 3rpx   at 480rpx 48rpx, rgba(255,255,255,0.9),  transparent),
    radial-gradient(3.5rpx 3.5rpx at 575rpx 28rpx, rgba(200,215,255,1), transparent),
    radial-gradient(2.5rpx 2.5rpx at 665rpx 55rpx, rgba(255,255,255,0.95), transparent);
  background-size: 720rpx 80rpx;
  animation: twinkle3 10s ease-in-out infinite;
  animation-delay: -4s;
}

/* ── Layer 3b — 星芒十字光（最亮几颗带衍射光芒） ────────── */
.stars-near::before {
  content: '';
  position: absolute;
  width: 100%; height: 100%;
  background-image:
    /* 竖线芒 */
    radial-gradient(1rpx 8rpx at 165rpx 20rpx, rgba(255,250,235,0.7), transparent),
    radial-gradient(1rpx 8rpx at 385rpx 15rpx, rgba(255,250,235,0.8), transparent),
    radial-gradient(1rpx 6rpx at 575rpx 28rpx, rgba(200,215,255,0.6), transparent),
    /* 横线芒 */
    radial-gradient(8rpx 1rpx at 165rpx 20rpx, rgba(255,250,235,0.7), transparent),
    radial-gradient(8rpx 1rpx at 385rpx 15rpx, rgba(255,250,235,0.8), transparent),
    radial-gradient(6rpx 1rpx at 575rpx 28rpx, rgba(200,215,255,0.6), transparent);
  background-size: 720rpx 80rpx;
  animation: twinkle3 10s ease-in-out infinite;
  animation-delay: -4s;
}

/* ── Layer 4 — 银河 ─────────────────────────────────────────
   真实银河的特征：
   · 核心偏向一侧（人马座方向），不在正中
   · 宽度不均匀，有收窄和膨大
   · 内部有暗星云裂缝（马头星云、煤袋星云等）
   · 整体呈雾状流动，无规则竖线
   ─────────────────────────────────────────────────────────── */

/* 主光带 — 非对称，核心偏向43%位置 */
.milky-way {
  position: absolute;
  width: 280%;
  height: 62%;
  top: 2%;
  left: -90%;
  transform: rotate(-28deg);
  transform-origin: 45% 50%;
  /* 不对称的星光带：左侧稀薄→核心区极亮→右侧逐渐消散 */
  background: linear-gradient(
    90deg,
    transparent                     8%,
    rgba(140,155,195,0.012)        16%,
    rgba(170,182,218,0.032)        24%,
    rgba(195,205,238,0.058)        31%,
    rgba(215,222,250,0.088)        37%,
    rgba(232,238,255,0.13)         42%,
    rgba(248,250,255,0.18)         46%,  /* 核心最亮，偏左 */
    rgba(255,255,255,0.20)         49%,
    rgba(248,250,255,0.16)         52%,
    rgba(230,235,255,0.10)         57%,
    rgba(205,215,242,0.062)        64%,
    rgba(175,188,222,0.030)        73%,
    rgba(148,162,200,0.012)        83%,
    transparent                    93%
  );
  filter: blur(9rpx);
  pointer-events: none;
  animation: galaxyBreath 18s ease-in-out infinite;
}

@keyframes galaxyBreath {
  0%   { opacity: 0.8; filter: blur(9rpx);  }
  35%  { opacity: 1;   filter: blur(7rpx);  }
  70%  { opacity: 0.88;filter: blur(10rpx); }
  100% { opacity: 0.8; filter: blur(9rpx);  }
}

/* 星云团 — 不规则分布，模拟真实星云团簇结构 */
.milky-way::before {
  content: '';
  position: absolute;
  width: 100%; height: 100%;
  background-image:
    /* ── 核心区星云团（密集，46-53%） ── */
    radial-gradient(38rpx 11rpx at 47% 47%, rgba(255,252,240,0.16), transparent),
    radial-gradient(22rpx 7rpx  at 50% 53%, rgba(240,242,255,0.12), transparent),
    radial-gradient(30rpx 9rpx  at 44% 51%, rgba(255,250,235,0.13), transparent),
    radial-gradient(18rpx 6rpx  at 52% 46%, rgba(230,238,255,0.10), transparent),
    /* ── 核心左翼（稀疏，30-43%） ── */
    radial-gradient(45rpx 8rpx  at 37% 50%, rgba(210,220,248,0.07), transparent),
    radial-gradient(26rpx 6rpx  at 32% 46%, rgba(255,248,228,0.06), transparent),
    radial-gradient(20rpx 5rpx  at 40% 54%, rgba(200,215,245,0.08), transparent),
    radial-gradient(35rpx 7rpx  at 28% 49%, rgba(215,225,250,0.05), transparent),
    /* ── 核心右翼（消散，55-78%） ── */
    radial-gradient(28rpx 7rpx  at 58% 48%, rgba(220,228,252,0.07), transparent),
    radial-gradient(40rpx 9rpx  at 64% 52%, rgba(200,212,245,0.06), transparent),
    radial-gradient(22rpx 5rpx  at 71% 47%, rgba(210,218,248,0.05), transparent),
    radial-gradient(32rpx 6rpx  at 78% 51%, rgba(195,208,240,0.04), transparent),
    /* ── 暗星云裂缝 — 打破规则感的关键 ── */
    radial-gradient(42rpx 9rpx  at 43% 49%, rgba(2,3,10,0.14),     transparent),
    radial-gradient(28rpx 7rpx  at 55% 51%, rgba(1,2,8,0.11),      transparent),
    radial-gradient(18rpx 5rpx  at 48% 45%, rgba(3,4,12,0.09),     transparent),
    radial-gradient(35rpx 8rpx  at 34% 52%, rgba(1,2,7,0.08),      transparent),
    radial-gradient(22rpx 6rpx  at 67% 48%, rgba(2,3,10,0.07),     transparent),
    radial-gradient(16rpx 4rpx  at 74% 53%, rgba(1,2,8,0.06),      transparent);
  filter: blur(6rpx);
  animation: nebulaFlow 25s ease-in-out infinite;
}

@keyframes nebulaFlow {
  0%   { opacity: 0.75; transform: translateX(0);      }
  33%  { opacity: 1;    transform: translateX(-4rpx);  }
  66%  { opacity: 0.85; transform: translateX(3rpx);   }
  100% { opacity: 0.75; transform: translateX(0);      }
}

/* 银河内星尘 — 不等间距，密集在核心区 */
.milky-way::after {
  content: '';
  position: absolute;
  width: 100%; height: 100%;
  background-image:
    /* 核心区密集星点 */
    radial-gradient(1rpx 1rpx at 44% 48%, rgba(255,255,255,0.7),  transparent),
    radial-gradient(1rpx 1rpx at 46% 52%, rgba(200,214,255,0.55), transparent),
    radial-gradient(1rpx 1rpx at 48% 47%, rgba(255,252,230,0.65), transparent),
    radial-gradient(1rpx 1rpx at 50% 51%, rgba(255,255,255,0.75), transparent),
    radial-gradient(1rpx 1rpx at 52% 49%, rgba(220,230,255,0.6),  transparent),
    radial-gradient(1rpx 1rpx at 49% 53%, rgba(255,250,235,0.5),  transparent),
    /* 左翼星点（越往左越稀疏） */
    radial-gradient(1rpx 1rpx at 41% 50%, rgba(255,255,255,0.5),  transparent),
    radial-gradient(1rpx 1rpx at 38% 47%, rgba(200,212,255,0.4),  transparent),
    radial-gradient(1rpx 1rpx at 35% 52%, rgba(255,248,228,0.35), transparent),
    radial-gradient(1rpx 1rpx at 31% 49%, rgba(255,255,255,0.28), transparent),
    radial-gradient(1rpx 1rpx at 27% 51%, rgba(200,210,248,0.22), transparent),
    /* 右翼星点（越往右越稀疏） */
    radial-gradient(1rpx 1rpx at 56% 48%, rgba(255,255,255,0.45), transparent),
    radial-gradient(1rpx 1rpx at 60% 52%, rgba(200,215,255,0.38), transparent),
    radial-gradient(1rpx 1rpx at 65% 49%, rgba(255,248,228,0.3),  transparent),
    radial-gradient(1rpx 1rpx at 70% 51%, rgba(255,255,255,0.22), transparent),
    radial-gradient(1rpx 1rpx at 76% 48%, rgba(200,212,255,0.16), transparent),
    /* 随机偏移额外星点，打破节律 */
    radial-gradient(1rpx 1rpx at 43% 54%, rgba(255,255,255,0.4),  transparent),
    radial-gradient(1rpx 1rpx at 53% 44%, rgba(230,240,255,0.45), transparent),
    radial-gradient(1rpx 1rpx at 39% 53%, rgba(255,252,235,0.32), transparent),
    radial-gradient(1rpx 1rpx at 62% 46%, rgba(255,255,255,0.28), transparent);
  animation: twinkle2 6s ease-in-out infinite;
  animation-delay: -2s;
}

/* ── Layer 5 — 地平线大气辉光（黄金草原光污染） ────────────── */
.nebula {
  position: absolute;
  width: 100%; height: 55%; bottom: 0;
  background:
    /* 主光晕：从透明到暖金 */
    linear-gradient(
      180deg,
      transparent 0%,
      rgba(60, 40, 15, 0.04) 15%,
      rgba(100, 65, 15, 0.1) 30%,
      rgba(150, 90, 20, 0.2) 50%,
      rgba(196, 130, 35, 0.32) 68%,
      rgba(210, 155, 50, 0.42) 82%,
      rgba(180, 120, 30, 0.52) 100%
    ),
    /* 天际线上方的薄雾 */
    radial-gradient(
      ellipse 120% 40% at 50% 95%,
      rgba(220, 170, 60, 0.25),
      transparent
    );
  filter: blur(16rpx);
}

/* 地平线金色光边 */
.nebula::before {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 4rpx;
  background: linear-gradient(
    90deg,
    transparent 5%,
    rgba(220,170,60,0.3) 20%,
    rgba(255,200,80,0.5) 50%,
    rgba(220,170,60,0.3) 80%,
    transparent 95%
  );
  filter: blur(4rpx);
}

/* ── Layer 6 — 流星（两道划过夜空的亮线） ─────────────────── */
.nebula::after {
  content: '';
  position: absolute;
  top: 15%;
  left: -10%;
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
  transform: rotate(-35deg);
  animation: shootingStar 8s ease-in-out infinite;
  animation-delay: -2s;
}

@keyframes shootingStar {
  0%      { opacity: 0; transform: rotate(-35deg) translateX(-200rpx); }
  2%      { opacity: 1; }
  6%      { opacity: 0; transform: rotate(-35deg) translateX(800rpx); }
  100%    { opacity: 0; transform: rotate(-35deg) translateX(800rpx); }
}

/* ── Layer 7 — 草原起伏剪影 ────────────────────────────────── */
.grassland {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 120rpx;
  overflow: hidden;
}
.grassland::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: -15%;
  width: 130%;
  height: 100%;
  background: linear-gradient(180deg, #1a0e06, #0d0906);
  border-radius: 80% 120% 0 0 / 70rpx 50rpx 0 0;
}
.grassland::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 15%;
  width: 110%;
  height: 75%;
  background: linear-gradient(180deg, #1a0e06, #0d0906);
  border-radius: 50% 70% 0 0 / 45rpx 55rpx 0 0;
}

/* ── 地平线强化金光 ───────────────────────────────────────── */
.horizon-glow {
  position: absolute;
  width: 100%; height: 35%;
  bottom: 80rpx;
  background: radial-gradient(
    ellipse 90% 50% at 50% 100%,
    rgba(220,170,60,0.18) 0%,
    rgba(180,120,30,0.08) 40%,
    transparent 100%
  );
  pointer-events: none;
}

/* ── 闪烁动画 — 多套不同节奏避免同步 ──────────────────────── */
@keyframes twinkle1 {
  0%   { opacity: 0.6; }
  50%  { opacity: 1; }
  100% { opacity: 0.6; }
}
@keyframes twinkle2 {
  0%   { opacity: 0.7; }
  40%  { opacity: 1; }
  80%  { opacity: 0.55; }
  100% { opacity: 0.7; }
}
@keyframes twinkle3 {
  0%   { opacity: 0.5; }
  30%  { opacity: 0.9; }
  70%  { opacity: 1; }
  100% { opacity: 0.5; }
}

/* 角色立绘 */
.hero-portrait {
  position: absolute;
  bottom: 0;
  height: 75vh;
  width: 45vw;
  z-index: 10;
  -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,1) 60%, rgba(0,0,0,0.7) 80%, rgba(0,0,0,0) 100%);
  mask-image: linear-gradient(to top, rgba(0,0,0,1) 60%, rgba(0,0,0,0.7) 80%, rgba(0,0,0,0) 100%);
  -webkit-mask-position: bottom;
  mask-position: bottom;
  animation: heroBreathe 6s ease-in-out infinite;
}

.hero-left {
  left: 0;
  animation-delay: 0s;
}

.hero-right {
  right: 0;
  animation-delay: -3s;
}

@keyframes heroBreathe {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15rpx); }
}

/* 角色非活动状态 - 半透明+灰度 */
.hero-portrait.inactive {
  opacity: 0.4;
  filter: grayscale(0.8);
  transition: all 0.5s ease;
}

/* 标题区域 */
.guide-title-wrap {
  position: absolute;
  top: 15vh;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 20;
}

.guide-title-main {
  font-size: 72rpx;
  font-weight: 800;
  color: #f5e6c8;
  text-shadow: 0 0 30rpx rgba(212, 175, 55, 0.5), 0 4rpx 20rpx rgba(0, 0, 0, 0.8);
  letter-spacing: 8rpx;
}

.guide-title-sub {
  font-size: 28rpx;
  color: rgba(200, 180, 150, 0.8);
  margin-top: 20rpx;
  letter-spacing: 4rpx;
}

/* 开启入籍 — 星空风格按钮（细圈 + 磨砂玻璃背景） */
.start-btn-wrap {
  position: absolute;
  bottom: 26vh;
  left: 50%;
  transform: translateX(-50%);
  z-index: 30;
  cursor: pointer;
}

/* Outer breathing halo — two concentric rings */
.start-btn-glow {
  position: absolute;
  top: -28rpx;
  left: -28rpx;
  right: -28rpx;
  bottom: -28rpx;
  border: 1rpx solid rgba(196, 154, 60, 0.18);
  border-radius: 50%;
  animation: rimBreath 3s ease-in-out infinite;
}
.start-btn-glow::before {
  content: '';
  position: absolute;
  top: -20rpx;
  left: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  border: 1rpx solid rgba(196, 154, 60, 0.08);
  border-radius: 50%;
  animation: rimBreath 3s ease-in-out infinite;
  animation-delay: -1s;
}

@keyframes rimBreath {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50%       { opacity: 1;   transform: scale(1.03); }
}

.start-btn-inner {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  /* Dark glass — lets starfield show through */
  background: rgba(13, 9, 6, 0.55);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1.5rpx solid rgba(196, 154, 60, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 0 40rpx rgba(196, 154, 60, 0.12),
    inset 0 0 30rpx rgba(196, 154, 60, 0.05);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.start-btn-inner:active {
  border-color: rgba(196, 154, 60, 0.9);
  box-shadow: 0 0 60rpx rgba(196, 154, 60, 0.3), inset 0 0 30rpx rgba(196, 154, 60, 0.1);
}

.start-btn-text {
  font-size: 32rpx;
  font-weight: 500;
  color: rgba(245, 240, 232, 0.92);
  letter-spacing: 6rpx;
  position: relative;
  z-index: 2;
  text-shadow: 0 0 20rpx rgba(196, 154, 60, 0.4);
}

/* ── 国风仪式感 — 按钮内同心环 ─────────────────────────────── */
.btn-inner-ring {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  right: 22rpx;
  bottom: 22rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(196, 154, 60, 0.25);
  pointer-events: none;
  z-index: 1;
}
.btn-inner-ring-2 {
  top: 38rpx;
  left: 38rpx;
  right: 38rpx;
  bottom: 38rpx;
  border-color: rgba(196, 154, 60, 0.12);
}

/* ── 国风角落装饰 ─────────────────────────────────────────── */
.corner-tl, .corner-tr, .corner-bl, .corner-br {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  z-index: 25;
  pointer-events: none;
}
.corner-tl {
  top: 60rpx;
  left: 36rpx;
  border-top: 2rpx solid rgba(196,154,60,0.45);
  border-left: 2rpx solid rgba(196,154,60,0.45);
}
.corner-tr {
  top: 60rpx;
  right: 36rpx;
  border-top: 2rpx solid rgba(196,154,60,0.45);
  border-right: 2rpx solid rgba(196,154,60,0.45);
}
.corner-bl {
  bottom: 160rpx;
  left: 36rpx;
  border-bottom: 2rpx solid rgba(196,154,60,0.45);
  border-left: 2rpx solid rgba(196,154,60,0.45);
}
.corner-br {
  bottom: 160rpx;
  right: 36rpx;
  border-bottom: 2rpx solid rgba(196,154,60,0.45);
  border-right: 2rpx solid rgba(196,154,60,0.45);
}

/* ── 国风标题装饰线 ───────────────────────────────────────── */
.title-deco-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 320rpx;
  margin: 14rpx 0;
}
.deco-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(196,154,60,0.55), transparent);
}
.deco-rhombus {
  width: 10rpx;
  height: 10rpx;
  background: rgba(196,154,60,0.75);
  transform: rotate(45deg);
  flex-shrink: 0;
  box-shadow: 0 0 8rpx rgba(196,154,60,0.4);
}

/* ── 地平线强化金光 ───────────────────────────────────────── */
.horizon-glow {
  position: absolute;
  width: 100%;
  height: 30%;
  bottom: 100rpx;
  background: radial-gradient(
    ellipse 80% 60% at 50% 100%,
    rgba(196,154,60,0.22) 0%,
    rgba(160,110,20,0.12) 40%,
    transparent 100%
  );
  filter: blur(8rpx);
  pointer-events: none;
}

/* 乙游风对话框 */
.dialog-bubble {
  position: absolute;
  bottom: 5vh;
  left: 5vw;
  right: 5vw;
  min-height: 200rpx;
  max-height: 300rpx;
  background: rgba(0, 30, 60, 0.75);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 24rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  padding: 30rpx;
  z-index: 40;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.4);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dialog-content {
  padding: 10rpx 0;
  flex: 1;
}

.dialog-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: rgba(245, 230, 200, 0.95);
}

.dialog-next-hint {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.2);
  cursor: pointer;
}

.hint-text {
  font-size: 28rpx;
  color: rgba(212, 175, 55, 0.9);
  animation: hintBlink 1.5s ease-in-out infinite;
  font-weight: 600;
}

@keyframes hintBlink {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* 以下为旧版引导样式，已弃用但保留 */
