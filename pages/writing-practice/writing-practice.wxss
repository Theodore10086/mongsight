  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(139, 69, 19, 0.1);
  border-radius: 50%;
  border: 1rpx solid #8b4513;
  cursor: pointer;
  transition: all 0.3s;
}

.picker-close:active {
  background: rgba(139, 69, 19, 0.2);
  transform: scale(0.9);
}

.close-icon {
