.challenge-modal,
.result-panel,
.treasure-yurt {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content,
.result-content,
.shop-content {
  width: 92%;
  max-width: 640rpx;
  max-height: 75vh;
  background: linear-gradient(135deg, #faf8f5 0%, #f4f3ea 100%);
  border-radius: 20rpx;
  box-shadow: 
    0 25rpx 100rpx rgba(139, 69, 19, 0.3),
    0 0 0 3rpx #8b4513,
    inset 0 0 0 1rpx rgba(139, 69, 19, 0.1);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: modalIn 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.modal-content::before,
.result-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: 
    radial-gradient(circle at 20% 30%, rgba(139, 69, 19, 0.03) 0%, transparent 40%),
    radial-gradient(circle at 80% 70%, rgba(139, 69, 19, 0.03) 0%, transparent 40%);
  pointer-events: none;
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.95) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

