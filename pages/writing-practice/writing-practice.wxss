.screenshot-flash {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #fff;
  z-index: 2000;
  opacity: 0;
  pointer-events: none;
}

.screenshot-flash.active {
  animation: flashAnim 0.5s ease-out forwards;
}

@keyframes flashAnim {
  0% { opacity: 0; }
  25% { opacity: 1; }
  100% { opacity: 0; }
}

.preview-stage {
  position: fixed;
  top: 0;
  left: 0;
