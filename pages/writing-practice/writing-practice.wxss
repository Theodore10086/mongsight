  height: calc(75vh - 120rpx);
}

.feed-delete-btn {
  margin-left: auto;
  padding: 8rpx 20rpx;
  background: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.feed-empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
  font-size: 28rpx;
}

.feed-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

/* 关注列表样式 */
.follows-list {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.follow-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  gap: 20rpx;
}

.follow-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.follow-avatar-text {
  font-size: 48rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
}

.follow-info {
  flex: 1;
}

.follow-nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.follow-action-btn {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: #667eea;
  color: #fff;
}

.follow-action-btn.following {
  background: #f0f0f0;
  color: #666;
}

.feed-loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.action-item.favorited {
  color: #ff4d4f;
}

/* === 书写练习页：登录与开启入籍引导仅在启动页处理，本页直接进入功能 === */
.login-overlay,
.guide-overlay { display: none !important; }

/* 书写练习页：屏蔽页面内自定义底部 Tab 与"识别/社区/我"区域，避免与原生 tabBar 重复 */
.custom-tabbar { display: none !important; }
.tab-content { display: none !important; }
.daily-overview-card,
.home-section-title,
.recognition-home-section { display: none !important; }
