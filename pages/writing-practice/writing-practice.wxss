}

/* VIP徽章 */
.profile-level-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.vip-badge {
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ff6b00 100%);
  border-radius: 8rpx;
  font-size: 18rpx;
  color: #fff;
  font-weight: 700;
}

/* 权益卡片 */
.privilege-section {
  margin: 0 30rpx 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.privilege-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.privilege-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.privilege-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.privilege-icon {
  font-size: 40rpx;
}

.privilege-text {
  font-size: 20rpx;
  color: #666;
}

.scan-line {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 0%, #00ff88 50%, transparent 100%);
  box-shadow: 0 0 20rpx #00ff88, 0 0 40rpx #00ff88;
  animation: scan 4s linear infinite;
  z-index: 10;
  pointer-events: none;
}

@keyframes scan {
  0% { top: 0; opacity: 1; }
  100% { top: 100%; opacity: 0.3; }
}

/* 社区加载动画 */
.feed-loading {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

/* 社区帖子动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 点赞动画 */
.like-effect {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 107, 107, 0.4) 0%, transparent 70%);
  animation: likePulse 0.6s ease-out;
}

@keyframes likePulse {
  0% { transform: scale(0.5); opacity: 1; }
  100% { transform: scale(2); opacity: 0; }
}

/* 按钮点击波纹效果 */
.menu-item:active::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 0;
}

/* 卡片悬浮阴影 */
.feed-item:active,
.privilege-item:active {
  transform: scale(0.98);
  transition: transform 0.15s ease;
}

/* Tab切换动画 */
.tab-content {
  transition: opacity 0.2s ease;
}

/* 弹窗淡入动画 */
.edit-modal.active .edit-modal-content,
.comment-modal.active .comment-modal-content,
.post-modal.active .post-modal-content {
  animation: modalSlideIn 0.3s ease-out;
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: translateY(50rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 头像点击动画 */
.profile-avatar-edit:active {
  transform: scale(0.95);
}

/* 签到按钮动画 */
.checkin-btn:active {
  transform: scale(0.95);
}

/* 帖子图片渐显 */
.feed-img {
  animation: imageFadeIn 0.3s ease-out;
}

@keyframes imageFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.canvas-zone.tech-mode {
  background: 
    linear-gradient(135deg, #0a0a0a 0%, #0f0f1a 50%, #0a0a12 100%);
}

.canvas-zone.tech-mode::after {
  background: 
    radial-gradient(ellipse at 20% 80%, rgba(0, 255, 136, 0.05) 0%, transparent 40%),
    radial-gradient(ellipse at 80% 20%, rgba(0, 200, 255, 0.05) 0%, transparent 40%),
    linear-gradient(0deg, transparent 24%, rgba(0, 255, 136, 0.03) 25%, rgba(0, 255, 136, 0.03) 26%, transparent 27%, transparent 74%, rgba(0, 255, 136, 0.03) 75%, rgba(0, 255, 136, 0.03) 76%, transparent 77%, transparent),
    linear-gradient(90deg, transparent 24%, rgba(0, 255, 136, 0.03) 25%, rgba(0, 255, 136, 0.03) 26%, transparent 27%, transparent 74%, rgba(0, 255, 136, 0.03) 75%, rgba(0, 255, 136, 0.03) 76%, transparent 77%, transparent);
