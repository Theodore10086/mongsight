/* ============================================================ */

page {
  height: 100vh;
  overflow: hidden;
  background: #f5f0e8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.canvas-zone {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.canvas-zone::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: -1;
}

.canvas-zone.skin-xuan {
  background: 
    linear-gradient(135deg, rgba(250, 248, 245, 0.95) 0%, rgba(240, 235, 227, 0.95) 100%),
    url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
}

.canvas-zone.skin-cao {
  background: 
    linear-gradient(135deg, rgba(232, 220, 200, 0.95) 0%, rgba(212, 196, 168, 0.95) 100%),
    url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
}

.canvas-zone.skin-gold {
  background-color: #f4f3ea; /* 米白底 */
  background-image: 
    radial-gradient(#c49a3c 1.5px, transparent 1.5px), 
    radial-gradient(#c49a3c 1px, transparent 1px);
  background-size: 60px 60px, 40px 40px;
  background-position: 0 0, 30px 30px;
}

.template-layer {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: auto;
  opacity: 0;
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
  filter: blur(0px);
  padding: 20rpx;
  box-sizing: border-box;
}

.template-layer.visible {
  opacity: 0.5;
  filter: blur(0.5px);
}

.collection-bg-image {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: auto;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
  z-index: 1;
}

.collection-bg-image.visible {
  opacity: 0.3;
}

.main-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 100;
  pointer-events: auto;
}

.canvas-area {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 100;
  pointer-events: auto;
}

.top-bar {
  position: fixed;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 250;
  width: 94%;
  max-width: 720rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sidebar-trigger {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(250, 247, 242, 0.95);
  border-radius: 50%;
  border: 1rpx solid rgba(28, 20, 16, 0.1);
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.sidebar-trigger:active {
  transform: scale(0.92);
}

.trigger-icon {
  width: 36rpx;
  height: 36rpx;
}

.user-pill {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 20rpx 10rpx 12rpx;
  background: rgba(250, 247, 242, 0.95);
  border-radius: 50rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.1);
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.user-avatar-small {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background: linear-gradient(135deg, #c49a3c 0%, #b8882a 100%);
  border-radius: 50%;
  position: relative;
  overflow: hidden;
}

.user-avatar-small image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-avatar-small::after {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  right: 2rpx;
  height: 40%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.4) 0%, transparent 100%);
  border-radius: 50% 50% 0 0;
}

.user-meta {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.user-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

.user-rank {
  font-size: 18rpx;
  color: #888;
  font-weight: 400;
}

.ink-jade-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  background: rgba(28, 20, 16, 0.08);
  border-radius: 16rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.14);
}

.jade-icon {
  font-size: 18rpx;
}

.jade-count {
  font-size: 22rpx;
  font-weight: 700;
  color: #1c1410;
}

.template-modules {
  position: fixed;
  top: 100rpx;
  right: 20rpx;
  z-index: 160;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  opacity: 0;
  transform: translateX(50rpx);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.template-modules.visible {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}

.tools-row {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

.floating-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 22rpx;
  background: rgba(250, 247, 242, 0.95);
  border-radius: 40rpx;
  border: 1rpx solid rgba(28, 20, 16, 0.1);
  cursor: pointer;
  transition: opacity 0.2s ease;
  position: relative;
  z-index: 260;
}

.floating-pill:active {
  opacity: 0.6;
}

.floating-pill.active {
  background: linear-gradient(135deg, #c49a3c 0%, #b8882a 100%);
  border-color: transparent;
  box-shadow: 0 3rpx 14rpx rgba(196, 154, 60, 0.38);
}

.floating-pill.active .pill-text {
  color: #1c1410;
}

.floating-pill.active .pill-icon {
  color: #1c1410;
}

.pill-icon {
  font-size: 28rpx;
  position: relative;
  z-index: 1;
}

.pill-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #2a2a2a;
  position: relative;
  z-index: 1;
}

.coordinate-fab {
  position: fixed;
  left: 18rpx;
  top: 38%;
  z-index: 180;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #c49a3c 0%, #b8882a 100%);
  border-radius: 20rpx;
  cursor: pointer;
  transition: opacity 0.2s ease;
  overflow: hidden;
}

.coordinate-fab .fab-icon {
  font-size: 36rpx;
}

.coordinate-fab .fab-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  position: relative;
  z-index: 1;
}

.coordinate-fab:active {
  transform: scale(0.92);
}

.fab-icon {
  font-size: 36rpx;
}

@keyframes rotate {
  100% { transform: rotate(360deg); }
}

.fab-icon {
  font-size: 52rpx;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2));
}

.fab-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #1c1410;
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
}

.elegant-sidebar {
  position: fixed;
  left: -420rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 170;
  width: 400rpx;
  max-height: 75vh;
  background: #faf7f2;
  border-radius: 0 24rpx 24rpx 0;
  box-shadow: 8rpx 0 40rpx rgba(28, 20, 16, 0.1);
  border-right: 1rpx solid rgba(28, 20, 16, 0.08);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  display: flex;
}

.elegant-sidebar.expanded {
  left: 0;
}

.sidebar-content {
  flex: 1;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  overflow-y: auto;
}

.sidebar-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.section-title {
  font-size: 18rpx;
  font-weight: 600;
  color: #999;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  padding-left: 8rpx;
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 16rpx;
  background: #c49a3c;
  border-radius: 2rpx;
}

.quick-actions {
  display: flex;
  gap: 10rpx;
  position: relative;
  z-index: 10;
}

.action-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 12rpx;
  background: linear-gradient(135deg, rgba(245, 245, 245, 0.9) 0%, rgba(235, 235, 235, 0.9) 100%);
  border-radius: 20rpx;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  z-index: 10;
}

.action-chip::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.6) 0%, transparent 100%);
  pointer-events: none;
}

.action-chip:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
  background: linear-gradient(135deg, #fff 0%, #f8f8f8 100%);
}

.action-chip:active {
  transform: scale(0.96);
  transition: all 0.1s;
}

.chip-icon {
  font-size: 32rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.chip-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #444;
}

.paper-selector {
  display: flex;
  gap: 10rpx;
}

.paper-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 10rpx;
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.paper-option::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(28, 20, 16, 0.1) 0%, rgba(28, 20, 16, 0.1) 100%);
  opacity: 0;
  transition: opacity 0.3s;
}

.paper-option.active::before {
  opacity: 1;
}

.paper-option.active {
  box-shadow: 0 4rpx 20rpx rgba(28, 20, 16, 0.2);
}

.paper-preview {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  box-shadow: 
    0 3rpx 10rpx rgba(0, 0, 0, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
  position: relative;
  overflow: hidden;
}

.paper-preview::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 40%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, transparent 100%);
  border-radius: 12rpx 12rpx 0 0;
}

.paper-preview.xuan {
  background: linear-gradient(135deg, #faf8f5 0%, #f4f1ea 100%);
}

.paper-preview.cao {
  background: linear-gradient(135deg, #e8dcc8 0%, #d4c4a8 100%);
}

.paper-preview.gold {
  background: linear-gradient(135deg, #faf6e8 0%, #f0e6c8 100%);
  background-image: 
    radial-gradient(circle at 20% 30%, rgba(212, 175, 55, 0.25) 0%, transparent 30%),
    radial-gradient(circle at 80% 70%, rgba(212, 175, 55, 0.25) 0%, transparent 30%),
    radial-gradient(circle at 50% 50%, rgba(218, 165, 32, 0.15) 0%, transparent 40%),
    radial-gradient(circle at 30% 80%, rgba(255, 215, 0, 0.2) 0%, transparent 25%),
    radial-gradient(circle at 70% 20%, rgba(255, 215, 0, 0.2) 0%, transparent 25%);
}

.paper-option text {
  font-size: 16rpx;
  color: #666;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.paper-option.active text {
  color: #1c1410;
  font-weight: 600;
}

/* --- 笔刷粗细调节器样式 --- */
.pen-settings-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.size-slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.size-label {
  font-size: 16rpx;
  color: #999;
  font-weight: 600;
  min-width: 40rpx;
}

.size-slider-row slider {
  flex: 1;
  margin: 0;
}

.current-size-dot {
  border-radius: 50%;
  transition: all 0.2s ease;
  box-shadow: 
    0 2rpx 8rpx rgba(0, 0, 0, 0.3),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.color-swatches {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  position: relative;
  z-index: 1;
  overflow: hidden;
}

.color-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx;
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  z-index: 1;
  overflow: hidden;
  isolation: isolate;
}

.color-option::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(28, 20, 16, 0.1) 0%, rgba(28, 20, 16, 0.1) 100%);
  opacity: 0;
  transition: opacity 0.3s;
  border-radius: 16rpx;
  pointer-events: none;
}

.color-option.active::before {
  opacity: 1;
}

.color-option.active {
  box-shadow: 0 2rpx 10rpx rgba(28, 20, 16, 0.2);
}

.color-swatch {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  box-shadow: 
    0 2rpx 6rpx rgba(0, 0, 0, 0.15),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.1),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.3);
  position: relative;
  z-index: 1;
}

.color-swatch::after {
  content: '';
  position: absolute;
  top: 3rpx;
  left: 10%;
  width: 80%;
  height: 40%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.6) 0%, transparent 100%);
  border-radius: 50%;
}

.color-option:hover {
  transform: scale(1.05);
}

.color-option.active .color-swatch {
  transform: scale(1.1);
  box-shadow: 
    0 0 0 3rpx #fff,
    0 3rpx 15rpx rgba(28, 20, 16, 0.4),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.1),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.3);
}

.color-name {
  font-size: 16rpx;
  color: #666;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.color-option.active .color-name {
  color: #1c1410;
  font-weight: 600;
}

.assist-actions {
  display: flex;
  gap: 12rpx;
}

.assist-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 12rpx;
  background: linear-gradient(135deg, rgba(245, 245, 245, 0.9) 0%, rgba(235, 235, 235, 0.9) 100%);
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.assist-chip::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, transparent 100%);
  pointer-events: none;
}

.assist-chip:hover {
  transform: translateY(-3rpx);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
}

.assist-chip.active {
  background: linear-gradient(135deg, rgba(28, 20, 16, 0.15) 0%, rgba(28, 20, 16, 0.15) 100%);
  box-shadow: 0 4rpx 15rpx rgba(28, 20, 16, 0.2);
}

.assist-icon {
  font-size: 28rpx;
}

.assist-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #444;
}

.assist-chip.active .assist-text {
  color: #1c1410;
}

.reverse-menu {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 10rpx;
  padding: 12rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(250, 250, 250, 0.95) 100%);
  border-radius: 16rpx;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10rpx);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.reverse-menu.open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.reverse-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, rgba(245, 245, 245, 0.9) 0%, rgba(235, 235, 235, 0.9) 100%);
  border-radius: 12rpx;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.reverse-option:hover {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(245, 245, 245, 0.95) 100%);
  transform: scale(1.02);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.reverse-option-icon {
  font-size: 24rpx;
}

.reverse-option-text {
  font-size: 16rpx;
  font-weight: 600;
  color: #444;
}

.sidebar-footer {
  display: flex;
  gap: 10rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.footer-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 12rpx;
  background: linear-gradient(135deg, rgba(248, 248, 248, 0.9) 0%, rgba(240, 240, 240, 0.9) 100%);
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.footer-chip:hover {
  background: linear-gradient(135deg, rgba(245, 245, 245, 0.9) 0%, rgba(235, 235, 235, 0.9) 100%);
  transform: translateY(-2rpx);
}

.footer-chip.active {
  background: linear-gradient(135deg, #c49a3c10 0%, #c49a3c10 0%, #1c141010 100%);
}

.footer-chip.framing-chip:hover {
  background: linear-gradient(135deg, rgba(28, 20, 16, 0.15) 0%, rgba(28, 20, 16, 0.15) 100%);
}

.footer-chip .chip-text {
  font-size: 18rpx;
  font-weight: 500;
}

.footer-chip.coordinate-chip {
  background: linear-gradient(135deg, #0a1628 0%, #1a2744 100%);
  border: 1rpx solid rgba(212, 175, 55, 0.35);
  box-shadow: 
    0 2rpx 8rpx rgba(0, 0, 0, 0.3),
    inset 0 0 20rpx rgba(212, 175, 55, 0.05);
  position: relative;
  overflow: hidden;
}

.footer-chip.coordinate-chip::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at center, rgba(212, 175, 55, 0.15) 0%, transparent 70%);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.footer-chip.coordinate-chip:hover::before {
  opacity: 1;
}

.footer-chip.coordinate-chip:hover {
  border-color: rgba(212, 175, 55, 0.6);
  box-shadow: 
    0 4rpx 16rpx rgba(0, 0, 0, 0.4),
    0 0 30rpx rgba(212, 175, 55, 0.2),
    inset 0 0 30rpx rgba(212, 175, 55, 0.08);
  transform: translateY(-2rpx);
}

.footer-chip.coordinate-chip:active {
  transform: translateY(0rpx);
  box-shadow: 
    0 2rpx 8rpx rgba(0, 0, 0, 0.3),
    0 0 20rpx rgba(212, 175, 55, 0.15);
}

.footer-chip.coordinate-chip .chip-icon {
  font-size: 24rpx;
}

.footer-chip.coordinate-chip .chip-text {
  color: #c49a3c;
  font-size: 18rpx;
  font-weight: 500;
}

.sidebar-handle {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0.95) 100%);
  border-radius: 0 20rpx 20rpx 0;
  cursor: pointer;
  transition: all 0.3s;
  box-shadow: 3rpx 0 15rpx rgba(0, 0, 0, 0.05);
}

.sidebar-handle:hover {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 1) 100%);
}

.sidebar-handle:hover .handle-icon {
  color: #1c1410;
  transform: scale(1.1);
}

.handle-icon {
  font-size: 24rpx;
  color: #aaa;
  transition: all 0.3s;
}



/* --- 胶囊式悬浮窗样式 --- */
.tips-movable-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 20;
  pointer-events: none; /* 让点击事件穿透到画布 */
}

.guide-capsule {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: rgba(0, 0, 0, 0.6); /* 半透明黑底 */
  border-radius: 30rpx; /* 胶囊形状 */
  min-width: 60rpx; /* 防止收起时太小 */
  max-width: 60%; /* 防止文字太长挡屏 */
  transition: width 0.3s ease, background 0.3s ease;
  pointer-events: auto; /* 只有提示框本身可交互 */
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 折叠态：只显示灯泡图标 */
.guide-capsule.collapsed {
  width: 60rpx;
  justify-content: center;
}

/* 展开态：横向展开显示文字 */
.guide-capsule.expanded {
  width: auto;
}

.guide-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-icon-glyph {
  width: 28rpx;
  height: 28rpx;
}

.guide-capsule.collapsed .guide-icon {
  margin-right: 0;
}

.guide-text {
  font-size: 24rpx;
  color: #fff; /* 白色文字 */
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.app-footer {
  position: fixed;
  bottom: 6rpx;
  left: 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  z-index: 50;
}

.footer-brand {
  font-size: 16rpx;
  font-weight: 600;
  color: rgba(150, 150, 150, 0.6);
  letter-spacing: 3rpx;
}

.footer-version {
  font-size: 12rpx;
  padding: 3rpx 10rpx;
  background: rgba(200, 200, 200, 0.2);
  border-radius: 8rpx;
  color: rgba(120, 120, 120, 0.6);
}

/* 底部 TabBar */
.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 1000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  position: relative;
}

.tab-icon {
  font-size: 40rpx;
  transition: transform 0.2s ease;
}

.tab-item.active .tab-icon {
  transform: scale(1.1);
}

.tab-name {
  font-size: 22rpx;
  color: #999;
  transition: color 0.2s ease;
}

.tab-item.active .tab-name {
  color: #1c1410;
  font-weight: 600;
}

/* 主内容区域 */
.main-content {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 100rpx;
  overflow: hidden;
  z-index: 40;
}

.tab-content {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 100rpx;
  z-index: 50;
}

.tab-panel {
  display: none;
  height: 100%;
  overflow-y: auto;
  background: #f5f5f5;
}

.tab-panel.active {
  display: block;
}

/* 编辑弹窗样式 */
.edit-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.edit-modal.active {
  visibility: visible;
  opacity: 1;
}

.edit-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.edit-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.edit-modal.active .edit-modal-content {
  transform: translateY(0);
}

.edit-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.edit-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.edit-modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.avatar-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.avatar-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 60rpx;
  border: 4rpx solid transparent;
  transition: all 0.2s ease;
  overflow: hidden;
}

.avatar-option.active {
  border-color: rgba(28, 20, 16, 0.25);
  background: #f0f4ff;
}

.avatar-option image {
  width: 100%;
  height: 100%;
}

.avatar-emoji {
  font-size: 60rpx;
}

.upload-avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 30rpx 0;
  padding: 24rpx;
  background: linear-gradient(135deg, #c49a3c 0%, #b8882a 100%);
  border-radius: 16rpx;
}

.upload-icon {
  font-size: 36rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.selected-avatar-preview {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.preview-label {
  font-size: 26rpx;
  color: #666;
}

.preview-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  border: 2rpx solid #ddd;
}

.edit-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  margin-bottom: 40rpx;
}

.edit-modal-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #c49a3c 0%, #b8882a 100%);
  color: #1c1410;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 头像编辑样式 */
.profile-avatar-edit {
  position: relative;
  display: inline-block;
}

.avatar-edit-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #c49a3c 0%, #b8882a 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}

.profile-nickname-edit {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.edit-icon {
  font-size: 24rpx;
}

/* 社区样式 */
.community-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.community-title {
  font-size: 36rpx;
  font-weight: 700;
}

.post-btn {
  padding: 12rpx 32rpx;
  background: rgba(245, 240, 232, 0.12);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 30rpx;
  border: 1rpx solid rgba(245, 240, 232, 0.2);
  position: relative;
  z-index: 2;
}

.post-btn:active {
  background: rgba(245, 240, 232, 0.22);
}

.post-btn text {
  font-size: 26rpx;
  color: rgba(245, 240, 232, 0.9);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.community-feed {
  flex: 1;
  padding: 20rpx;
}

.feed-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.feed-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.feed-avatar {
  font-size: 48rpx;
}

.feed-nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.feed-user-info {
  display: flex;
  flex-direction: column;
}

.feed-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.feed-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.feed-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.feed-img {
  width: 160rpx;
  height: 160rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.feed-actions {
  display: flex;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.feed-actions .action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #999;
  position: relative;
}

.feed-actions .action-item.liked {
  color: #c49a3c;
}

.action-icon {
  font-size: 28rpx;
}

.action-count {
  font-size: 24rpx;
}

.like-effect {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 60rpx;
  height: 60rpx;
  margin: -30rpx 0 0 -30rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(196, 154, 60, 0.4) 0%, transparent 70%);
  animation: likeBurst 0.6s ease-out forwards;
  pointer-events: none;
}

@keyframes likeBurst {
  0% {
    transform: scale(0.5);
    opacity: 1;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
