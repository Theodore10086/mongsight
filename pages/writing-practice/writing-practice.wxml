        </view>
      </view>
      <view class="feed-more" wx:if="{{!hasMoreMyLikes && myLikes.length > 0}}">
        <text>没有更多了</text>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 我的收藏弹窗 -->
<view class="my-works-modal {{showMyCollectionsModal ? 'active' : ''}}" wx:if="{{showMyCollectionsModal}}">
  <view class="my-works-mask" bindtap="onCloseMyCollectionsModal"></view>
  <view class="my-works-content">
    <view class="my-works-header">
      <text class="my-works-title">我的收藏</text>
      <text class="my-works-close" bindtap="onCloseMyCollectionsModal">✕</text>
    </view>
    <scroll-view scroll-y class="community-feed my-posts-feed" bindscrolltolower="onLoadMoreMyCollections">
      <view class="feed-loading" wx:if="{{isLoadingMyFavorites}}">
        <text>加载中...</text>
      </view>
      <view class="feed-empty" wx:if="{{!isLoadingMyFavorites && myCollections.length === 0}}">
        <text>还没有收藏，快去社区收藏喜欢的帖子吧~</text>
      </view>
      <view class="feed-item" wx:for="{{myCollections}}" wx:key="id" style="animation: fadeInUp {{index * 0.05}}s ease-out;">
        <view class="feed-user">
          <image class="community-avatar" wx:if="{{item.avatarIsImage}}" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <text class="feed-avatar community-avatar-text" wx:else>{{item.avatarText || item.avatar}}</text>
          <view class="feed-user-info">
            <text class="feed-nickname">{{item.nickname}}</text>
            <text class="feed-time" wx:if="{{item.create_time_str}}">{{item.create_time_str}}</text>
          </view>
        </view>
        <view class="feed-content">{{item.content}}</view>
        <view class="feed-images" wx:if="{{item.images && item.images.length}}">
          <image class="feed-img" wx:for="{{item.images}}" wx:key="*this" src="{{item}}" mode="aspectFill"></image>
        </view>
        <view class="feed-actions">
          <view class="action-item {{item.liked ? 'liked' : ''}}" data-id="{{item.id}}" bindtap="onLikePost">
            <view class="action-icon {{item.liked ? 'icon-like-filled' : 'icon-like-outline'}}"></view>
            <text class="action-count">{{item.likes}}</text>
          </view>
          <view class="action-item" data-id="{{item.id}}" bindtap="onOpenComment">
            <view class="action-icon icon-comment-outline"></view>
            <text class="action-count">{{item.comments}}</text>
          </view>
          <view class="action-item favorited" data-id="{{item.id}}" bindtap="onToggleFavorite">
            <view class="action-icon icon-favorite-filled"></view>
            <text class="action-count">已收藏</text>
          </view>
        </view>
      </view>
      <view class="feed-more" wx:if="{{!hasMoreMyFavorites && myCollections.length > 0}}">
        <text>没有更多了</text>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 我的关注弹窗 -->
<view class="my-works-modal {{showFollowsModal ? 'active' : ''}}" wx:if="{{showFollowsModal}}">
  <view class="my-works-mask" bindtap="onCloseFollowsModal"></view>
  <view class="my-works-content">
    <view class="my-works-header">
      <text class="my-works-title">我的关注</text>
      <text class="my-works-close" bindtap="onCloseFollowsModal">✕</text>
    </view>
    <scroll-view scroll-y class="follows-list">
      <view class="feed-loading" wx:if="{{isLoadingFollows}}">
        <text>加载中...</text>
      </view>
      <view class="feed-empty" wx:if="{{!isLoadingFollows && myFollows.length === 0}}">
        <text>还没有关注任何人，快去社区关注吧~</text>
      </view>
      <view class="follow-item" wx:for="{{myFollows}}" wx:key="id">
        <image class="follow-avatar" wx:if="{{item.targetAvatar.startsWith('http')}}" src="{{item.targetAvatar}}" mode="aspectFill"></image>
        <text class="follow-avatar-text" wx:else>{{item.targetAvatar || '👤'}}</text>
        <view class="follow-info">
          <text class="follow-nickname">{{item.targetNickname}}</text>
        </view>
        <view class="follow-action-btn following" data-openid="{{item.targetOpenId}}" bindtap="onFollowUser">已关注</view>
      </view>
      <view class="feed-more" wx:if="{{!hasMoreFollows && myFollows.length > 0}}">
        <text>没有更多了</text>
      </view>
    </scroll-view>
  </view>
</view>

