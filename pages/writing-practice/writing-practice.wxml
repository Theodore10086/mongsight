<!-- 蒙宝AI打分弹窗 -->
<view class="scoring-modal {{showScoringModal ? 'active' : ''}}" wx:if="{{showScoringModal}}">
  <view class="scoring-overlay" bindtap="onCloseScoringModal"></view>
  <view class="scoring-content">
    <view class="scoring-header">
      <image class="scoring-avatar" src="/assets/images/mengbao.jpg" mode="aspectFill"></image>
      <view class="scoring-title-wrap">
        <text class="scoring-title">蒙宝AI评分</text>
        <text class="scoring-subtitle">{{scoringPhase === 'select' ? '选择评分方式' : scoringPhase === 'loading' ? '蒙宝评分中...' : '书法鉴赏报告'}}</text>
      </view>
      <view class="scoring-close" bindtap="onCloseScoringModal">✕</view>
    </view>

    <!-- 阶段一：选择打分方式 -->
    <view class="scoring-body" wx:if="{{scoringPhase === 'select'}}">
      <view class="scoring-method-hint">两种方式任意一种达到 <text class="scoring-method-highlight">90分</text> 即可提交</view>
      <view class="scoring-method-btns">
        <view class="scoring-method-btn" bindtap="onSelectTrajectoryScoring">
          <view class="zm-icon zm-icon-pencil zm-icon-gold-dark method-glyph"></view>
          <text class="method-name">轨迹打分</text>
          <text class="method-desc">比对书写轨迹{{'\n'}}笔顺 · 结构 · 流畅</text>
        </view>
        <view class="scoring-method-btn visual" bindtap="onSelectVisualScoring">
          <view class="zm-icon zm-icon-camera zm-icon-secondary method-glyph"></view>
          <text class="method-name">视觉打分</text>
          <text class="method-desc">对比字形外观{{'\n'}}形态 · 轮廓 · 相似度</text>
        </view>
      </view>
      <view class="scoring-footer">
        <button class="scoring-btn secondary" bindtap="onCloseScoringModal">取消</button>
      </view>
    </view>

    <!-- 阶段二：加载中 -->
    <view class="scoring-body scoring-loading-body" wx:if="{{scoringPhase === 'loading'}}">
      <view class="scoring-loading-ring"></view>
      <text class="scoring-loading-text">蒙宝正在评分，请稍候...</text>
    </view>

    <!-- 阶段三：评分结果 -->
    <view wx:if="{{scoringPhase === 'result'}}">
      <view class="scoring-body">
        <view class="score-method-tag {{scoringDetail.method === 'visual' ? 'visual' : ''}}">
          <view class="zm-icon {{scoringDetail.method === 'visual' ? 'zm-icon-camera zm-icon-secondary' : 'zm-icon-pencil zm-icon-gold-dark'}} score-method-tag-glyph"></view>
          <text>{{scoringDetail.method === 'visual' ? '视觉打分' : '轨迹打分'}}</text>
        </view>
        <view class="score-circle">
          <view class="score-circle-inner">
            <text class="score-value">{{scoringDetail.totalScore}}</text>
            <text class="score-label">分</text>
          </view>
          <view class="score-ring"></view>
        </view>

        <view class="score-detail">
          <view class="score-item">
            <text class="score-item-label">结构</text>
            <view class="score-bar-wrap">
              <view class="score-bar" style="width: {{scoringDetail.structureScore}}%"></view>
            </view>
            <text class="score-item-value">{{scoringDetail.structureScore}}</text>
          </view>
          <view class="score-item">
            <text class="score-item-label">流畅</text>
            <view class="score-bar-wrap">
              <view class="score-bar fluency" style="width: {{scoringDetail.fluencyScore}}%"></view>
            </view>
            <text class="score-item-value">{{scoringDetail.fluencyScore}}</text>
          </view>
          <view class="score-item">
            <text class="score-item-label">笔韵</text>
            <view class="score-bar-wrap">
              <view class="score-bar rhythm" style="width: {{scoringDetail.rhythmScore}}%"></view>
            </view>
            <text class="score-item-value">{{scoringDetail.rhythmScore}}</text>
          </view>
        </view>

        <view class="score-feedback">
          <view class="feedback-icon icon-feedback-chat"></view>
          <text class="feedback-text">{{scoringDetail.feedback}}</text>
        </view>

        <view class="score-stats">
          <text class="stats-text">笔画数: {{scoringDetail.strokeCount}}</text>
          <text class="stats-text {{lastScoringScore >= 90 ? 'stats-pass' : 'stats-fail'}}">
            {{lastScoringScore >= 90 ? '✓ 已达提交标准' : '未达90分，可换方式重试'}}
          </text>
        </view>
      </view>

      <view class="scoring-footer">
        <button class="scoring-btn secondary" bindtap="onBackToScoringSelect">换个方式</button>
        <button class="scoring-btn primary" bindtap="onToggleMemoryBox">查看回放</button>
      </view>
    </view>

  </view>
</view>

