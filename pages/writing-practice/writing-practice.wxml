<!-- 2/3 屏预览舞台 -->
<view class="preview-stage {{showPreviewModal ? 'active' : ''}}" wx:if="{{showPreviewModal}}" catchtouchmove="preventTouch">
  <view class="preview-mask" bindtap="onUndoPreview"></view>
  
  <view class="preview-container">
    <view class="preview-content-box" id="previewBox">
      <image class="preview-image" src="{{previewImageSrc}}" mode="aspectFit"></image>
      
      <!-- 自由拖拽印章区域 -->
      <movable-area class="seal-movable-area">
        <movable-view 
          class="seal-movable-view" 
          direction="all" 
          x="{{sealX}}" 
          y="{{sealY}}" 
          out-of-bounds="{{false}}"
          bindchange="onSealDrag"
        >
          <view class="seal-inner">
            <text class="seal-text">{{sealText}}</text>
          </view>
        </movable-view>
      </movable-area>
    </view>
  </view>

  <!-- 底部控制栏 -->
  <view class="preview-footer-bar">
    <view class="footer-btn-item undo" bindtap="onUndoPreview">
      <view class="btn-circle">
        <text class="btn-icon">↩</text>
      </view>
      <text class="btn-label">撤销</text>
    </view>
    
    <view class="footer-btn-item save" bindtap="onConfirmSave">
      <view class="btn-circle primary">
        <text class="btn-icon">✓</text>
      </view>
      <text class="btn-label">保存作品</text>
    </view>
  </view>
</view>
