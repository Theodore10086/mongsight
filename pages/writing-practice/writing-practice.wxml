<!-- 登录/授权界面 -->
<view class="login-overlay {{identityState === 'UNAUTH' ? 'active' : ''}}" wx:if="{{identityState === 'UNAUTH'}}">
  <!-- 同款银河星空背景 -->
  <view class="starfield-bg login-starfield">
    <view class="stars"></view>
    <view class="stars-mid"></view>
    <view class="stars-near"></view>
    <view class="milky-way"></view>
    <view class="nebula"></view>
    <view class="horizon-glow"></view>
    <view class="grassland"></view>
  </view>

  <view class="login-container">
    <!-- 顶部品牌区 -->
    <view class="login-logo">
      <view class="logo-emblem icon-logo-emblem"></view>
      <view class="login-title-deco">
        <view class="login-deco-line"></view>
        <text class="app-title">智墨穿梭</text>
        <view class="login-deco-line"></view>
      </view>
      <text class="app-subtitle">蒙古文书法学习之旅</text>
    </view>

    <!-- 吉祥物与欢迎语 -->
    <view class="login-character">
      <view class="character-silhouette icon-char-sheep"></view>
      <view class="character-speech">
        <text class="speech-text">赛奴！欢迎来到蒙古文书法的世界~</text>
      </view>
    </view>

    <!-- 头像 + 昵称 -->
    <view class="profile-setup">
      <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{loginAvatar}}" src="{{loginAvatar}}" class="avatar-preview" mode="aspectFill"/>
        <view wx:else class="avatar-placeholder">
          <text class="avatar-placeholder-text">＋ 选择头像</text>
        </view>
      </button>
      <input
        class="nickname-input"
        type="nickname"
        placeholder="输入你的昵称"
        value="{{loginNickname}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
    </view>

    <!-- 主要登录按钮 -->
    <button class="login-btn" bindtap="onWechatLogin">
      <text class="btn-text">进入书法世界</text>
    </button>

    <!-- 分隔线 -->
    <view class="login-or-row">
      <view class="or-line"></view>
      <text class="or-text">或</text>
      <view class="or-line"></view>
    </view>

    <!-- 先体验一下 — 显眼的次级按钮 -->
    <view class="login-skip-btn" bindtap="onSkipLogin">
      <text class="skip-btn-text">先体验一下</text>
      <text class="skip-arrow">→</text>
    </view>

    <view class="login-tips">
      <text class="tips-text">登录后可保存作品、查看学习进度</text>
    </view>
  </view>
</view>

<!-- 已登录但未完成引导 - 高级感重塑 -->
<view class="guide-overlay {{identityState !== 'UNAUTH' && !hasGuided ? 'active' : ''}}" wx:if="{{identityState !== 'UNAUTH' && !hasGuided}}">
  <!-- 星空草原背景 -->
  <view class="starfield-bg">
    <view class="stars"></view>
    <view class="stars-mid"></view>
    <view class="stars-near"></view>
    <view class="milky-way"></view>
    <view class="nebula"></view>
    <view class="horizon-glow"></view>
    <view class="grassland"></view>
  </view>

  <!-- 国风角落装饰 -->
  <view class="corner-tl"></view>
  <view class="corner-tr"></view>
  <view class="corner-bl"></view>
  <view class="corner-br"></view>

  <!-- 标题 -->
  <view class="guide-title-wrap">
    <!-- 上装饰线 -->
    <view class="title-deco-row">
      <view class="deco-line"></view>
      <view class="deco-rhombus"></view>
      <view class="deco-line"></view>
    </view>
    <text class="guide-title-main">智墨穿梭</text>
    <!-- 下装饰线 -->
    <view class="title-deco-row">
      <view class="deco-line"></view>
      <view class="deco-rhombus"></view>
      <view class="deco-line"></view>
    </view>
    <text class="guide-title-sub">开启你的草原书法之旅</text>
  </view>

  <!-- 国风仪式感按钮 -->
  <view class="start-btn-wrap" catchtap="onAuthTap">
    <view class="start-btn-glow"></view>
    <view class="start-btn-inner">
      <view class="btn-inner-ring"></view>
      <view class="btn-inner-ring btn-inner-ring-2"></view>
      <text class="start-btn-text">开启入籍</text>
    </view>
  </view>
  
  <!-- 引导选择按钮 - 点击开启入籍后显示 -->
  <view class="guide-choice-wrap {{showGuideChoice ? 'active' : ''}}" wx:if="{{showGuideChoice}}">
    <view class="guide-choice-btns">
      <view class="guide-choice-btn guide-choice-skip" bindtap="onSkipGuide">
        <text>跳过引导</text>
      </view>
      <view class="guide-choice-btn guide-choice-start" bindtap="onStartGuide">
        <text>开始探索</text>
      </view>
    </view>
  </view>
</view>

<!-- 主内容区域（首页 Tab） -->
<view class="main-content">
  
  <!-- 科技模式 HUD 显示区 -->
  <view class="ai-hud" wx:if="{{isTechMode && currentTab === 0}}">
    <view class="hud-item">
      <text class="label">STATUS</text>
      <text class="value highlight">{{playbackStatus}}</text>
    </view>
    <view class="hud-item">
      <text class="label">VELOCITY</text>
      <text class="value">{{playbackSpeed}} cm/s</text>
    </view>
    <view class="hud-item">
      <text class="label">PRESSURE</text>
      <text class="value">{{playbackPressure}}</text>
    </view>
    <view class="hud-item">
      <text class="label">TIME</text>
      <text class="value">{{playbackTime}} ms</text>
    </view>
  </view>

</view>

<view class="top-bar" wx:if="{{currentTab === 0}}">
  <view class="sidebar-trigger" bindtap="onToggleLeftSidebar">
    <view class="trigger-icon icon-menu"></view>
  </view>
  <view class="user-pill" bindtap="onToggleUserStatus">
    <image class="user-avatar-small" wx:if="{{userProfile.avatarUrl && !avatarOptions.includes(userProfile.avatarUrl)}}" src="{{userProfile.avatarUrl}}" mode="aspectFill"></image>
    <view class="user-avatar-small" wx:else>{{userProfile.avatarUrl || userProfile.avatar || '🎨'}}</view>
    <view class="user-meta">
      <text class="user-name">{{userProfile.nickName || userProfile.nickname || '墨客'}}</text>
      <text class="user-rank">Lv.{{userProfile.level}} · {{userProfile.title}}</text>
    </view>
    <view class="ink-jade-pill">
      <text class="jade-count">{{userProfile.inkJades}} 砚</text>
    </view>
  </view>
</view>

<view class="template-modules visible" hidden="{{!(currentTab === 0) || show3DView || showLeftSidebar || showCollectionSetup || showCollectionRecords || showCoordinateModal || showPreviewModal}}">
  <view class="tools-row">
    <view class="floating-pill ai-pill {{isTechMode ? 'active' : ''}}" bindtap="onOpenMengbaoPanel">
      <view class="pill-icon {{isTechMode ? 'icon-pill-art' : 'icon-pill-ai'}}"></view>
      <text class="pill-text">蒙宝</text>
    </view>
    <view wx:if="{{currentLesson.id !== 'collectionLab'}}" class="floating-pill audio-pill {{isPlaying ? 'active' : ''}}" bindtap="onPlayAudio">
      <view class="pill-icon {{isPlaying ? 'icon-pill-sound-on' : 'icon-pill-sound-off'}}"></view>
      <text class="pill-text">朗读</text>
    </view>
    <view class="floating-pill" bindtap="onToggleMemoryBox">
      <text class="pill-icon">R</text>
      <text class="pill-text">回放</text>
    </view>
  </view>
</view>

<view class="score-fab {{allStrokes.length > 0 ? 'visible' : ''}}" bindtap="onSubmitForScoring" hidden="{{!(showTemplate && allStrokes.length > 0 && currentTab === 0) || show3DView || showLeftSidebar || showCollectionSetup || showCollectionRecords || showCoordinateModal || showPreviewModal}}">
  <view class="score-icon icon-score"></view>
  <text class="score-text">打分</text>
</view>

<view class="mengbao-sheet-modal" wx:if="{{showMengbaoActionSheet}}">
  <view class="coordinate-overlay" bindtap="onCloseMengbaoActionSheet"></view>
  <view class="mengbao-sheet-content">
    <view class="mengbao-sheet-header">
      <view class="zm-icon zm-icon-sparkle zm-icon-gold-dark mengbao-sheet-glyph"></view>
      <text class="mengbao-sheet-title">蒙宝AI</text>
      <text class="mengbao-sheet-subtitle">选择你现在要做的事</text>
    </view>
    <view class="mengbao-sheet-actions">
      <view class="mengbao-sheet-btn secondary" data-action="chat" bindtap="onSelectMengbaoAction">对话</view>
      <view class="mengbao-sheet-btn primary" data-action="score" bindtap="onSelectMengbaoAction">打分</view>
    </view>
  </view>
</view>

<view class="memory-box-container {{show3DView ? 'active' : ''}}" wx:if="{{currentTab === 0}}">
  <image wx:if="{{currentFrameUrl}}" class="blueprint-bg" src="{{currentFrameUrl}}" mode="aspectFill"></image>
  <canvas type="2d" id="playbackCanvas" class="playback-canvas"></canvas>
  <!-- 流动光标 -->
  <view wx:if="{{replayDisplayMode === 'trajectory'}}" class="flow-cursor {{cursorVisible ? 'active' : ''}}" 
        style="left: {{cursorX}}%; top: {{cursorY}}%; transform: translate(-50%, -50%) scale({{viewAngle === 3 ? 1.4 : 1}});">
    <view class="cursor-glow"></view>
    <view class="cursor-ring"></view>
    <view class="cursor-particles"></view>
    <view class="cursor-core"></view>
    <view class="cursor-inner"></view>
  </view>
  <view class="frame-overlay"></view>
  <!-- 3D回溯控制栏 - 移到顶部 -->
  <view class="playback-controls-top">
    <view class="control-btn play-btn" bindtap="onToggleAutoPlay">
      <text>{{isAutoPlaying ? '⏸' : '▶'}}</text>
    </view>
    <view class="angle-selector">
      <view class="angle-btn {{viewAngle === 0 ? 'active' : ''}}" bindtap="onChangeViewAngle" data-angle="0">正视</view>
      <view class="angle-btn {{viewAngle === 4 ? 'active' : ''}}" bindtap="onChangeViewAngle" data-angle="4">360°</view>
    </view>
    <view class="angle-selector replay-mode-selector">
      <view class="angle-btn {{replayDisplayMode === 'trajectory' ? 'active' : ''}}" bindtap="onChangeReplayDisplayMode" data-mode="trajectory">轨迹播放</view>
      <view class="angle-btn {{replayDisplayMode === 'result' ? 'active' : ''}}" bindtap="onChangeReplayDisplayMode" data-mode="result">成字效果</view>
    </view>
  </view>
  <view class="time-slider" wx:if="{{replayDisplayMode === 'trajectory'}}">
    <view class="slider-header">
      <view class="slider-label">书写过程回放</view>
      <view class="progress-info">{{frameProgress}}%</view>
    </view>
    <slider value="{{frameProgress}}" min="0" max="100" step="1" bindchanging="onSliderChange" activeColor="#00ff00" backgroundColor="#333" block-color="#00ff00"></slider>
    <view class="progress-labels">
      <text>起笔</text>
      <text class="progress-time">{{playbackTime}}ms</text>
      <text>收笔</text>
    </view>
  </view>
  <view class="replay-result-panel {{replayDisplayMode === 'result' ? 'result-focus' : ''}}">
    <view class="replay-card" wx:if="{{replayDisplayMode === 'trajectory'}}">
      <view class="replay-card-header">
        <text class="replay-card-title">过程回放</text>
        <text class="replay-card-subtitle">{{playbackStatus}}</text>
      </view>
      <view class="replay-card-meta">
        <text>速度 {{playbackSpeed}} cm/s</text>
        <text>压力 {{playbackPressure}}</text>
      </view>
    </view>
    <view class="replay-card final-result-card {{replayDisplayMode === 'result' ? 'expanded' : ''}}">
      <view class="replay-card-header">
        <text class="replay-card-title">成字效果</text>
        <text class="replay-card-subtitle">{{collectionConfig.scriptTypeLabel}}</text>
      </view>
      <image wx:if="{{playbackPreviewImageSrc}}" class="replay-result-image {{replayDisplayMode === 'result' ? 'light-preview' : ''}}" src="{{playbackPreviewImageSrc}}" mode="aspectFit"></image>
      <image wx:else class="replay-result-image" src="{{currentLesson.bgImage}}" mode="aspectFit"></image>
      <view class="replay-card-meta replay-card-meta-stack">
        <text>{{collectionConfig.taskLabel}}</text>
        <text>{{collectionConfig.roleLabel}}</text>
      </view>
    </view>
  </view>
  <view class="close-btn" bindtap="onToggleMemoryBox">✕</view>
</view>

<!-- 左侧边栏：字帖、笔纸、落款、试炼（仅首页显示） -->
<view class="left-sidebar-mask {{showLeftSidebar && currentTab === 0 ? 'active' : ''}}" bindtap="onSwipeCloseLeftSidebar" hidden="{{!(currentTab === 0) || show3DView || showCollectionSetup || showCollectionRecords || showCoordinateModal || showPreviewModal}}"></view>
<view class="left-sidebar {{showLeftSidebar && currentTab === 0 ? 'active' : ''}}" hidden="{{!(currentTab === 0) || show3DView || showCollectionSetup || showCollectionRecords || showCoordinateModal || showPreviewModal}}">
  <view class="left-sidebar-header">
    <view class="sidebar-tabs">
      <view class="tab-item {{leftSidebarTab === 'zitie' ? 'active' : ''}}" data-tab="zitie" bindtap="onSelectLeftTab">
        <view class="tab-icon icon-tab-zitie"></view>
        <text class="tab-text">字帖</text>
      </view>
      <view class="tab-item {{leftSidebarTab === 'bizhi' ? 'active' : ''}}" data-tab="bizhi" bindtap="onSelectLeftTab">
        <view class="tab-icon icon-tab-bi"></view>
        <text class="tab-text">笔纸</text>
      </view>
      <view class="tab-item {{leftSidebarTab === 'luokuan' ? 'active' : ''}}" data-tab="luokuan" bindtap="onSelectLeftTab">
        <view class="tab-icon icon-tab-lk"></view>
        <text class="tab-text">落款</text>
      </view>
      <view class="tab-item {{leftSidebarTab === 'shilian' ? 'active' : ''}}" data-tab="shilian" bindtap="onSelectLeftTab">
        <view class="tab-icon icon-tab-sl"></view>
        <text class="tab-text">试炼</text>
      </view>
    </view>
  </view>
  
  <view class="left-sidebar-content">
    <!-- 字帖内容 -->
    <scroll-view scroll-y class="tab-panel {{leftSidebarTab === 'zitie' ? 'active' : ''}}" wx:if="{{leftSidebarTab === 'zitie'}}">
      <view class="section-title-bar">
        <text class="section-title-text">选择字帖</text>
      </view>
      <view class="lesson-grid">
        <view class="lesson-card {{currentLesson.id === item.id ? 'active' : ''}}" 
              wx:for="{{lessonList}}" 
              wx:key="id"
              data-lesson="{{item}}"
              bindtap="onSelectLesson">
          <image class="lesson-thumb" src="{{item.bgImage}}" mode="aspectFill"></image>
          <view class="lesson-info">
            <text class="lesson-title">{{item.title}}</text>
          </view>
          <view class="lesson-check" wx:if="{{currentLesson.id === item.id}}">✓</view>
        </view>
      </view>
      
      <!-- 字帖操作功能 -->
      <view class="section-title-bar" wx:if="{{showTemplate || currentLesson.id === 'collectionLab'}}">
        <text class="section-title-text">字帖操作</text>
      </view>
      <view class="action-buttons-grid" wx:if="{{showTemplate || currentLesson.id === 'collectionLab'}}">
        <view class="action-btn-item" catchtap="onSaveImage">
          <view class="action-btn-icon icon-frame"></view>
          <text class="action-btn-text">装裱</text>
        </view>
        <view class="action-btn-item" catchtap="onImportImage">
          <view class="action-btn-icon icon-import"></view>
          <text class="action-btn-text">导入图片</text>
        </view>
        <view class="action-btn-item {{collectionConfig.backgroundImage ? '' : 'disabled'}}" catchtap="onExtractTrajectories" wx:if="{{collectionConfig.backgroundImage}}">
          <view class="action-btn-icon icon-extract"></view>
          <text class="action-btn-text">提取轨迹</text>
        </view>
        <view class="action-btn-item" catchtap="onExportCoordinates">
          <view class="action-btn-icon icon-export"></view>
          <text class="action-btn-text">导出数据</text>
        </view>
        <view class="action-btn-item" catchtap="onOpenCollectionSetup">
          <view class="action-btn-icon icon-action-set"></view>
          <text class="action-btn-text">采集设置</text>
        </view>
        <view class="action-btn-item" catchtap="onOpenCollectionRecords">
          <view class="action-btn-icon icon-action-rec"></view>
          <text class="action-btn-text">采集记录</text>
        </view>
      </view>
    </scroll-view>
    
    <!-- 笔纸内容 -->
    <scroll-view scroll-y class="tab-panel {{leftSidebarTab === 'bizhi' ? 'active' : ''}}" wx:if="{{leftSidebarTab === 'bizhi'}}">
      <view class="section-title-bar">
        <text class="section-title-text">纸张</text>
      </view>
      <view class="paper-selector">
        <view class="paper-option {{activeSkin=='xuan'?'active':''}}" catchtap="onSelectSkin" data-skin="xuan">
          <view class="paper-preview xuan"></view>
          <text class="paper-name">生宣</text>
        </view>
        <view class="paper-option {{activeSkin=='cao'?'active':''}}" catchtap="onSelectSkin" data-skin="cao">
          <view class="paper-preview cao"></view>
          <text class="paper-name">草纸</text>
        </view>
        <view class="paper-option {{activeSkin=='gold'?'active':''}}" catchtap="onSelectSkin" data-skin="gold">
          <view class="paper-preview gold"></view>
          <text class="paper-name">洒金</text>
        </view>
      </view>
      
      <view class="section-title-bar" style="margin-top: 32rpx;">
        <text class="section-title-text">笔触粗细</text>
      </view>
      <view class="size-slider-panel">
        <slider 
          min="2" max="20" step="1" 
          value="{{baseWidth}}" 
          block-size="18" 
          activeColor="#667eea" 
          backgroundColor="#e0e0e0"
          bindchange="onWidthChange" 
        />
        <view class="size-preview">
          <view class="size-dot" style="width: {{baseWidth}}px; height: {{baseWidth}}px; background: {{currentColor}};"></view>
          <text class="size-value">{{baseWidth}}</text>
        </view>
      </view>
      
      <view class="section-title-bar" style="margin-top: 32rpx;">
        <text class="section-title-text">墨色</text>
      </view>
      <view class="color-swatches-grid">
        <view 
          wx:for="{{colorOptions}}" 
          wx:key="value"
          class="color-option-grid {{currentColor == item.value ? 'active' : ''}}"
          data-color="{{item.value}}"
          catchtap="onSelectColor"
        >
          <view class="color-swatch-grid" style="background: {{item.value}};"></view>
          <text class="color-name-grid">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
    
    <!-- 落款内容 -->
    <scroll-view scroll-y class="tab-panel {{leftSidebarTab === 'luokuan' ? 'active' : ''}}" wx:if="{{leftSidebarTab === 'luokuan'}}">
      <view class="section-title-bar">
        <text class="section-title-text">印章预览</text>
      </view>
      <view class="seal-preview-box">
        <view class="seal-inner" style="border-color: {{sealColor}};">
          <text class="seal-text-preview" style="color: {{sealColor}};">{{sealText || '落款'}}</text>
        </view>
      </view>
      <view class="seal-input-box">
        <input class="seal-input" placeholder="输入印章文字" value="{{sealText}}" bindinput="onSealInput" maxlength="4" />
      </view>
      <view class="section-title-bar" style="margin-top: 24rpx;">
        <text class="section-title-text">印章颜色</text>
      </view>
      <view class="seal-colors-grid">
        <view class="seal-color-item {{sealColor === '#d74a49' ? 'active' : ''}}" style="background: #d74a49;" data-color="#d74a49" catchtap="onSelectSealColor"></view>
        <view class="seal-color-item {{sealColor === '#1a1a1a' ? 'active' : ''}}" style="background: #1a1a1a;" data-color="#1a1a1a" catchtap="onSelectSealColor"></view>
        <view class="seal-color-item {{sealColor === '#4a90d9' ? 'active' : ''}}" style="background: #4a90d9;" data-color="#4a90d9" catchtap="onSelectSealColor"></view>
        <view class="seal-color-item {{sealColor === '#d9a74a' ? 'active' : ''}}" style="background: #d9a74a;" data-color="#d9a74a" catchtap="onSelectSealColor"></view>
      </view>
    </scroll-view>
    
    <!-- 试炼内容 -->
    <scroll-view scroll-y class="tab-panel {{leftSidebarTab === 'shilian' ? 'active' : ''}}" wx:if="{{leftSidebarTab === 'shilian'}}">
      <view class="challenge-entry-large" bindtap="onOpenChallenge">
        <view class="challenge-icon-large">
          <view class="zm-icon zm-icon-flag zm-icon-gold-dark challenge-icon-large-glyph"></view>
        </view>
        <view class="challenge-content">
          <text class="challenge-title-large">每日试炼</text>
          <text class="challenge-desc-large">回答书法知识问题，赢取墨玉奖励</text>
        </view>
      </view>
      <view class="challenge-stats">
        <view class="stat-box">
          <text class="stat-num">{{userProfile.level || 1}}</text>
          <text class="stat-label">等级</text>
        </view>
        <view class="stat-box">
          <text class="stat-num">{{userProfile.inkJades || 0}}</text>
          <text class="stat-label">墨玉</text>
        </view>
        <view class="stat-box">
          <text class="stat-num">{{userProfile.streak || 0}}</text>
          <text class="stat-label">连续</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 左下角快捷操作按钮（独立于canvas-zone，确保可点击） -->
<view class="quick-action-buttons" hidden="{{!((showTemplate || currentLesson.id === 'collectionLab') && currentTab === 0) || identityState === 'UNAUTH' || !hasGuided || show3DView || showLeftSidebar || showCollectionSetup || showCollectionRecords || showCoordinateModal || showPreviewModal}}" catch:tap="onQuickActionTap">
  <view class="quick-btn" catchtap="onUndo">
    <view class="quick-btn-icon icon-qb-undo"></view>
  </view>
  <view class="quick-btn" catchtap="onClearCanvas">
    <view class="quick-btn-icon icon-qb-clear"></view>
  </view>
</view>

<view class="canvas-zone {{isTechMode ? 'tech-mode' : ''}} skin-{{activeSkin}}" bindtap="onCanvasTap" wx:if="{{currentTab === 0}}">
  <view class="scan-line" wx:if="{{isTechMode}}"></view>
  
  <image
    class="template-layer {{showTemplate ? 'visible' : ''}}"
    src="{{currentLesson.bgImage}}"
    mode="widthFix"
    style="width: 80%; transform: translate(-50%, -50%) scale({{templateSettings.scale}}); opacity: {{templateSettings.opacity}};"
    binderror="onTemplateImageError"
    wx:if="{{showTemplate}}"
  ></image>

  <image
    class="collection-bg-image {{collectionConfig.backgroundImage ? 'visible' : ''}}"
    src="{{collectionConfig.backgroundImage}}"
    mode="widthFix"
    style="width: 80%; transform: translate(-50%, -50%) scale({{collectionBgSettings.scale}}); opacity: {{collectionBgSettings.opacity}};"
