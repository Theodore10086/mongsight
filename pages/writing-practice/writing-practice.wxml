      <view class="data-stats">
        <text class="stat-label">笔画数: {{coordinateStats.strokeCount}}</text>
        <text class="stat-label">点数: {{coordinateStats.pointCount}}</text>
        <text class="stat-label">脚本: {{coordinateData.task.scriptTypeLabel}}</text>
        <text class="stat-label">角色: {{coordinateData.participant.roleLabel}}</text>
      </view>
      <view class="collection-submit-result" wx:if="{{collectionSubmitResult}}">
        <text class="stat-label">样本ID: {{collectionSubmitResult.sampleId}}</text>
        <text class="stat-label">会话ID: {{collectionSubmitResult.sessionId}}</text>
      </view>
    </view>
    
    <view class="coordinate-actions">
      <view class="action-btn copy-btn" bindtap="onCopyCoordinates">
        <view class="zm-icon zm-icon-copy zm-icon-secondary-text btn-glyph"></view>
        <text class="btn-text">复制数据</text>
      </view>
      <view class="action-btn download-btn" bindtap="onDownloadCoordinates">
        <view class="zm-icon zm-icon-save zm-icon-gold-dark btn-glyph"></view>
        <text class="btn-text">保存文件</text>
      </view>
      <view class="action-btn submit-btn" bindtap="onSubmitCollectionSampleFromExport">
        <view class="btn-icon icon-action-upload"></view>
        <text class="btn-text">提交采集</text>
      </view>
    </view>
  </view>
</view>

<view class="challenge-modal" wx:if="{{showChallengeModal}}">
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">S1 赛季 · 每日试炼</text>
      <view class="modal-close" bindtap="onCloseChallenge">✕</view>
    </view>
    <view class="challenge-progress">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{(currentChallengeIndex + 1) / 5 * 100}}%"></view>
      </view>
      <text class="progress-text">当前第 {{currentChallengeIndex + 1}}/5 题</text>
    </view>
    <view class="modal-body">
      <text class="challenge-question">{{challengeData.question}}</text>
      <view class="options-container">
        <view 
          wx:for="{{challengeData.options}}" 
          wx:key="index"
          class="option-item"
          data-index="{{index}}"
          bindtap="onSelectOption"
        >
          {{item}}
        </view>
      </view>
    </view>
  </view>
</view>

<view class="result-panel" wx:if="{{showChallengeResult}}">
  <view class="result-content">
    <view class="result-header">
      <text class="result-title">试炼完成！</text>
    </view>
    <view class="result-body">
      <view class="result-stats">
        <view class="stat-item">
          <text class="stat-value">{{challengeCorrectCount}}/5</text>
          <text class="stat-label">答对题数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{challengeCorrectCount * 20}}%</text>
          <text class="stat-label">正确率</text>
        </view>
      </view>
      <view class="result-reward-highlight">
        <view class="reward-icon icon-reward-gem"></view>
        <text class="reward-text">获得 {{challengeCorrectCount * 5}} 墨玉</text>
      </view>
      <view class="radar-container">
        <canvas 
          type="2d" 
          id="radarCanvas" 
          class="radar-canvas"
          style="width: 280px; height: 280px;"
        ></canvas>
      </view>
    </view>
    <view class="result-footer">
      <button class="claim-button" bindtap="onClaimReward">领取奖励</button>
    </view>
  </view>
</view>

<!-- 截图闪光效果 -->
<view class="screenshot-flash {{startFlash ? 'active' : ''}}"></view>

<!-- Tab 内容区域 -->
<view class="tab-content" wx:if="{{currentTab !== 0}}">
  <!-- 班级 Tab -->
  <view class="tab-panel {{currentTab === 1 ? 'active' : ''}}">
    <view class="class-header">
      <text class="class-title">班级</text>
    </view>
    <view class="class-entry">
      <text class="class-entry-title">班级教学</text>
      <text class="class-entry-desc">教师管理班级与作业，学生完成作业与提交。请先选择角色登录。</text>
      <button class="class-entry-btn" bindtap="onGoToClassLogin">进入班级登录</button>
    </view>
  </view>
  
  <!-- 社区 Tab -->
  <view class="tab-panel {{currentTab === 2 ? 'active' : ''}}">
    <view class="community-header">
      <view class="fluid-blob fluid-blob-1"></view>
      <view class="fluid-blob fluid-blob-2"></view>
      <view class="fluid-blob fluid-blob-3"></view>
      <text class="community-title">书法社区</text>
      <view class="post-btn" bindtap="onOpenPostModal">
        <text>发帖</text>
      </view>
    </view>
    <scroll-view 
      scroll-y 
      class="community-feed"
      refresher-enabled="{{true}}"
      refresher-triggered="{{refresherTriggered}}"
      bindrefresherrefresh="onPullDownRefresh"
      bindscrolltolower="onLoadMorePosts"
    >
      <view class="feed-loading" wx:if="{{isLoadingPosts}}">
        <text>加载中...</text>
      </view>
      <view class="feed-item" wx:for="{{communityPosts}}" wx:key="id" style="animation: fadeInUp {{index * 0.05}}s ease-out;">
        <view class="feed-user">
          <image class="community-avatar" wx:if="{{item.avatarIsImage}}" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <text class="feed-avatar community-avatar-text" wx:else>{{item.avatarText || item.avatar}}</text>
          <view class="feed-user-info">
            <text class="feed-nickname">{{item.nickname}}</text>
            <text class="feed-time" wx:if="{{item.create_time_str}}">{{item.create_time_str}}</text>
          </view>
        </view>
        <view class="feed-content">{{item.content}}</view>
        <view class="feed-images" wx:if="{{item.images && item.images.length}}">
          <image class="feed-img" wx:for="{{item.images}}" wx:key="*this" src="{{item}}" mode="aspectFill"></image>
        </view>
        <view class="feed-actions">
          <view class="action-item {{item.liked ? 'liked' : ''}}" data-id="{{item.id}}" bindtap="onLikePost">
            <view class="action-icon {{item.liked ? 'icon-like-filled' : 'icon-like-outline'}}"></view>
            <text class="action-count">{{item.likes}}</text>
            <view class="like-effect" wx:if="{{item.liked && item.showLikeEffect}}"></view>
          </view>
          <view class="action-item" data-id="{{item.id}}" bindtap="onOpenComment">
            <view class="action-icon icon-comment-outline"></view>
            <text class="action-count">{{item.comments}}</text>
          </view>
          <view class="action-item {{item.isFavorited ? 'favorited' : ''}}" data-id="{{item.id}}" bindtap="onToggleFavorite">
            <view class="action-icon {{item.isFavorited ? 'icon-favorite-filled' : 'icon-like-outline'}}"></view>
            <text class="action-count">{{item.isFavorited ? '已收藏' : '收藏'}}</text>
          </view>
        </view>
        <view class="comment-list" wx:if="{{item.commentsList && item.commentsList.length}}">
          <view class="comment-item inline-comment" wx:for="{{item.commentsList}}" wx:key="id">
            <text class="comment-nickname">{{item.nickname}}</text>
            <text class="comment-reply-arrow" wx:if="{{item.replyTo}}"> 回复 </text>
            <text class="comment-reply-nickname" wx:if="{{item.replyTo}}">{{item.replyTo.nickname}}</text>
            <text class="comment-colon" wx:if="{{item.replyTo}}">：</text>
            <text class="comment-text" wx:else>：</text>
            <text class="comment-text">{{item.content}}</text>
            <text class="comment-reply-btn" data-nickname="{{item.nickname}}" data-commentid="{{item.id}}" bindtap="onReplyComment">回复</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
  
  <!-- 评论弹窗 -->
  <view class="comment-modal {{showCommentModal ? 'active' : ''}}" wx:if="{{showCommentModal}}">
    <view class="comment-modal-mask" bindtap="onCloseCommentModal"></view>
    <view class="comment-modal-content">
      <view class="comment-modal-header">
        <text class="comment-modal-title">评论</text>
        <text class="comment-modal-close" bindtap="onCloseCommentModal">✕</text>
      </view>
      <scroll-view scroll-y class="comment-list-view">
        <view class="comment-item modal-comment" wx:for="{{currentComments}}" wx:key="id">
          <image class="comment-avatar-image" wx:if="{{item.avatarIsImage}}" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <text class="comment-avatar" wx:else>{{item.avatarText || item.avatar}}</text>
          <view class="comment-body">
            <text class="comment-nickname">{{item.nickname}}</text>
            <view class="comment-reply-info" wx:if="{{item.replyTo}}">
              <text class="comment-reply-arrow">回复 </text>
              <text class="comment-reply-nickname">{{item.replyTo.nickname}}</text>
            </view>
            <text class="comment-text">{{item.content}}</text>
            <text class="comment-reply-btn" data-nickname="{{item.nickname}}" data-commentid="{{item.id}}" bindtap="onReplyComment">回复</text>
          </view>
        </view>
        <view class="no-comment" wx:if="{{!currentComments.length}}">暂无评论，快来抢沙发~</view>
      </scroll-view>
      <view class="comment-input-area">
        <view class="reply-indicator" wx:if="{{replyTargetNickname}}">
          <text class="reply-target">回复 {{replyTargetNickname}}</text>
          <text class="cancel-reply" bindtap="onCancelReply">取消</text>
        </view>
        <input class="comment-input"
               placeholder="{{replyTargetNickname ? ('回复 ' + replyTargetNickname) : '说点什么...'}}"
               value="{{commentText}}"
               bindinput="onCommentInput"
               focus="{{replyTargetNickname}}"
               confirm-type="send"
               bindconfirm="onSendComment" />
        <button class="comment-send-btn" bindtap="onSendComment">发送</button>
      </view>
    </view>
  </view>
  
  <!-- 发帖弹窗 -->
  <view class="post-modal {{showPostModal ? 'active' : ''}}" wx:if="{{showPostModal}}">
    <view class="post-modal-mask" bindtap="onClosePostModal"></view>
    <view class="post-modal-content">
      <view class="post-modal-header">
        <text class="post-modal-title">发布新帖</text>
        <text class="post-modal-close" bindtap="onClosePostModal">✕</text>
      </view>
      <view class="post-form">
        <textarea class="post-content-input" 
                  placeholder="分享你的书法心得..." 
                  value="{{postContent}}"
                  bindinput="onPostContentInput"
                  maxlength="500" />
        <view class="post-images">
          <view class="post-image-item" wx:for="{{postImages}}" wx:key="*this">
            <image class="post-image" src="{{item}}" mode="aspectFill"></image>
            <view class="post-image-remove" data-index="{{index}}" bindtap="onRemovePostImage">✕</view>
          </view>
          <view class="post-image-add" bindtap="onAddPostImage" wx:if="{{postImages.length < 9}}">
            <text class="add-icon">+</text>
            <text class="add-text">添加图片</text>
          </view>
        </view>
        <view class="post-tips">最多可添加9张图片</view>
      </view>
      <button class="post-submit-btn" bindtap="onSubmitPost">发布</button>
    </view>
  </view>
  
  <!-- 我的 Tab -->
  <view class="tab-panel {{currentTab === 3 ? 'active' : ''}}">
    <!-- 个人头部 -->
    <view class="profile-header">
      <view class="fluid-blob fluid-blob-p1"></view>
      <view class="fluid-blob fluid-blob-p2"></view>
      <view class="fluid-blob fluid-blob-p3"></view>
      <view class="fluid-blob fluid-blob-p4"></view>
      <view class="profile-avatar-edit" bindtap="onEditAvatar">
        <image class="profile-avatar" wx:if="{{userProfile.avatarUrl && !avatarOptions.includes(userProfile.avatarUrl)}}" src="{{userProfile.avatarUrl}}" mode="aspectFill"></image>
        <view class="profile-avatar" wx:else>{{userProfile.avatarUrl || '👤'}}</view>
        <view class="avatar-edit-icon icon-p-camera"></view>
      </view>
      <view class="profile-nickname-edit" bindtap="onEditNickname">
        <text class="profile-nickname">{{userProfile.nickName || '墨客'}}</text>
        <view class="edit-icon icon-p-edit"></view>
      </view>
      <view class="profile-level-row">
        <text class="profile-level">Lv.{{userProfile.level || 1}} {{userProfile.title || '牧羊人'}}</text>
        <view class="vip-badge" wx:if="{{userProfile.level >= 10}}">VIP</view>
      </view>
    </view>
    
    <!-- 签到卡片 -->
    <view class="checkin-card" bindtap="onDailyCheckin">
      <view class="checkin-left">
        <view class="checkin-icon icon-p-calendar"></view>
        <text class="checkin-title">每日签到</text>
        <text class="checkin-days">连续{{userProfile.streak || 0}}天</text>
      </view>
