      <view class="stat-item" bindtap="onGoToMyWorks">
        <text class="stat-num">{{myWorks.length || 0}}</text>
        <text class="stat-label">作品</text>
      </view>
      <view class="stat-item" bindtap="onGoToMyPosts">
        <text class="stat-num">{{myPostCount || 0}}</text>
        <text class="stat-label">帖子</text>
      </view>
      <view class="stat-item" bindtap="onGoToMyLikes">
        <text class="stat-num">{{myLikes.length || 0}}</text>
        <text class="stat-label">点赞</text>
      </view>
      <view class="stat-item" bindtap="onGoToFollows">
        <text class="stat-num">{{userProfile.following || 0}}</text>
        <text class="stat-label">关注</text>
      </view>
      <view class="stat-item" bindtap="onGoToFollowers">
        <text class="stat-num">{{userProfile.followers || 0}}</text>
        <text class="stat-label">粉丝</text>
      </view>
    </view>
    
    <!-- 权益卡片 -->
    <view class="privilege-section">
      <view class="privilege-title">我的权益</view>
      <view class="privilege-grid">
        <view class="privilege-item">
          <view class="privilege-icon icon-p-gem"></view>
          <text class="privilege-text">班级权益</text>
        </view>
        <view class="privilege-item">
          <view class="privilege-icon icon-p-badge"></view>
          <text class="privilege-text">成就徽章</text>
        </view>
        <view class="privilege-item">
          <view class="privilege-icon icon-p-calendar"></view>
          <text class="privilege-text">书法日历</text>
        </view>
        <view class="privilege-item">
          <view class="privilege-icon icon-p-gift"></view>
          <text class="privilege-text">邀请好友</text>
        </view>
      </view>
    </view>
    
    <!-- 功能菜单 -->
    <view class="profile-menu">
      <view class="menu-item" bindtap="onGoToOrders">
        <view class="menu-icon icon-p-orders"></view>
        <text class="menu-text">我的订单</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onGoToMyWorks">
        <view class="menu-icon icon-p-works"></view>
        <text class="menu-text">我的作品</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onGoToMyPosts">
        <view class="menu-icon icon-p-posts"></view>
        <text class="menu-text">我的帖子</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onGoToMyLikes">
        <view class="menu-icon icon-p-likes"></view>
        <text class="menu-text">我的点赞</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onGoToMyCollection">
        <view class="menu-icon icon-p-collection"></view>
        <text class="menu-text">我的收藏</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onGoToAchievements">
        <view class="menu-icon icon-p-achievements"></view>
        <text class="menu-text">成就中心</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onGoToSettings">
        <view class="menu-icon icon-p-settings"></view>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
